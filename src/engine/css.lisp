(defun color-bytes (r g b &optional (a 1d0))
  (list (/ r 255d0) (/ g 255d0) (/ b 255d0) (float a 1d0)))

(defun parse-hex-color (text)
  (let* ((h text)
         (n (length h)))
    (flet ((d (c) (digit-char-p c 16)))
      (cond
        ((and (= n 3) (every #'d h))
         (color-bytes (* 17 (d (char h 0))) (* 17 (d (char h 1))) (* 17 (d (char h 2)))))
        ((and (= n 4) (every #'d h))
         (color-bytes (* 17 (d (char h 0))) (* 17 (d (char h 1))) (* 17 (d (char h 2)))
                      (/ (* 17 (d (char h 3))) 255d0)))
        ((and (= n 6) (every #'d h))
         (color-bytes (+ (* 16 (d (char h 0))) (d (char h 1)))
                      (+ (* 16 (d (char h 2))) (d (char h 3)))
                      (+ (* 16 (d (char h 4))) (d (char h 5)))))
        ((and (= n 8) (every #'d h))
         (color-bytes (+ (* 16 (d (char h 0))) (d (char h 1)))
                      (+ (* 16 (d (char h 2))) (d (char h 3)))
                      (+ (* 16 (d (char h 4))) (d (char h 5)))
                      (/ (+ (* 16 (d (char h 6))) (d (char h 7))) 255d0)))))))

;;; Tokeniser

(defun css-tokenize (string)
  (let ((i 0) (n (length string)) (out nil))
    (labels ((peek () (if (< i n) (char string i) nil))
             (ident-start (c)
               (and c (or (alpha-char-p c) (char= c #\_) (char= c #\-))))
             (ident-char (c)
               (and c (or (alphanumericp c) (char= c #\_) (char= c #\-) (char= c #\%))))
             (read-ident ()
               (let ((start i))
                 (loop while (ident-char (peek)) do (incf i))
                 (string-downcase (subseq string start i))))
             (read-string (quote)
               (incf i)
               (let ((start i))
                 (loop while (and (< i n) (not (char= (char string i) quote)))
                       do (if (char= (char string i) #\\) (incf i 2) (incf i)))
                 (prog1 (subseq string start i)
                   (when (< i n) (incf i)))))
             (read-number ()
               (let ((start i))
                 (when (member (peek) '(#\+ #\-)) (incf i))
                 (loop while (and (peek) (digit-char-p (peek))) do (incf i))
                 (when (and (eql (peek) #\.) (< (1+ i) n) (digit-char-p (char string (1+ i))))
                   (incf i)
                   (loop while (and (peek) (digit-char-p (peek))) do (incf i)))
                 (let ((num (ignore-errors (float (read-from-string (subseq string start i)) 1d0))))
                   (cond
                     ((eql (peek) #\%)
                      (incf i)
                      (make-tok :kind :percentage :number num))
                     ((and (peek) (alpha-char-p (peek)))
                      (let ((u (read-ident)))
                        (make-tok :kind :dimension :number num :unit u)))
                     (t (make-tok :kind :number :number num)))))))
      (loop while (< i n) do
        (let ((c (peek)))
          (cond
            ((whitespace-char-p c) (incf i))
            ((char= c #\,) (incf i) (push (make-tok :kind :comma) out))
            ((char= c #\/) (incf i) (push (make-tok :kind :slash) out))
            ((or (char= c #\") (char= c #\'))
             (push (make-tok :kind :string :text (read-string c)) out))
            ((char= c #\#)
             (incf i)
             (let ((start i))
               (loop while (and (peek) (digit-char-p (peek) 16)) do (incf i))
               (push (make-tok :kind :hash :text (subseq string start i)) out)))
            ((or (digit-char-p c)
                 (and (member c '(#\+ #\- #\.))
                      (< (1+ i) n)
                      (or (digit-char-p (char string (1+ i)))
                          (and (char= c #\.) (digit-char-p (char string (1+ i)))))))
             (push (read-number) out))
            ((ident-start c)
             (if (and (char= c #\-)
                      (or (>= (1+ i) n)
                          (not (or (alphanumericp (char string (1+ i)))
                                   (char= (char string (1+ i)) #\-)
                                   (char= (char string (1+ i)) #\_)))))
                 (progn (incf i) (push (make-tok :kind :delim :text "-") out))
                 (let ((id (read-ident)))
                   (cond ((eql (peek) #\()
                          (incf i)
                          (push (make-tok :kind :function :text id) out))
                         (t (push (make-tok :kind :ident :text id) out))))))
            ((char= c #\() (incf i) (push (make-tok :kind :lparen) out))
            ((char= c #\)) (incf i) (push (make-tok :kind :rparen) out))
            (t (incf i) (push (make-tok :kind :delim :text (string c)) out))))))
    (nreverse out)))

(defun take-until-rparen (tokens)
  "TOKENS start after a function name. Return (values inside rest)."
  (let ((depth 1) (inside nil) (rest tokens))
    (loop while (and rest (plusp depth)) do
      (let ((k (tok-kind (car rest))))
        (cond ((eq k :function) (incf depth) (push (car rest) inside) (pop rest)
               (when (and rest (eq (tok-kind (car rest)) :lparen))
                 (push (car rest) inside) (pop rest)))
              ((eq k :lparen) (incf depth) (push (car rest) inside) (pop rest))
              ((eq k :rparen)
               (decf depth)
               (if (plusp depth)
                   (progn (push (car rest) inside) (pop rest))
                   (pop rest)))
              (t (push (car rest) inside) (pop rest)))))
    (values (nreverse inside) rest)))

(defun parse-length-tok (tok)
  (when tok
    (case (tok-kind tok)
      (:number (when (and (tok-number tok) (zerop (tok-number tok))) 0d0))
      (:percentage (cons :% (or (tok-number tok) 0d0)))
      (:dimension
       (cons (intern (string-upcase (or (tok-unit tok) "PX")) :keyword)
             (or (tok-number tok) 0d0)))
      (:ident
       (let ((id (tok-text tok)))
         (cond ((string= id "auto") :auto)
               ((string= id "none") :none)
               ((string= id "min-content") :min-content)
               ((string= id "max-content") :max-content)
               ((string= id "fit-content") :fit-content)))))))

(defun parse-color-tokens (tokens)
  "Return (values color rest) or (values nil tokens) if the head is not a color."
  (when tokens
    (let ((tok (car tokens)))
      (case (tok-kind tok)
        (:hash (values (parse-hex-color (tok-text tok)) (cdr tokens)))
        (:ident
         (let ((id (tok-text tok)))
           (cond ((string= id "currentcolor") (values :currentcolor (cdr tokens)))
                 ((string= id "transparent") (values nil (cdr tokens)))
                 ((gethash id *named-colors*)
                  (let ((rgb (gethash id *named-colors*)))
                    (if (null (car rgb))
                        (values nil (cdr tokens))
                        (values (apply #'color-bytes rgb) (cdr tokens)))))
                 (t (values nil tokens)))))
        (:function
         (cond
           ((member (tok-text tok) '("rgb" "rgba") :test #'string=)
            (multiple-value-bind (inside rest) (take-until-rparen (cdr tokens))
              (let ((nums (remove-if-not (lambda (tk)
                                           (member (tok-kind tk) '(:number :percentage)))
                                         inside)))
                (when (>= (length nums) 3)
                  (flet ((chan (tk)
                           (if (eq (tok-kind tk) :percentage)
                               (/ (tok-number tk) 100d0)
                               (if (<= (tok-number tk) 1d0)
                                   (tok-number tk)
                                   (/ (tok-number tk) 255d0)))))
                    (values (list (chan (first nums)) (chan (second nums)) (chan (third nums))
                                  (if (fourth nums) (chan (fourth nums)) 1d0))
                            rest))))))
           (t (values nil tokens))))
        (t (values nil tokens))))))

(defun parse-calc (tokens)
  "TOKENS are inside calc(...). Return a calc expression."
  (labels ((peek () (car tokens))
           (pop1 () (pop tokens))
           (calc-term ()
             (let ((tk (peek)))
               (cond
                 ((and tk (eq (tok-kind tk) :lparen))
                  (pop1)
                  (prog1 (sum) (when (and (peek) (eq (tok-kind (peek)) :rparen)) (pop1))))
                 ((and tk (eq (tok-kind tk) :function) (string= (tok-text tk) "calc"))
                  (pop1)
                  (multiple-value-bind (inside rest) (take-until-rparen tokens)
                    (setf tokens rest)
                    (let ((saved tokens))
                      (setf tokens inside)
                      (prog1 (sum) (setf tokens saved)))))
                 (tk
                  (pop1)
                  (or (parse-length-tok tk)
                      (and (eq (tok-kind tk) :number) (tok-number tk))))
                 (t nil))))
           (product ()
             (let ((left (calc-term)))
               (loop while (and left (peek)
                                (eq (tok-kind (peek)) :delim)
                                (member (tok-text (peek)) '("*" "/") :test #'string=))
                     do (let ((op (tok-text (pop1))))
                          (setf left (list (if (string= op "*") :* :/) left (calc-term)))))
               left))
           (sum ()
             (let ((left (product)))
               (loop while (and left (peek)
                                (eq (tok-kind (peek)) :delim)
                                (member (tok-text (peek)) '("+" "-") :test #'string=))
                     do (let ((op (tok-text (pop1))))
                          (setf left (list (if (string= op "+") :+ :-) left (product)))))
               left)))
    (cons :calc (sum))))

(defun ident-keyword (tok)
  (when (and tok (eq (tok-kind tok) :ident))
    (intern (string-upcase (tok-text tok)) :keyword)))

(defun parse-edges (tokens parser)
  (let ((vals nil) (rest tokens))
    (loop for i below 4 while rest do
      (multiple-value-bind (v r) (funcall parser rest)
        (unless v (return nil))
        (push v vals)
        (setf rest r)))
    (when vals
      (let ((v (nreverse vals)))
        (case (length v)
          (1 (list (first v) (first v) (first v) (first v)))
          (2 (list (first v) (second v) (first v) (second v)))
          (3 (list (first v) (second v) (third v) (second v)))
          (4 v))))))

(defun parse-one-length (tokens &key allow-auto)
  (when tokens
    (let* ((tk (car tokens))
           (v (parse-length-tok tk)))
      (cond
        ((and (eq (tok-kind tk) :function) (string= (tok-text tk) "calc"))
         (multiple-value-bind (inside rest) (take-until-rparen (cdr tokens))
           (let ((c (parse-calc inside)))
             (when (cdr c) (values c rest)))))
        ((and v (or allow-auto (not (eq v :auto))))
         (values v (cdr tokens)))
        ((and (eq (tok-kind tk) :number) (tok-number tk))
         (values (float (tok-number tk) 1d0) (cdr tokens)))))))

(defun parse-margin-token (tokens)
  (if (and tokens (eq (tok-kind (car tokens)) :ident) (string= (tok-text (car tokens)) "auto"))
      (values :auto (cdr tokens))
      (parse-one-length tokens)))

(defun kw-list (tokens allowed)
  (let ((id (and tokens (eq (tok-kind (car tokens)) :ident) (tok-text (car tokens)))))
    (when (member id allowed :test #'string=)
      (values (intern (string-upcase id) :keyword) (cdr tokens)))))

(defun parse-track-list (tokens)
  (let ((tracks nil))
    (loop while tokens do
      (let ((tk (car tokens)))
        (cond
          ((and (eq (tok-kind tk) :function) (string= (tok-text tk) "repeat"))
           (multiple-value-bind (inside rest) (take-until-rparen (cdr tokens))
             (setf tokens rest)
             (let ((count-tok (car inside))
                   (rest-in (if (and (cdr inside) (eq (tok-kind (cadr inside)) :comma))
                                (cddr inside)
                                (cdr inside)))
                   (count nil))
               (cond
                 ((and count-tok (eq (tok-kind count-tok) :number))
                  (setf count (round (tok-number count-tok))))
                 ((and count-tok (eq (tok-kind count-tok) :ident)
                       (member (tok-text count-tok) '("auto-fit" "auto-fill") :test #'string=))
                  (setf count (intern (string-upcase (tok-text count-tok)) :keyword))))
               (let ((inner (parse-track-list rest-in)))
                 (when (and count inner)
                   (push (list :repeat count inner) tracks))))))
          ((and (eq (tok-kind tk) :function) (string= (tok-text tk) "minmax"))
           (multiple-value-bind (inside rest) (take-until-rparen (cdr tokens))
             (setf tokens rest)
             (let ((parts (remove :comma inside :key #'tok-kind)))
               (when (>= (length parts) 2)
                 (push (list :minmax (parse-length-tok (first parts))
                             (or (parse-length-tok (second parts))
                                 (and (eq (tok-kind (second parts)) :ident)
                                      (string= (tok-text (second parts)) "fr")
                                      ;; "1fr" is a dimension, already handled
                                      nil)))
                       tracks)))))
          ((eq (tok-kind tk) :ident)
           (pop tokens)
           (cond ((string= (tok-text tk) "auto") (push :auto tracks))
                 ((string= (tok-text tk) "min-content") (push :min-content tracks))
                 ((string= (tok-text tk) "max-content") (push :max-content tracks))
                 (t (return-from parse-track-list nil))))
          (t
           (let ((len (parse-length-tok tk)))
             (cond (len (pop tokens) (push len tracks))
                   (t (return-from parse-track-list nil))))))))
    (nreverse tracks)))

(defun parse-grid-span (tokens)
  "Parse '1 / 3', 'span 2', '2 / span 2'."
  (let ((start nil) (span nil) (toks tokens))
    (labels ((ident () (and toks (eq (tok-kind (car toks)) :ident) (tok-text (car toks))))
             (num () (and toks (eq (tok-kind (car toks)) :number) (round (tok-number (car toks))))))
      (cond
        ((string= (or (ident) "") "span")
         (pop toks)
         (setf span (or (num) 1))
         (when toks (pop toks)))
        ((num)
         (setf start (num))
         (pop toks)
         (when (and toks (eq (tok-kind (car toks)) :slash))
           (pop toks)
           (cond
             ((string= (or (ident) "") "span")
              (pop toks)
              (setf span (or (num) 1))
              (when toks (pop toks)))
             ((num)
              (let ((end (num)))
                (pop toks)
                (setf span (max 1 (- end start))))))))
        ((string= (or (ident) "") "auto")
         (pop toks)))
      (cons start span))))

(defun parse-font-family (tokens)
  (let ((families nil) (current nil))
    (dolist (tk tokens)
      (cond
        ((eq (tok-kind tk) :comma)
         (when current
           (push (format nil "~{~A~^ ~}" (nreverse current)) families)
           (setf current nil)))
        ((eq (tok-kind tk) :string) (push (tok-text tk) current))
        ((eq (tok-kind tk) :ident) (push (tok-text tk) current))))
    (when current
      (push (format nil "~{~A~^ ~}" (nreverse current)) families))
    (nreverse families)))

(defun parse-transform (tokens)
  (let ((ops nil))
    (loop while tokens do
      (let ((tk (car tokens)))
        (unless (and tk (eq (tok-kind tk) :function)) (return))
        (multiple-value-bind (inside rest) (take-until-rparen (cdr tokens))
          (setf tokens rest)
          (let ((name (tok-text tk))
                (lens (mapcar #'parse-length-tok
                              (remove-if (lambda (x) (member (tok-kind x) '(:comma))) inside))))
            (cond
              ((string= name "translate")
               (push (list :translate (or (first lens) 0d0) (or (second lens) 0d0)) ops))
              ((string= name "translatex")
               (push (list :translate (or (first lens) 0d0) 0d0) ops))
              ((string= name "translatey")
               (push (list :translate 0d0 (or (first lens) 0d0)) ops))
              ((string= name "scale")
               (let ((n (and (first inside) (eq (tok-kind (first inside)) :number)
                             (tok-number (first inside)))))
                 (push (list :scale (or n 1d0)
                             (or (and (second inside) (eq (tok-kind (second inside)) :number)
                                      (tok-number (second inside)))
                                 n 1d0))
                       ops)))
              ((string= name "rotate")
               (let* ((tk2 (first inside))
                      (deg (cond ((and tk2 (eq (tok-kind tk2) :dimension)
                                       (string= (tok-unit tk2) "deg"))
                                  (tok-number tk2))
                                 ((and tk2 (eq (tok-kind tk2) :number)) (tok-number tk2))
                                 (t 0d0))))
                 (push (list :rotate (* deg (/ pi 180d0))) ops))))))))
    (nreverse ops)))

(defun expand-border-side (tokens)
  "Return (width style color) or nil."
  (let ((width nil) (style nil) (color nil) (rest tokens) (ok t))
    (loop while (and rest ok) do
      (let ((tk (car rest)))
        (cond
          ((and (null width) (or (member (tok-kind tk) '(:dimension :number :percentage))
                                 (and (eq (tok-kind tk) :ident)
                                      (member (tok-text tk) '("thin" "medium" "thick") :test #'string=))))
           (setf width (cond ((and (eq (tok-kind tk) :ident) (string= (tok-text tk) "thin")) 1d0)
                             ((and (eq (tok-kind tk) :ident) (string= (tok-text tk) "medium")) 3d0)
                             ((and (eq (tok-kind tk) :ident) (string= (tok-text tk) "thick")) 5d0)
                             (t (parse-length-tok tk))))
           (pop rest))
          ((and (null style) (eq (tok-kind tk) :ident)
                (member (tok-text tk)
                        '("none" "hidden" "dotted" "dashed" "solid" "double" "groove" "ridge" "inset" "outset")
                        :test #'string=))
           (setf style (intern (string-upcase (tok-text tk)) :keyword))
           (pop rest))
          (t
           (multiple-value-bind (c r) (parse-color-tokens rest)
             (if (or c (and rest (eq (tok-kind (car rest)) :ident)
                            (string= (tok-text (car rest)) "transparent")))
                 (progn (setf color c) (setf rest r))
                 (setf ok nil)))))))
    (when (or width style color)
      (list (or width 3d0) (or style :solid) color))))

(defun parse-one-box-shadow (tokens)
  "Parse one shadow. Returns (values shadow remaining-tokens)."
  (let ((x nil) (y nil) (lengths 0) (color nil) (inset nil) (rest tokens))
    (loop while rest do
      (let ((tk (car rest)))
        (cond
          ((eq (tok-kind tk) :comma) (return))
          ((and (eq (tok-kind tk) :ident) (string= (tok-text tk) "inset"))
           (setf inset t)
           (pop rest))
          ((and (< lengths 3)
                (member (tok-kind tk) '(:dimension :number :percentage)))
           (let ((n (parse-length-tok tk)))
             (case lengths
               (0 (setf x n))
               (1 (setf y n)))
             (incf lengths)
             (pop rest)))
          (t
           (multiple-value-bind (c r) (parse-color-tokens rest)
             (if c
                 (progn (setf color c) (setf rest r))
                 (return)))))))
    (values (when (and x y)
              (list x y (or color :currentcolor) inset))
            rest)))

(defun parse-box-shadow (tokens)
  "Solid shadows separated by commas. The first one is painted on top."
  (let ((out nil) (rest tokens))
    (loop while rest do
      (multiple-value-bind (sh more) (parse-one-box-shadow rest)
        (cond
          (sh
           (push sh out)
           (setf rest more)
           (when (and rest (eq (tok-kind (car rest)) :comma))
             (pop rest)))
          (t (return)))))
    (nreverse out)))

(defun expand-declaration (property raw)
  "Return a list of (LONGHAND . VALUE)."
  (let* ((tokens (css-tokenize (or raw "")))
         (global (and tokens (null (cdr tokens)) (eq (tok-kind (car tokens)) :ident)
                      (member (tok-text (car tokens)) '("inherit" "initial" "unset") :test #'string=)
                      (intern (string-upcase (tok-text (car tokens))) :keyword))))
    (when (stringp property)
      (return-from expand-declaration (list (cons property raw))))
    (flet ((g (prop) (cons prop (cons :global global)))
           (edges (props parser)
             (let ((e (parse-edges tokens parser)))
               (when e (mapcar #'cons props e)))))
      (if global
          (list (g property))
          (case property
            ((:margin)
             (edges '(:margin-top :margin-right :margin-bottom :margin-left) #'parse-margin-token))
            ((:padding)
             (edges '(:padding-top :padding-right :padding-bottom :padding-left) #'parse-one-length))
            ((:border-width)
             (edges '(:border-top-width :border-right-width :border-bottom-width :border-left-width)
                    #'parse-one-length))
            ((:inset)
             (edges '(:top :right :bottom :left) #'parse-margin-token))
            ((:gap)
             (let ((e (parse-edges tokens #'parse-one-length)))
               (when e
                 (list (cons :row-gap (first e)) (cons :column-gap (second e))))))
            ((:outline)
             (let ((side (expand-border-side tokens)))
               (when side
                 (destructuring-bind (w st col) side
                   (list (cons :outline-width w)
                         (cons :outline-style st)
                         (cons :outline-color (or col :currentcolor)))))))
            ((:border :border-top :border-right :border-bottom :border-left)
             (let ((side (expand-border-side tokens)))
               (when side
                 (destructuring-bind (w st col) side
                   (let ((sides (if (eq property :border)
                                    '(:top :right :bottom :left)
                                    (list (intern (string-upcase (subseq (symbol-name property) 7)) :keyword)))))
                     (loop for s in sides
                           append (list
                                   (cons (intern (format nil "BORDER-~A-WIDTH" s) :keyword) w)
                                   (cons (intern (format nil "BORDER-~A-STYLE" s) :keyword) st)
                                   (cons (intern (format nil "BORDER-~A-COLOR" s) :keyword) (or col :currentcolor)))))))))
            ((:flex)
             (expand-flex tokens))
            ((:font)
             (expand-font tokens))
            ((:background)
             (expand-background tokens))
            ((:animation)
             (expand-animation tokens))
            ((:text-decoration)
             (let ((line nil)
                   (style nil))
               (dolist (tk tokens)
                 (when (eq (tok-kind tk) :ident)
                   (cond ((member (tok-text tk) '("none" "underline" "overline" "line-through")
                                  :test #'string=)
                          (push (intern (string-upcase (tok-text tk)) :keyword) line))
                         ((member (tok-text tk) '("solid" "double" "dotted" "dashed" "wavy")
                                  :test #'string=)
                          (setf style (intern (string-upcase (tok-text tk)) :keyword))))))
               (let* ((line (nreverse line))
                      (kind (cond ((or (null line) (member :none line)) :none)
                                  ((null (cdr line)) (car line))
                                  (t line))))
                 (list (cons :text-decoration kind)
                       (cons :text-decoration-style (or style :solid))))))
            ((:border-radius)
             (multiple-value-bind (v r) (parse-one-length tokens)
               (declare (ignore r))
               (when v (list (cons :border-radius v)))))
            (t
             (let ((v (parse-longhand property tokens)))
               (when v (list (cons property v))))))))))

(defun expand-flex (tokens)
  (let ((ids (mapcar #'tok-text (remove-if-not (lambda (tk) (eq (tok-kind tk) :ident)) tokens))))
    (cond
      ((member "none" ids :test #'string=)
       (list (cons :flex-grow 0d0) (cons :flex-shrink 0d0) (cons :flex-basis :auto)))
      ((member "auto" ids :test #'string=)
       (list (cons :flex-grow 1d0) (cons :flex-shrink 1d0) (cons :flex-basis :auto)))
      ((member "initial" ids :test #'string=)
       (list (cons :flex-grow 0d0) (cons :flex-shrink 1d0) (cons :flex-basis :auto)))
      (t
       (let ((grow nil) (shrink nil) (basis nil) (rest tokens))
         (when (and rest (eq (tok-kind (car rest)) :number))
           (setf grow (tok-number (pop rest))))
         (when (and rest (eq (tok-kind (car rest)) :number))
           (setf shrink (tok-number (pop rest))))
         (when rest
           (multiple-value-bind (v r) (parse-margin-token rest)
             (when v (setf basis v rest r))))
         (cond
           ((and grow (null shrink) (null basis))
            (list (cons :flex-grow grow) (cons :flex-shrink 1d0) (cons :flex-basis 0d0)))
           ((and (null grow) basis)
            (list (cons :flex-grow 1d0) (cons :flex-shrink 1d0) (cons :flex-basis basis)))
           ((and grow shrink (null basis))
            (list (cons :flex-grow grow) (cons :flex-shrink shrink) (cons :flex-basis 0d0)))
           ((and grow basis (null shrink))
            (list (cons :flex-grow grow) (cons :flex-shrink 1d0) (cons :flex-basis basis)))
           ((and grow shrink basis)
            (list (cons :flex-grow grow) (cons :flex-shrink shrink) (cons :flex-basis basis)))))))))

(defun expand-font (tokens)
  (let ((style nil) (weight nil) (size nil) (lh nil) (i 0) (n (length tokens)))
    (loop while (< i n) do
      (let ((tk (nth i tokens)))
        (cond
          ((and (null size) (eq (tok-kind tk) :ident)
                (member (tok-text tk) '("italic" "oblique" "normal") :test #'string=)
                (null style))
           (setf style (intern (string-upcase (tok-text tk)) :keyword))
           (incf i))
          ((and (null size) (eq (tok-kind tk) :ident)
                (member (tok-text tk) '("bold" "bolder" "lighter" "normal") :test #'string=)
                (null weight))
           (setf weight (if (string= (tok-text tk) "normal") :normal
                            (intern (string-upcase (tok-text tk)) :keyword)))
           (incf i))
          ((and (null size) (eq (tok-kind tk) :number) (>= (or (tok-number tk) 0) 100))
           (setf weight (tok-number tk))
           (incf i))
          ((and (null size)
                (member (tok-kind tk) '(:dimension :percentage :number)))
           (setf size (parse-length-tok tk))
           (incf i)
           (when (and (< i n) (eq (tok-kind (nth i tokens)) :slash))
             (incf i)
             (let ((ltk (nth i tokens)))
               (setf lh (if (eq (tok-kind ltk) :number)
                            (cons :mult (tok-number ltk))
                            (parse-length-tok ltk)))
               (incf i)))
           (return))
          ((and (eq (tok-kind tk) :ident) (string= (tok-text tk) "normal"))
           (incf i))
          (t (return)))))
    (let ((family (parse-font-family (subseq tokens i)))
          (out nil))
      (when style (push (cons :font-style style) out))
      (when weight (push (cons :font-weight weight) out))
      (when size (push (cons :font-size size) out))
      (when lh (push (cons :line-height lh) out))
      (when family (push (cons :font-family family) out))
      out)))

(defun url-from-tokens (tokens)
  "URL string from url(\"...\") or a bare string."
  (cond
    ((and tokens (eq (tok-kind (car tokens)) :function)
          (string-equal (tok-text (car tokens)) "url"))
     (multiple-value-bind (inside more) (take-until-rparen (cdr tokens))
       (declare (ignore more))
       (let ((s (find-if (lambda (tk) (member (tok-kind tk) '(:string :ident))) inside)))
         (when s (tok-text s)))))
    ((and tokens (eq (tok-kind (car tokens)) :string))
     (tok-text (car tokens)))))

(defun gradient-stops (tokens)
  "A linear-gradient as (DIRECTION . COLORS). The default direction runs top to bottom."
  (let ((dir :bottom)
        (colors nil)
        (rest tokens))
    (cond
      ((and rest (eq (tok-kind (car rest)) :dimension)
            (string-equal (or (tok-unit (car rest)) "") "deg"))
       (setf dir (float (tok-number (car rest)) 1d0))
       (pop rest))
      ((and rest (eq (tok-kind (car rest)) :ident) (string= (tok-text (car rest)) "to"))
       (pop rest)
       (when (and rest (eq (tok-kind (car rest)) :ident))
         (setf dir (cond ((string= (tok-text (car rest)) "right") :right)
                         ((string= (tok-text (car rest)) "left") :left)
                         ((string= (tok-text (car rest)) "top") :top)
                         (t :bottom)))
         (pop rest))))
    (loop while rest do
      (let ((tk (car rest)))
        (cond
          ((eq (tok-kind tk) :comma) (pop rest))
          ((member (tok-kind tk) '(:dimension :number))
           (pop rest))
          (t
           (multiple-value-bind (c more) (parse-color-tokens rest)
             (cond ((consp c)
                    (let ((offset nil))
                      (when (and more (eq (tok-kind (car more)) :percentage))
                        (setf offset (/ (float (tok-number (car more)) 1d0) 100d0))
                        (pop more))
                      (push (append c (list offset)) colors)
                      (setf rest more)))
                   ((not (eq more rest)) (setf rest more))
                   (t (pop rest))))))))
    (cons dir (nreverse colors))))

(defun radial-at-value (value)
  "One radial-gradient center component. A bare number or px length is pixels."
  (cond ((null value) :center)
        ((keywordp value) value)
        ((numberp value) (float value 1d0))
        ((and (consp value) (eq (car value) :px)) (float (cdr value) 1d0))
        ((and (consp value) (eq (car value) :%)) value)
        (t :center)))

(defun read-radial-position (tokens)
  "One position after at: a keyword, a length, or a percentage."
  (if (and tokens (eq (tok-kind (car tokens)) :ident)
           (member (tok-text (car tokens)) '("left" "right" "center" "top" "bottom") :test #'string=))
      (values (intern (string-upcase (tok-text (car tokens))) :keyword) (cdr tokens))
      (parse-one-length tokens)))

(defun radial-gradient-spec (tokens)
  "A radial-gradient. The default is centered and ends at the farthest corner."
  (let ((extent :farthest-corner)
        (at-x :center)
        (at-y :center)
        (rest tokens))
    (loop while rest do
      (let ((tk (car rest)))
        (cond
          ((and (eq (tok-kind tk) :ident) (string= (tok-text tk) "at"))
           (pop rest)
           (multiple-value-bind (x more) (read-radial-position rest)
             (when x
               (setf at-x (radial-at-value x))
               (setf rest more)
               (multiple-value-bind (y more2) (read-radial-position rest)
                 (when y
                   (setf at-y (radial-at-value y))
                   (setf rest more2))))))
          ((and (eq (tok-kind tk) :ident)
                (member (tok-text tk)
                        '("circle" "ellipse" "closest-side" "farthest-side"
                          "closest-corner" "farthest-corner" "center")
                        :test #'string=))
           (when (member (tok-text tk)
                         '("closest-side" "farthest-side" "closest-corner" "farthest-corner")
                         :test #'string=)
             (setf extent (intern (string-upcase (tok-text tk)) :keyword)))
           (pop rest))
          (t (return)))))
    (when (and rest (eq (tok-kind (car rest)) :comma))
      (pop rest))
    (list* :radial extent at-x at-y (cdr (gradient-stops rest)))))

(defun expand-background (tokens)
  (let ((color nil) (image nil) (gradient nil) (rest tokens))
    (loop while rest do
      (let ((tk (car rest)))
        (cond
          ((and (eq (tok-kind tk) :function)
                (member (tok-text tk) '("url" "linear-gradient" "repeating-linear-gradient" "radial-gradient") :test #'string=))
           (multiple-value-bind (inside more) (take-until-rparen (cdr rest))
             (cond ((string= (tok-text tk) "url")
                    (let ((s (find-if (lambda (x) (member (tok-kind x) '(:string :ident))) inside)))
                      (when s (setf image (tok-text s)))))
                   ((string= (tok-text tk) "linear-gradient")
                    (setf gradient (gradient-stops inside)))
                   ((string= (tok-text tk) "repeating-linear-gradient")
                    (setf gradient (cons :repeat (gradient-stops inside))))
                   ((string= (tok-text tk) "radial-gradient")
                    (setf gradient (radial-gradient-spec inside))))
             (setf rest more)))
          (t
           (multiple-value-bind (c more) (parse-color-tokens rest)
             (if (or c (and rest (eq (tok-kind (car rest)) :ident)
                            (or (gethash (tok-text (car rest)) *named-colors*)
                                (string= (tok-text (car rest)) "transparent")
                                (string= (tok-text (car rest)) "currentcolor"))))
                 (progn
                   (setf color (or c (if (string= (tok-text (car rest)) "currentcolor") :currentcolor nil)))
                   (setf rest (or more (cdr rest))))
                 (pop rest)))))))
    (append (when image (list (cons :background-image image)))
            (when gradient (list (cons :background-gradient gradient)))
            (list (cons :background-color color)))))

(defun expand-animation (tokens)
  (let ((name nil) (duration nil) (iteration 1))
    (dolist (tk tokens)
      (cond
        ((and (null name) (eq (tok-kind tk) :ident)
              (not (member (tok-text tk)
                           '("linear" "ease" "ease-in" "ease-out" "ease-in-out" "infinite" "normal" "alternate" "forwards" "backwards" "both" "none" "paused" "running")
                           :test #'string=)))
         (setf name (tok-text tk)))
        ((and (eq (tok-kind tk) :ident) (string= (tok-text tk) "infinite"))
         (setf iteration :infinite))
        ((and (eq (tok-kind tk) :ident) (string= (tok-text tk) "none"))
         (setf name :none))
        ((and (eq (tok-kind tk) :dimension) (tok-number tk))
         (setf duration (if (string= (tok-unit tk) "ms")
                            (/ (tok-number tk) 1000d0)
                            (tok-number tk))))
        ((and (null iteration) (eq (tok-kind tk) :number))
         (setf iteration (round (tok-number tk))))))
    (append (when name (list (cons :animation-name name)))
            (when duration (list (cons :animation-duration (float duration 1d0))))
            (list (cons :animation-iteration-count iteration)))))

(defun parse-longhand (property tokens)
  (labels ((kw (allowed)
             (multiple-value-bind (k r) (kw-list tokens allowed)
               (declare (ignore r))
               k))
           (len (&key allow-auto)
             (multiple-value-bind (v r) (parse-one-length tokens :allow-auto allow-auto)
               (declare (ignore r))
               v)))
    (case property
      ((:display)
       (kw '("inline" "block" "inline-block" "list-item" "none" "contents" "flex" "inline-flex"
             "grid" "inline-grid" "flow-root" "table" "inline-table" "table-row" "table-cell"
             "table-row-group" "table-header-group" "table-footer-group" "table-column"
             "table-column-group" "table-caption")))
      ((:position) (kw '("static" "relative" "absolute" "fixed" "sticky")))
      ((:float) (kw '("none" "left" "right")))
      ((:clear) (kw '("none" "left" "right" "both")))
      ((:width :height :min-width :min-height :max-width :max-height)
       (or (len :allow-auto t)
           (kw '("auto" "none" "min-content" "max-content" "fit-content"))))
      ((:aspect-ratio)
       (when (and tokens (eq (tok-kind (car tokens)) :number))
         (let ((w (float (tok-number (car tokens)) 1d0))
               (rest (cdr tokens)))
           (cond
             ((and rest (eq (tok-kind (car rest)) :slash)
                   (cdr rest) (eq (tok-kind (cadr rest)) :number)
                   (> (tok-number (cadr rest)) 0))
              (/ w (float (tok-number (cadr rest)) 1d0)))
             ((> w 0) w)))))
      ((:margin-top :margin-right :margin-bottom :margin-left :top :right :bottom :left)
       (parse-margin-token tokens))
      ((:padding-top :padding-right :padding-bottom :padding-left
        :border-top-width :border-right-width :border-bottom-width :border-left-width
        :row-gap :column-gap :flex-basis)
       (multiple-value-bind (v r) (parse-margin-token tokens)
         (declare (ignore r))
         v))
      ((:border-top-style :border-right-style :border-bottom-style :border-left-style)
       (kw '("none" "hidden" "dotted" "dashed" "solid" "double" "groove" "ridge" "inset" "outset")))
      ((:border-top-color :border-right-color :border-bottom-color :border-left-color :color :background-color :text-decoration-color)
       (multiple-value-bind (c r) (parse-color-tokens tokens)
         (declare (ignore r))
         (or c (when (and tokens (eq (tok-kind (car tokens)) :ident)
                         (string= (tok-text (car tokens)) "currentcolor"))
                 :currentcolor))))
      ((:box-sizing) (kw '("content-box" "border-box")))
      ((:font-size) (or (len) (kw '("xx-small" "x-small" "small" "medium" "large" "x-large" "xx-large" "smaller" "larger"))))
      ((:font-weight)
       (or (kw '("normal" "bold" "bolder" "lighter"))
           (and tokens (eq (tok-kind (car tokens)) :number) (tok-number (car tokens)))))
      ((:font-style) (kw '("normal" "italic" "oblique")))
      ((:font-family) (let ((f (parse-font-family tokens))) (when f f)))
      ((:line-height)
       (cond ((and tokens (eq (tok-kind (car tokens)) :ident) (string= (tok-text (car tokens)) "normal"))
              :normal)
             ((and tokens (eq (tok-kind (car tokens)) :number))
              (cons :mult (tok-number (car tokens))))
             (t (len))))
      ((:text-align) (kw '("start" "end" "left" "right" "center" "justify")))
      ((:text-transform) (kw '("none" "uppercase" "lowercase" "capitalize")))
      ((:text-indent) (len))
      ((:text-underline-offset)
       (if (and tokens (eq (tok-kind (car tokens)) :ident) (string= (tok-text (car tokens)) "auto"))
           :auto
           (len)))
      ((:text-decoration-style)
       (kw '("solid" "double" "dotted" "dashed" "wavy")))
      ((:text-decoration-thickness)
       (if (and tokens (eq (tok-kind (car tokens)) :ident)
                (member (tok-text (car tokens)) '("auto" "from-font") :test #'string=))
           :auto
           (len)))
      ((:letter-spacing :word-spacing)
       (if (and tokens (eq (tok-kind (car tokens)) :ident) (string= (tok-text (car tokens)) "normal"))
           0d0
           (len)))
      ((:text-decoration)
       (let ((found (loop for tk in tokens
                          when (and (eq (tok-kind tk) :ident)
                                    (member (tok-text tk)
                                            '("none" "underline" "overline" "line-through")
                                            :test #'string=))
                            collect (intern (string-upcase (tok-text tk)) :keyword))))
         (cond ((or (null found) (member :none found)) :none)
               ((null (cdr found)) (car found))
               (t found))))
      ((:white-space) (kw '("normal" "nowrap" "pre" "pre-wrap" "pre-line" "break-spaces")))
      ((:text-overflow) (kw '("clip" "ellipsis")))
      ((:overflow-wrap :word-wrap) (kw '("normal" "break-word" "anywhere")))
      ((:word-break) (kw '("normal" "break-all" "keep-all" "break-word")))
      ((:border-collapse) (kw '("separate" "collapse")))
      ((:caption-side) (kw '("top" "bottom")))
      ((:empty-cells) (kw '("show" "hide")))
      ((:border-spacing)
       (multiple-value-bind (a rest) (parse-one-length tokens)
         (when a
           (multiple-value-bind (b more) (parse-one-length rest)
             (declare (ignore more))
             (list a (or b a))))))
      ((:vertical-align)
       (or (len)
           (kw '("baseline" "top" "middle" "bottom" "sub" "super" "text-top" "text-bottom"))))
      ((:flex-direction) (kw '("row" "row-reverse" "column" "column-reverse")))
      ((:flex-wrap) (kw '("nowrap" "wrap" "wrap-reverse")))
      ((:justify-content)
       (kw '("flex-start" "flex-end" "center" "space-between" "space-around" "space-evenly" "start" "end" "left" "right")))
      ((:align-items :align-self :align-content)
       (kw '("auto" "stretch" "flex-start" "flex-end" "center" "baseline" "start" "end" "space-between" "space-around" "space-evenly")))
      ((:flex-grow :flex-shrink :opacity)
       (and tokens (member (tok-kind (car tokens)) '(:number :percentage))
            (float (tok-number (car tokens)) 1d0)))
      ((:order :z-index :column-count)
       (cond ((and tokens (eq (tok-kind (car tokens)) :ident) (string= (tok-text (car tokens)) "auto"))
              :auto)
             ((and tokens (eq (tok-kind (car tokens)) :number))
              (round (tok-number (car tokens))))))
      ((:grid-template-columns) (let ((tr (parse-track-list tokens))) (when tr (cons :cols tr))))
      ((:grid-template-rows) (let ((tr (parse-track-list tokens))) (when tr (cons :rows tr))))
      ((:grid-auto-flow) (kw '("row" "column" "row dense" "column dense")))
      ((:grid-column) (cons :gcol (parse-grid-span tokens)))
      ((:grid-row) (cons :grow (parse-grid-span tokens)))
      ((:overflow) (kw '("visible" "hidden" "clip" "scroll" "auto")))
      ((:visibility) (kw '("visible" "hidden" "collapse")))
      ((:border-radius :outline-offset) (len))
      ((:box-shadow) (parse-box-shadow tokens))
      ((:text-shadow) (parse-box-shadow tokens))
      ((:transform) (let ((ops (parse-transform tokens))) (when ops ops)))
      ((:content)
       (cond ((and tokens (eq (tok-kind (car tokens)) :ident)
                   (member (tok-text (car tokens)) '("none" "normal" "open-quote" "close-quote") :test #'string=))
              (intern (string-upcase (tok-text (car tokens))) :keyword))
             (t (let ((strs (mapcar #'tok-text (remove-if-not (lambda (tk) (eq (tok-kind tk) :string)) tokens))))
                  (when strs (apply #'concatenate 'string strs))))))
      ((:quotes)
       (cond ((and tokens (eq (tok-kind (car tokens)) :ident)
                   (member (tok-text (car tokens)) '("none" "auto") :test #'string=))
              (intern (string-upcase (tok-text (car tokens))) :keyword))
             (t (let ((strs (mapcar #'tok-text (remove-if-not (lambda (tk) (eq (tok-kind tk) :string)) tokens))))
                  (when strs strs)))))
      ((:background-image)
       (cond ((and tokens (eq (tok-kind (car tokens)) :ident) (string= (tok-text (car tokens)) "none"))
              :none)
             ((and tokens (eq (tok-kind (car tokens)) :function)
                   (member (tok-text (car tokens)) '("linear-gradient" "repeating-linear-gradient" "radial-gradient") :test #'string=))
              (multiple-value-bind (inside more) (take-until-rparen (cdr tokens))
                (declare (ignore more))
                (cond ((string= (tok-text (car tokens)) "radial-gradient")
                       (cons :radial-gradient (radial-gradient-spec inside)))
                      ((string= (tok-text (car tokens)) "repeating-linear-gradient")
                       (cons :repeating-linear-gradient (gradient-stops inside)))
                      (t (cons :linear-gradient (gradient-stops inside))))))
             (t (url-from-tokens tokens))))
      ((:background-repeat) (kw '("repeat" "no-repeat" "repeat-x" "repeat-y" "space" "round")))
      ((:background-position :object-position)
       (let ((found nil)
             (rest tokens))
         (loop while (and rest (< (length found) 2)) do
           (let ((tk (car rest)))
             (cond
               ((and (eq (tok-kind tk) :ident)
                     (member (tok-text tk)
                             '("left" "right" "center" "top" "bottom")
                             :test #'string=))
                (push (intern (string-upcase (tok-text tk)) :keyword) found)
                (pop rest))
               (t
                (multiple-value-bind (len more) (parse-one-length rest)
                  (cond (len (push len found) (setf rest more))
                        (t (pop rest))))))))
         (setf found (nreverse found))
         (if (cdr found) found (car found))))
      ((:background-size)
       (or (kw '("auto" "contain" "cover"))
           (multiple-value-bind (a rest) (parse-one-length tokens)
             (when a
               (multiple-value-bind (b rest2) (parse-one-length rest)
                 (declare (ignore rest2))
                 (list a (or b :auto)))))))
      ((:background-clip) (kw '("border-box" "padding-box" "content-box")))
      ((:background-origin) (kw '("border-box" "padding-box" "content-box")))
      ((:object-fit) (kw '("fill" "contain" "cover" "none" "scale-down")))
      ((:list-style :list-style-type)
       (kw '("disc" "circle" "square" "decimal" "none"
             "lower-alpha" "upper-alpha" "lower-roman" "upper-roman"
             "disclosure-closed" "disclosure-open")))
      ((:list-style-position) (kw '("outside" "inside")))
      ((:list-style-image)
       (cond ((and tokens (eq (tok-kind (car tokens)) :ident)
                   (string= (tok-text (car tokens)) "none"))
              :none)
             (t (url-from-tokens tokens))))
      ((:animation-name)
       (when (and tokens (eq (tok-kind (car tokens)) :ident))
         (if (string= (tok-text (car tokens)) "none") :none (tok-text (car tokens)))))
      ((:animation-duration)
       (when (and tokens (eq (tok-kind (car tokens)) :dimension))
         (if (string= (tok-unit (car tokens)) "ms")
             (/ (tok-number (car tokens)) 1000d0)
             (float (tok-number (car tokens)) 1d0))))
      ((:animation-iteration-count)
       (cond ((and tokens (eq (tok-kind (car tokens)) :ident) (string= (tok-text (car tokens)) "infinite"))
              :infinite)
             ((and tokens (eq (tok-kind (car tokens)) :number))
              (round (tok-number (car tokens))))))
      (t
       ;; Keep the raw token text joined so unknown longhands are not dropped.
       (cons :raw (format nil "~{~A~^ ~}"
                          (mapcar (lambda (tk) (or (tok-text tk) (princ-to-string (tok-number tk))))
                                  tokens)))))))

;;; Selectors

(defun split-top-level (string ch)
  (let ((parts nil) (start 0) (depth 0) (i 0) (n (length string)) (quote nil))
    (loop while (< i n) do
      (let ((c (char string i)))
        (cond
          (quote (when (char= c quote) (setf quote nil)) (incf i))
          ((or (char= c #\") (char= c #\')) (setf quote c) (incf i))
          ((member c '(#\( #\[ #\{)) (incf depth) (incf i))
          ((member c '(#\) #\] #\})) (decf depth) (incf i))
          ((and (zerop depth) (char= c ch))
           (push (subseq string start i) parts)
           (incf i)
           (setf start i))
          (t (incf i)))))
    (push (subseq string start) parts)
    (nreverse parts)))

(defun trim-ws (s)
  (string-trim '(#\space #\tab #\newline #\return #\page) (or s "")))

(defun parse-selector-list (string)
  (let ((parts (split-top-level (trim-ws string) #\,)))
    (remove nil (mapcar (lambda (p) (parse-complex (trim-ws p))) parts))))

(defun parse-complex (string)
  (let ((i 0) (n (length string)) (compounds nil) (combs nil))
    (labels ((peek () (if (< i n) (char string i) nil))
             (skip () (loop while (and (peek) (whitespace-char-p (peek))) do (incf i)))
             (parse-compound ()
               (skip)
               (let ((comp (make-sel)))
                 (when (eql (peek) #\*)
                   (setf (sel-type comp) :*)
                   (incf i))
                 (when (and (peek) (alpha-char-p (peek)))
                   (let ((start i))
                     (loop while (and (peek) (or (alphanumericp (peek)) (char= (peek) #\-)))
                           do (incf i))
                     (setf (sel-type comp) (string-downcase (subseq string start i)))))
                 (loop
                   (skip)
                   (cond
                     ((eql (peek) #\#)
                      (incf i)
                      (let ((start i))
                        (loop while (and (peek) (or (alphanumericp (peek)) (member (peek) '(#\- #\_))))
                              do (incf i))
                        (setf (sel-id comp) (subseq string start i))))
                     ((eql (peek) #\.)
                      (incf i)
                      (let ((start i))
                        (loop while (and (peek) (or (alphanumericp (peek)) (member (peek) '(#\- #\_))))
                              do (incf i))
                        (push (subseq string start i) (sel-classes comp))))
                     ((eql (peek) #\[)
                      (let ((attr (read-attr)))
                        (if attr (push attr (sel-attrs comp)) (return-from parse-compound nil))))
                     ((eql (peek) #\:)
                      (unless (read-pseudo comp) (return-from parse-compound nil)))
                     (t (return))))
                 (setf (sel-classes comp) (nreverse (sel-classes comp)))
                 (setf (sel-attrs comp) (nreverse (sel-attrs comp)))
                 (setf (sel-pseudos comp) (nreverse (sel-pseudos comp)))
                 comp))
             (read-attr ()
               (incf i)
               (let ((start i))
                 (loop while (and (peek) (not (member (peek) '(#\= #\~ #\^ #\$ #\* #\] #\space #\tab) :test #'eql))
                                  (not (eql (peek) (code-char 124))))
                       do (incf i))
                 (let ((name (string-downcase (trim-ws (subseq string start i)))))
                   (skip)
                   (cond
                     ((eql (peek) #\])
                      (incf i)
                      (list name :present nil))
                     (t
                      (let ((op :present))
                        (cond
                          ((and (eql (peek) #\~) (< (1+ i) n) (char= (char string (1+ i)) #\=))
                           (setf op :~=) (incf i 2))
                          ((and (eql (peek) (code-char 124)) (< (1+ i) n) (char= (char string (1+ i)) #\=))
                           (setf op :lang-prefix) (incf i 2))
                          ((and (eql (peek) #\^) (< (1+ i) n) (char= (char string (1+ i)) #\=))
                           (setf op :^=) (incf i 2))
                          ((and (eql (peek) #\$) (< (1+ i) n) (char= (char string (1+ i)) #\=))
                           (setf op :$=) (incf i 2))
                          ((and (eql (peek) #\*) (< (1+ i) n) (char= (char string (1+ i)) #\=))
                           (setf op :*=) (incf i 2))
                          ((eql (peek) #\=) (setf op :=) (incf i))
                          (t (return-from read-attr nil)))
                        (skip)
                        (let ((val (cond
                                     ((or (eql (peek) #\") (eql (peek) #\'))
                                      (let ((q (peek)))
                                        (incf i)
                                        (let ((s i))
                                          (loop while (and (peek) (not (eql (peek) q))) do (incf i))
                                          (prog1 (subseq string s i) (when (peek) (incf i))))))
                                     (t
                                      (let ((s i))
                                        (loop while (and (peek) (not (member (peek) '(#\] #\space #\tab))))
                                              do (incf i))
                                        (subseq string s i))))))
                          (skip)
                          (unless (eql (peek) #\]) (return-from read-attr nil))
                          (incf i)
                          (list name op val))))))))
             (read-pseudo (comp)
               (incf i)
               (let ((element nil))
                 (when (eql (peek) #\:) (setf element t) (incf i))
                 (let ((start i))
                   (loop while (and (peek) (or (alphanumericp (peek)) (char= (peek) #\-))) do (incf i))
                   (let ((name (string-downcase (subseq string start i)))
                         (arg nil))
                     (when (eql (peek) #\()
                       (incf i)
                       (let ((s i) (depth 1))
                         (loop while (and (< i n) (plusp depth)) do
                           (cond ((char= (char string i) #\() (incf depth))
                                 ((char= (char string i) #\)) (decf depth)))
                           (when (plusp depth) (incf i)))
                         (setf arg (trim-ws (subseq string s i)))
                         (when (and (< i n) (char= (char string i) #\))) (incf i))))
                     (when (or element (member name '("before" "after" "first-line" "first-letter") :test #'string=))
                       (setf (sel-pseudo-element comp) name)
                       (when arg (push (cons name arg) (sel-pseudos comp))))
                     (unless (and (sel-pseudo-element comp) (equal (sel-pseudo-element comp) name) (null arg))
                       (push (cons name (if (member name '("not" "is" "where") :test #'string=)
                                            (parse-selector-list (or arg ""))
                                            arg))
                             (sel-pseudos comp))))
                   t))))
      (loop
        (skip)
        (when (or (null (peek)) (>= i n)) (return))
        (let ((before i))
          (let ((comp (parse-compound)))
            (unless comp (return-from parse-complex nil))
            (push comp compounds)
            (let ((after-ws nil))
              (when (and (peek) (whitespace-char-p (peek)))
                (setf after-ws t)
                (skip))
              (cond
                ((null (peek)) (return))
                ((eql (peek) #\>) (incf i) (push :child combs))
                ((eql (peek) #\+) (incf i) (push :next combs))
                ((eql (peek) #\~) (incf i) (push :subsequent combs))
                ((eql (peek) #\,) (return))
                (after-ws (push :descendant combs))
                (t
                 (when (= before i) (return))
                 (return)))))))
      (when compounds
        (make-sel-complex :compounds (nreverse compounds)
                          :combinators (nreverse combs))))))

(defun selector-specificity (complex)
  (let ((ids 0) (classes 0) (types 0))
    (labels ((add-list (list)
               (let ((best (list 0 0 0)))
                 (dolist (c list best)
                   (let ((s (selector-specificity c)))
                     (when (spec> s best) (setf best s))))))
             (spec> (a b)
               (loop for x in a for y in b
                     do (cond ((> x y) (return t))
                              ((< x y) (return nil)))
                     finally (return nil))))
      (dolist (comp (sel-complex-compounds complex))
        (when (sel-id comp) (incf ids))
        (incf classes (length (sel-classes comp)))
        (incf classes (length (sel-attrs comp)))
        (when (and (sel-type comp) (not (eq (sel-type comp) :*)))
          (incf types))
        (when (sel-pseudo-element comp) (incf types))
        (dolist (ps (sel-pseudos comp))
          (cond
            ((equal (car ps) "where"))
            ((member (car ps) '("not" "is") :test #'equal)
             (let ((s (add-list (cdr ps))))
               (incf ids (first s))
               (incf classes (second s))
               (incf types (third s))))
            ((member (car ps) '("before" "after" "first-line" "first-letter") :test #'equal))
            (t (incf classes)))))
      (list ids classes types))))

(defun attr-match (attr el)
  (destructuring-bind (name op value) attr
    (let ((have (dom-attr el name)))
      (cond
        ((eq op :present) (not (null have)))
        ((null have) nil)
        ((eq op :=) (string= have value))
        ((eq op :~=) (member value (split-ws have) :test #'string=))
        ((eq op :lang-prefix) (or (string= have value)
                         (and (>= (length have) (1+ (length value)))
                              (string= (subseq have 0 (length value)) value)
                              (char= (char have (length value)) #\-))))
        ((eq op :^=) (and (>= (length have) (length value))
                          (string= (subseq have 0 (length value)) value)))
        ((eq op :$=) (and (>= (length have) (length value))
                          (string= (subseq have (- (length have) (length value))) value)))
        ((eq op :*=) (search value have))
        (t nil)))))

(defun parse-an+b (raw)
  (let ((s (string-downcase (remove-if #'whitespace-char-p (or raw "")))))
    (cond
      ((equal s "odd") (values 2 1))
      ((equal s "even") (values 2 0))
      ((and (plusp (length s))
            (every (lambda (c) (or (digit-char-p c) (char= c #\+) (char= c #\-))) s)
            (find-if #'digit-char-p s))
       (values 0 (parse-integer s)))
      (t
       (let ((n-pos (position #\n s)))
         (unless n-pos (return-from parse-an+b (values 0 0)))
         (let* ((a-str (subseq s 0 n-pos))
                (b-str (subseq s (1+ n-pos)))
                (a (cond ((or (equal a-str "") (equal a-str "+")) 1)
                         ((equal a-str "-") -1)
                         (t (parse-integer a-str :junk-allowed t))))
                (b (if (zerop (length b-str)) 0 (parse-integer b-str :junk-allowed t))))
           (values (or a 0) (or b 0))))))))

(defun an+b-p (a b index)
  (when index
    (if (zerop a)
        (= index b)
        (let ((n (/ (- index b) a)))
          (and (integerp n) (>= n 0))))))

(defun pseudo-class-match (ps el)
  (let ((name (car ps))
        (arg (cdr ps)))
    (cond
      ((equal name "root")
       (dom-document-p (dom-node-parent el)))
      ((equal name "empty")
       (not (or (element-children el)
                (some (lambda (c) (and (dom-text-p c) (not (whitespace-only-p (dom-text-text c)))))
                      (dom-node-children el)))))
      ((equal name "first-child") (= 1 (or (sibling-index el) 0)))
      ((equal name "last-child")
       (let ((idx (sibling-index el))
             (n (length (element-children (dom-node-parent el)))))
         (and idx (= idx n))))
      ((equal name "only-child")
       (= 1 (length (element-children (dom-node-parent el)))))
      ((equal name "first-of-type") (= 1 (or (sibling-index el :of-type t) 0)))
      ((equal name "last-of-type")
       (let ((idx (sibling-index el :of-type t :from-end t)))
         (and idx (= idx 1))))
      ((equal name "only-of-type")
       (= 1 (count (dom-element-tag el) (element-children (dom-node-parent el))
                   :key #'dom-element-tag :test #'string-equal)))
      ((member name '("nth-child" "nth-last-child" "nth-of-type" "nth-last-of-type") :test #'equal)
       (multiple-value-bind (a b) (parse-an+b arg)
         (an+b-p a b
                 (cond
                   ((equal name "nth-child") (sibling-index el))
                   ((equal name "nth-last-child") (sibling-index el :from-end t))
                   ((equal name "nth-of-type") (sibling-index el :of-type t))
                   (t (sibling-index el :of-type t :from-end t))))))
      ((equal name "not")
       (not (some (lambda (c) (complex-match c el nil)) arg)))
      ((member name '("is" "where") :test #'equal)
       (some (lambda (c) (complex-match c el nil)) arg))
      ((member name '("link" "any-link") :test #'equal)
       (and (string= (dom-element-tag el) "a") (dom-attr el "href")))
      ((member name '("hover" "focus" "active" "visited" "target") :test #'equal)
       (and *match-states* (member name (gethash el *match-states*) :test #'equal)))
      ((equal name "disabled") (dom-attr el "disabled"))
      ((equal name "enabled")
       (and (member (dom-element-tag el) '("input" "button" "select" "textarea" "option") :test #'string=)
            (not (dom-attr el "disabled"))))
      ((equal name "checked") (or (dom-attr el "checked") (dom-attr el "selected")))
      ((equal name "lang")
       (let ((want (string-downcase (or arg ""))))
         (loop for n = el then (dom-node-parent n)
               while (dom-element-p n)
               thereis (let ((lang (dom-attr n "lang")))
                         (and lang (or (string-equal lang want)
                                       (and (>= (length lang) (1+ (length want)))
                                            (string-equal (subseq lang 0 (length want)) want)
                                            (char= (char lang (length want)) #\-))))))))
      ((member name '("before" "after" "first-line" "first-letter") :test #'equal) t)
      (t t))))

(defun compound-match (comp el pseudo)
  (and (dom-element-p el)
       (equal (sel-pseudo-element comp) pseudo)
       (or (null (sel-type comp)) (eq (sel-type comp) :*)
           (string-equal (sel-type comp) (dom-element-tag el)))
       (or (null (sel-id comp)) (and (dom-element-id el) (string= (sel-id comp) (dom-element-id el))))
       (every (lambda (c) (member c (dom-element-classes el) :test #'string=))
              (sel-classes comp))
       (every (lambda (a) (attr-match a el)) (sel-attrs comp))
       (every (lambda (ps) (pseudo-class-match ps el)) (sel-pseudos comp))))

(defun complex-match (complex el pseudo)
  (let* ((compounds (sel-complex-compounds complex))
         (combs (sel-complex-combinators complex))
         (right (car (last compounds))))
    (unless (and right (compound-match right el pseudo))
      (return-from complex-match nil))
    (let ((node el))
      (loop for comb in (reverse combs)
            for comp in (reverse (butlast compounds))
            do (setf node
                     (ecase comb
                       (:child
                        (let ((p (dom-node-parent node)))
                          (when (and (dom-element-p p) (compound-match comp p nil)) p)))
                       (:descendant
                        (loop for p = (dom-node-parent node) then (dom-node-parent p)
                              while p
                              thereis (and (dom-element-p p) (compound-match comp p nil) p)))
                       (:next
                        (let ((prev (previous-element node)))
                          (when (and prev (compound-match comp prev nil)) prev)))
                       (:subsequent
                        (loop for p = (previous-element node) then (previous-element p)
                              while p
                              thereis (and (compound-match comp p nil) p)))))
            unless node return nil
            finally (return t)))))

(defun previous-element (el)
  (let ((prev nil))
    (dolist (c (and (dom-node-parent el) (dom-node-children (dom-node-parent el))) prev)
      (when (eq c el) (return prev))
      (when (dom-element-p c) (setf prev c)))))

;;; Stylesheet parser

(defun parse-declarations (string origin order-box)
  (let ((s (or string ""))
        (i 0)
        (decls nil))
    (labels ((peek () (if (< i (length s)) (char s i) nil))
             (skip ()
               (loop
                 (cond ((null (peek)) (return))
                       ((whitespace-char-p (peek)) (incf i))
                       ((and (char= (peek) #\/) (< (1+ i) (length s)) (char= (char s (1+ i)) #\*))
                        (incf i 2)
                        (loop while (and (< i (length s))
                                         (not (and (char= (char s i) #\*)
                                                   (< (1+ i) (length s))
                                                   (char= (char s (1+ i)) #\/))))
                              do (incf i))
                        (when (< i (length s)) (incf i 2)))
                       (t (return)))))
             (read-ident ()
               (skip)
               (let ((start i))
                 (when (and (peek) (or (alpha-char-p (peek)) (char= (peek) #\-) (char= (peek) #\_)))
                   (incf i)
                   (loop while (and (peek) (or (alphanumericp (peek)) (member (peek) '(#\- #\_))))
                         do (incf i))
                   (subseq s start i))))
             (read-value ()
               (let ((start i) (depth 0) (quote nil))
                 (loop while (< i (length s)) do
                   (let ((c (char s i)))
                     (cond
                       (quote
                        (when (char= c quote) (setf quote nil))
                        (incf i))
                       ((or (char= c #\") (char= c #\')) (setf quote c) (incf i))
                       ((member c '(#\( #\[)) (incf depth) (incf i))
                       ((member c '(#\) #\])) (decf depth) (incf i))
                       ((and (zerop depth) (or (char= c #\;) (char= c #\}))) (return))
                       (t (incf i)))))
                 (let* ((raw (trim-ws (subseq s start i)))
                        (bang (position #\! raw))
                        (important nil))
                   (when bang
                     (when (search "important" raw :start2 (1+ bang) :test #'char-equal)
                       (setf important t)
                       (setf raw (trim-ws (subseq raw 0 bang)))))
                   (values raw important)))))
      (loop while (< i (length s)) do
        (skip)
        (when (or (null (peek)) (char= (peek) #\})) (return))
        (let ((ident (read-ident)))
          (skip)
          (cond
            ((and ident (eql (peek) #\:))
             (incf i)
             (multiple-value-bind (raw important) (read-value)
               (let ((prop (if (and (>= (length ident) 2)
                                    (char= (char ident 0) #\-)
                                    (char= (char ident 1) #\-))
                               (string-downcase ident)
                               (intern (string-upcase ident) :keyword))))
                 (incf (car order-box))
                 (push (make-css-decl :property prop :raw raw :important important
                                      :origin origin :order (car order-box))
                       decls)))
             (when (eql (peek) #\;) (incf i)))
            (t
             (loop while (and (peek) (not (member (peek) '(#\; #\})))) do (incf i))
             (when (eql (peek) #\;) (incf i)))))))
    (nreverse decls)))

(defun media-matches (query width height)
  (if (eq query t)
      t
      (let ((parts (split-top-level (string-downcase query) #\,)))
        (some (lambda (part) (media-part-p (trim-ws part) width height)) parts))))

(defun media-part-p (part width height)
  (let* ((neg (and (>= (length part) 4) (string= (subseq part 0 4) "not ")))
         (body (cond (neg (trim-ws (subseq part 4)))
                     ((and (>= (length part) 5) (string= (subseq part 0 5) "only "))
                      (trim-ws (subseq part 5)))
                     (t part)))
         (bits (mapcar #'trim-ws (split-sequence-literal body " and ")))
         (ok (every (lambda (b) (media-feature-p b width height)) bits)))
    (if neg (not ok) ok)))

(defun split-sequence-literal (string sep)
  (let ((out nil) (start 0) (n (length sep)))
    (loop for pos = (search sep string :start2 start)
          while pos
          do (push (subseq string start pos) out)
             (setf start (+ pos n)))
    (push (subseq string start) out)
    (nreverse out)))

(defun media-length (text width height)
  (let ((toks (css-tokenize text)))
    (when toks
      (let ((v (parse-length-tok (car toks))))
        (cond
          ((numberp v) v)
          ((and (consp v) (eq (car v) :px)) (cdr v))
          ((and (consp v) (eq (car v) :em)) (* (cdr v) 16d0))
          ((and (consp v) (eq (car v) :rem)) (* (cdr v) 16d0))
          ((and (consp v) (eq (car v) :vw)) (* (cdr v) 0.01d0 width))
          ((and (consp v) (eq (car v) :vh)) (* (cdr v) 0.01d0 height))
          ((and (consp v) (eq (car v) :%)) (* (cdr v) 0.01d0 width))
          (t nil))))))

(defun media-feature-p (feat width height)
  (cond
    ((or (equal feat "all") (equal feat "screen")) t)
    ((equal feat "print") nil)
    ((and (plusp (length feat)) (char= (char feat 0) #\())
     (let* ((inner (string-trim '(#\( #\) #\space) feat))
            (colon (position #\: inner)))
       (unless colon (return-from media-feature-p nil))
       (let ((name (trim-ws (subseq inner 0 colon)))
             (val (trim-ws (subseq inner (1+ colon))))
             (len nil))
         (setf len (media-length val width height))
         (cond
           ((equal name "min-width") (and len (>= width len)))
           ((equal name "max-width") (and len (<= width len)))
           ((equal name "min-height") (and len (>= height len)))
           ((equal name "max-height") (and len (<= height len)))
           ((equal name "orientation")
            (if (>= width height) (equal val "landscape") (equal val "portrait")))
           ((equal name "prefers-color-scheme") (equal val "light"))
           (t nil)))))
    (t t)))

(defun supports-matches (query)
  (let ((s (string-downcase (trim-ws query))))
    (cond
      ((and (>= (length s) 4) (string= (subseq s 0 4) "not "))
       (not (supports-matches (subseq s 4))))
      (t
       (let ((open (position #\( s))
             (colon (position #\: s)))
         (if (and open colon)
             (let ((name (trim-ws (subseq s (1+ open) colon))))
               (and (not (zerop (length name)))
                    (or (char= (char name 0) #\-)
                        (gethash name *known-properties*))))
             t))))))

(defun css-import-url (prelude)
  "The URL from an @import prelude, without quotes."
  (let ((s (trim-ws (or prelude ""))))
    (when (zerop (length s))
      (return-from css-import-url nil))
    (cond
      ((and (>= (length s) 4) (string-equal s "url(" :end1 4))
       (let* ((inner (subseq s 4))
              (end (position #\) inner))
              (body (trim-ws (subseq inner 0 (or end (length inner))))))
         (string-trim '(#\" #\') body)))
      ((member (char s 0) '(#\" #\'))
       (let ((q (char s 0)))
         (subseq s 1 (or (position q s :start 1) (length s)))))
      (t (let ((sp (position-if #'whitespace-char-p s)))
           (subseq s 0 (or sp (length s))))))))

(defun parse-stylesheet (string &key (origin :author) (width 1024d0) (height 768d0)
                                 (order nil) (base *document-base*))
  (let* ((s (or string ""))
         (n (length s))
         (i 0)
         (order (or order (list 0)))
         (rules nil)
         (sheet (make-stylesheet))
         (*document-base* base))
    (labels ((peek () (if (< i n) (char s i) nil))
             (skip ()
               (loop
                 (cond ((null (peek)) (return))
                       ((whitespace-char-p (peek)) (incf i))
                       ((and (char= (peek) #\/) (< (1+ i) n) (char= (char s (1+ i)) #\*))
                        (incf i 2)
                        (loop while (and (< i n)
                                         (not (and (char= (char s i) #\*)
                                                   (< (1+ i) n)
                                                   (char= (char s (1+ i)) #\/))))
                              do (incf i))
                        (when (< i n) (incf i 2)))
                       (t (return)))))
             (read-until-brace-or-semi ()
               (let ((start i) (depth 0) (quote nil))
                 (loop while (< i n) do
                   (let ((c (char s i)))
                     (cond
                       (quote (when (char= c quote) (setf quote nil)) (incf i))
                       ((or (char= c #\") (char= c #\')) (setf quote c) (incf i))
                       ((and (char= c #\/) (< (1+ i) n) (char= (char s (1+ i)) #\*))
                        (incf i 2)
                        (loop while (and (< i n)
                                         (not (and (char= (char s i) #\*)
                                                   (< (1+ i) n)
                                                   (char= (char s (1+ i)) #\/))))
                              do (incf i))
                        (when (< i n) (incf i 2)))
                       ((member c '(#\( #\[)) (incf depth) (incf i))
                       ((member c '(#\) #\])) (when (plusp depth) (decf depth)) (incf i))
                       ((and (zerop depth) (or (char= c #\{) (char= c #\;))) (return))
                       (t (incf i)))))
                 (trim-ws (subseq s start i))))
             (read-block ()
               (skip)
               (unless (eql (peek) #\{) (return-from read-block ""))
               (incf i)
               (let ((start i) (depth 1) (quote nil))
                 (loop while (and (< i n) (plusp depth)) do
                   (let ((c (char s i)))
                     (cond
                       (quote (when (char= c quote) (setf quote nil)) (incf i))
                       ((or (char= c #\") (char= c #\')) (setf quote c) (incf i))
                       ((char= c #\{) (incf depth) (incf i))
                       ((char= c #\}) (decf depth) (incf i))
                       (t (incf i)))))
                 (subseq s start (max start (1- i)))))
             (add-rules (body media)
               (let ((inner (parse-stylesheet body :origin origin :width width :height height
                                              :order order :base *document-base*)))
                 (dolist (r (stylesheet-rules inner))
                   (setf (css-rule-media r)
                         (if (eq media t)
                             (css-rule-media r)
                             media))
                   (push r rules))
                 (maphash (lambda (k v)
                            (setf (gethash k (stylesheet-keyframes sheet)) v))
                          (stylesheet-keyframes inner))))
             (parse-keyframes (name body)
               (let ((fi 0) (fn (length body)) (frames nil))
                 (labels ((pk () (if (< fi fn) (char body fi) nil))
                          (sk ()
                            (loop while (and (pk) (whitespace-char-p (pk))) do (incf fi))))
                   (loop while (< fi fn) do
                     (sk)
                     (when (null (pk)) (return))
                     (let ((start fi))
                       (loop while (and (pk) (not (member (pk) '(#\{ #\, #\space #\tab #\newline))))
                             do (incf fi))
                       (let ((key (string-downcase (trim-ws (subseq body start fi)))))
                         (sk)
                         (when (eql (pk) #\,) (incf fi) (sk))
                         (let ((pct (cond ((equal key "from") 0d0)
                                          ((equal key "to") 100d0)
                                          ((and (plusp (length key)) (char= (char key (1- (length key))) #\%))
                                           (ignore-errors (float (read-from-string (subseq key 0 (1- (length key)))) 1d0)))
                                          (t nil))))
                           (sk)
                           (when (eql (pk) #\{)
                             (incf fi)
                             (let ((bs fi) (depth 1))
                               (loop while (and (< fi fn) (plusp depth)) do
                                 (cond ((char= (char body fi) #\{) (incf depth))
                                       ((char= (char body fi) #\}) (decf depth)))
                                 (incf fi))
                               (when pct
                                 (push (cons pct (parse-declarations (subseq body bs (1- fi)) origin order))
                                       frames)))))))))
                 (setf (gethash (string-downcase name) (stylesheet-keyframes sheet))
                       (sort frames #'< :key #'car)))
             ))
      (loop while (< i n) do
        (skip)
        (when (null (peek)) (return))
        (cond
          ((char= (peek) #\@)
           (incf i)
           (let ((start i))
             (loop while (and (peek) (or (alphanumericp (peek)) (char= (peek) #\-))) do (incf i))
             (let ((name (string-downcase (subseq s start i)))
                   (prelude (read-until-brace-or-semi)))
               (cond
                 ((equal name "import")
                  (let* ((url (css-import-url prelude))
                         (abs (and url (resolve-url url *document-base*)))
                         (text (and abs (fetch-css-text abs))))
                    (when (and text (plusp (length text)))
                      (let ((inner (parse-stylesheet text :origin origin
                                                     :width width :height height
                                                     :order order
                                                     :base (url-directory abs))))
                        (dolist (r (stylesheet-rules inner))
                          (push r rules))
                        (maphash (lambda (k v)
                                   (setf (gethash k (stylesheet-keyframes sheet)) v))
                                 (stylesheet-keyframes inner)))))
                  (when (eql (peek) #\;) (incf i))
                  (when (eql (peek) #\{) (read-block)))
                 ((eql (peek) #\;)
                  (incf i))
                 ((eql (peek) #\{)
                  (let ((body (read-block)))
                    (cond
                      ((equal name "media")
                       (when (media-matches prelude width height)
                         (add-rules body prelude)))
                      ((member name '("keyframes" "-webkit-keyframes") :test #'equal)
                       (parse-keyframes (trim-ws prelude) body))
                      ((equal name "supports")
                       (when (supports-matches prelude)
                         (add-rules body t)))
                      (t nil))))
                 (t nil)))))
          (t
           (let ((prelude (read-until-brace-or-semi)))
             (when (eql (peek) #\{)
               (let ((body (read-block))
                     (sels (parse-selector-list prelude)))
                 (when sels
                   (let ((decls (parse-declarations body origin order)))
                     (dolist (sel sels)
                       (push (make-css-rule :selector sel
                                            :specificity (selector-specificity sel)
                                            :origin origin
                                            :declarations decls)
                             rules))))))))))
    (setf (stylesheet-rules sheet) (nreverse rules))
    sheet)))

(defun rank-of (origin important)
  (if important
      (case origin (:author 4) (:user 5) (:ua 6) (t 4))
      (case origin (:ua 1) (:user 2) (:author 3) (t 3))))

(defun sort-key (decl spec)
  (list (rank-of (css-decl-origin decl) (css-decl-important decl))
        (or spec '(0 0 0))
        (css-decl-order decl)))

(defun key> (a b)
  (loop for x in a
        for y in b
        do (cond ((and (numberp x) (numberp y))
                  (cond ((> x y) (return t))
                        ((< x y) (return nil))))
                 ((and (consp x) (consp y))
                  (cond ((key> x y) (return t))
                        ((key> y x) (return nil)))))
        finally (return nil)))

(defun lookup-var (name table)
  (when table (gethash name table)))

(defun substitute-vars (raw table)
  (let ((s raw))
    (loop for n below 8 do
      (let ((pos (search "var(" s :test #'char-equal)))
        (unless pos (return))
        (let* ((start (+ pos 4))
               (depth 1)
               (i start))
          (loop while (and (< i (length s)) (plusp depth)) do
            (cond ((char= (char s i) #\() (incf depth))
                  ((char= (char s i) #\)) (decf depth)))
            (when (plusp depth) (incf i)))
          (let* ((inner (trim-ws (subseq s start i)))
                 (comma (position #\, inner))
                 (vname (string-downcase (trim-ws (subseq inner 0 (or comma (length inner))))))
                 (fallback (when comma (trim-ws (subseq inner (1+ comma)))))
                 (val (lookup-var vname table)))
            (setf s (concatenate 'string
                                 (subseq s 0 pos)
                                 (or val fallback "unset")
                                 (subseq s (min (length s) (1+ i)))))))))
    s))

(defun custom-table-for (element rules)
  (let ((table (if (and (dom-node-parent element)
                        (dom-element-p (dom-node-parent element))
                        (dom-element-style (dom-node-parent element)))
                   (copy-custom (computed-custom (dom-element-style (dom-node-parent element))))
                   (make-hash-table :test #'equal)))
        (best (make-hash-table :test #'equal)))
    (dolist (rule rules)
      (when (and (media-matches (css-rule-media rule) *viewport-width* *viewport-height*)
                 (complex-match (css-rule-selector rule) element nil))
        (dolist (d (css-rule-declarations rule))
          (when (stringp (css-decl-property d))
            (let* ((k (css-decl-property d))
                   (old (gethash k best))
                   (spec (cons 0 (css-rule-specificity rule))))
              (when (or (null old) (key> (sort-key d spec) (sort-key (car old) (cdr old))))
                (setf (gethash k best) (cons d spec))))))))
    (maphash (lambda (k pair)
               (setf (gethash k table) (substitute-vars (css-decl-raw (car pair)) table)))
             best)
    table))

(defun copy-custom (table)
  (let ((n (make-hash-table :test #'equal)))
    (when table (maphash (lambda (k v) (setf (gethash k n) v)) table))
    n))

(defun matching-longhands (element rules pseudo inline-decls)
  (let ((found nil))
    (dolist (rule rules)
      (when (and (media-matches (css-rule-media rule) *viewport-width* *viewport-height*)
                 (complex-match (css-rule-selector rule) element pseudo))
        (dolist (d (css-rule-declarations rule))
          (unless (stringp (css-decl-property d))
            (let ((raw (substitute-vars (css-decl-raw d) (computed-custom (dom-element-style element)))))
              (dolist (pair (expand-declaration (css-decl-property d) raw))
                (push (list (car pair) (cdr pair) d (cons 0 (css-rule-specificity rule))) found)))))))
    (dolist (d inline-decls)
      (let ((raw (substitute-vars (css-decl-raw d) (computed-custom (dom-element-style element)))))
        (dolist (pair (expand-declaration (css-decl-property d) raw))
          (push (list (car pair) (cdr pair) d '(1 0 0 0)) found))))
    ;; width and height attributes beat the user-agent size and lose to author CSS.
    (when (and (not pseudo)
               (member (dom-element-tag element)
                       '("iframe" "object" "embed"
                         "table" "td" "th" "tr" "col" "colgroup" "hr")
                       :test #'string-equal))
      (dolist (name '("width" "height"))
        (let ((raw (html-dimension-raw (dom-attr element name))))
          (when raw
            (let ((decl (make-css-decl :property (intern (string-upcase name) :keyword)
                                       :raw raw :origin :author :order 0)))
              (dolist (pair (expand-declaration (css-decl-property decl) raw))
                (push (list (car pair) (cdr pair) decl '(0 0 0 0)) found)))))))
    ;; bordercolor loses to an author border-color.
    (when (and (not pseudo) (string-equal (dom-element-tag element) "table"))
      (let ((raw (string-trim '(#\space #\newline #\tab #\return)
                              (or (dom-attr element "bordercolor") ""))))
        (when (plusp (length raw))
          (let ((decl (make-css-decl :property :border-top-color :raw raw
                                     :origin :author :order 0)))
            (dolist (prop '(:border-top-color :border-right-color
                            :border-bottom-color :border-left-color))
              (dolist (pair (expand-declaration prop raw))
                (push (list (car pair) (cdr pair) decl '(0 0 0 0)) found)))))))
    ;; hr size is the border-box height. The two 1px borders come out of it.
    (when (and (not pseudo) (string-equal (dom-element-tag element) "hr"))
      (let* ((raw (string-trim '(#\space #\newline #\tab #\return)
                               (or (dom-attr element "size") "")))
             (n (and (plusp (length raw))
                     (ignore-errors (parse-integer raw :junk-allowed t)))))
        (when (and n (>= n 0))
          (let* ((px (max 0 (- n 2)))
                 (decl (make-css-decl :property :height
                                      :raw (format nil "~Dpx" px)
                                      :origin :author :order 0)))
            (dolist (pair (expand-declaration :height (css-decl-raw decl)))
              (push (list (car pair) (cdr pair) decl '(0 0 0 0)) found))))))
    ;; nowrap on a cell loses to an author white-space.
    (when (and (not pseudo)
               (member (dom-element-tag element) '("td" "th") :test #'string-equal)
               (dom-attr element "nowrap"))
      (let ((decl (make-css-decl :property :white-space :raw "nowrap"
                                 :origin :author :order 0)))
        (dolist (pair (expand-declaration :white-space "nowrap"))
          (push (list (car pair) (cdr pair) decl '(0 0 0 0)) found))))
    ;; ol/ul/li type loses to an author list-style-type.
    (when (and (not pseudo)
               (member (dom-element-tag element) '("ol" "ul" "li") :test #'string-equal))
      (let ((mapped (list-type-name (dom-attr element "type"))))
        (when mapped
          (let ((decl (make-css-decl :property :list-style-type :raw mapped
                                     :origin :author :order 0)))
            (dolist (pair (expand-declaration :list-style-type mapped))
              (push (list (car pair) (cdr pair) decl '(0 0 0 0)) found))))))
    found))

(defun list-type-name (raw)
  "The list-style-type name for an HTML type attribute, or nil."
  (let ((s (string-trim '(#\space #\newline #\tab #\return) (or raw ""))))
    (cond ((string= s "a") "lower-alpha")
          ((string= s "A") "upper-alpha")
          ((string= s "i") "lower-roman")
          ((string= s "I") "upper-roman")
          ((zerop (length s)) nil)
          (t (let ((down (string-downcase s)))
               (cond ((string= down "1") "decimal")
                     ((string= down "disc") "disc")
                     ((string= down "circle") "circle")
                     ((string= down "square") "square")))))))

(defun html-dimension-raw (raw)
  "An HTML width or height attribute, as a CSS length."
  (let ((s (string-trim '(#\space #\newline #\tab #\return) (or raw ""))))
    (cond ((zerop (length s)) nil)
          ((char= (char s (1- (length s))) #\%) s)
          (t (let ((n (ignore-errors (parse-integer s :junk-allowed t))))
               (when n (format nil "~Dpx" n)))))))

(defun absolutize (value font-size)
  (cond
    ((numberp value) (float value 1d0))
    ((or (eq value :auto) (eq value :none) (eq value :min-content) (eq value :max-content)
         (eq value :fit-content) (keywordp value))
     value)
    ((not (consp value)) value)
    ((eq (car value) :px) (float (cdr value) 1d0))
    ((eq (car value) :em) (* (cdr value) font-size))
    ((eq (car value) :rem) (* (cdr value) *root-font-size*))
    ((eq (car value) :pt) (* (cdr value) (/ 96d0 72d0)))
    ((eq (car value) :in) (* (cdr value) 96d0))
    ((eq (car value) :cm) (* (cdr value) (/ 96d0 2.54d0)))
    ((eq (car value) :mm) (* (cdr value) (/ 96d0 25.4d0)))
    ((eq (car value) :vw) (* (cdr value) 0.01d0 *viewport-width*))
    ((eq (car value) :vh) (* (cdr value) 0.01d0 *viewport-height*))
    ((eq (car value) :ch) (* (cdr value) (text-advance "0" font-size "monospace" :normal :normal)))
    ((eq (car value) :ex) (* (cdr value) 0.5d0 font-size))
    ((eq (car value) :%) value)
    ((eq (car value) :calc)
     (list :calc (absolutize-expr (cdr value) font-size)))
    ((eq (car value) :mult) value)
    ((eq (car value) :global) value)
    (t value)))

(defun absolutize-expr (expr font-size)
  (cond
    ((numberp expr) (float expr 1d0))
    ((and (consp expr) (member (car expr) '(:+ :- :* :/)))
     (list (car expr)
           (absolutize-expr (second expr) font-size)
           (absolutize-expr (third expr) font-size)))
    (t (absolutize expr font-size))))

(defun keyword-font-size (kw parent)
  (case kw
    (:xx-small 9d0) (:x-small 10d0) (:small 13d0) (:medium 16d0)
    (:large 18d0) (:x-large 24d0) (:xx-large 32d0)
    (:smaller (/ parent 1.2d0))
    (:larger (* parent 1.2d0))
    (t parent)))

(defun apply-longhand (style prop value parent-size)
  (flet ((len (v)
           (absolutize v (computed-font-size style))))
    (cond
      ((and (consp value) (eq (car value) :global))
       (apply-global style prop (cdr value)))
      (t
       (case prop
         (:display (setf (computed-display style) value))
         (:position (setf (computed-position style) value))
         (:float (setf (computed-float style) value))
         (:clear (setf (computed-clear style) value))
         (:width (setf (computed-width style) (len value)))
         (:height (setf (computed-height style) (len value)))
         (:aspect-ratio (when (numberp value) (setf (computed-aspect-ratio style) (float value 1d0))))
         (:min-width (setf (computed-min-width style) (len value)))
         (:max-width (setf (computed-max-width style) (len value)))
         (:min-height (setf (computed-min-height style) (len value)))
         (:max-height (setf (computed-max-height style) (len value)))
         (:margin-top (setf (computed-mt style) (len value)))
         (:margin-right (setf (computed-mr style) (len value)))
         (:margin-bottom (setf (computed-mb style) (len value)))
         (:margin-left (setf (computed-ml style) (len value)))
         (:padding-top (setf (computed-pt style) (or (len value) 0d0)))
         (:padding-right (setf (computed-pr style) (or (len value) 0d0)))
         (:padding-bottom (setf (computed-pb style) (or (len value) 0d0)))
         (:padding-left (setf (computed-pl style) (or (len value) 0d0)))
         (:border-top-width (setf (computed-bt style) (or (len value) 3d0)))
         (:border-right-width (setf (computed-br style) (or (len value) 3d0)))
         (:border-bottom-width (setf (computed-bb style) (or (len value) 3d0)))
         (:border-left-width (setf (computed-bl style) (or (len value) 3d0)))
         (:border-top-style (setf (computed-bts style) value))
         (:border-right-style (setf (computed-brs style) value))
         (:border-bottom-style (setf (computed-bbs style) value))
         (:border-left-style (setf (computed-bls style) value))
         (:border-top-color (setf (computed-btc style) value))
         (:border-right-color (setf (computed-brc style) value))
         (:border-bottom-color (setf (computed-bbc style) value))
         (:border-left-color (setf (computed-blc style) value))
         (:border-radius (setf (computed-radius style) (or (len value) 0d0)))
         (:outline-width (setf (computed-outline-width style) (or (len value) 3d0)))
         (:outline-style (when value (setf (computed-outline-style style) value)))
         (:outline-color (setf (computed-outline-color style) value))
         (:outline-offset (setf (computed-outline-offset style) (or (len value) 0d0)))
         (:box-shadow
          (setf (computed-box-shadow style)
                (mapcar (lambda (sh)
                          (list (or (len (first sh)) 0d0)
                                (or (len (second sh)) 0d0)
                                (third sh)
                                (fourth sh)))
                        value)))
         (:text-shadow
          (setf (computed-text-shadow style)
                (mapcar (lambda (sh)
                          (list (or (len (first sh)) 0d0)
                                (or (len (second sh)) 0d0)
                                (third sh)))
                        value)))
         (:box-sizing (setf (computed-box-sizing style) value))
         (:color (when value (setf (computed-color style) value)))
         (:background-color (setf (computed-background style) value))
         (:background-image
          (cond ((and (consp value) (eq (car value) :repeating-linear-gradient))
                 (setf (computed-background-gradient style) (cons :repeat (cdr value))))
                ((and (consp value) (member (car value) '(:linear-gradient :radial-gradient)))
                 (setf (computed-background-gradient style) (cdr value)))
                (t (setf (computed-background-image style) value))))
         (:background-gradient (when value (setf (computed-background-gradient style) value)))
         (:background-repeat (when value (setf (computed-background-repeat style) value)))
         (:background-position
          (when value
            (setf (computed-background-position style)
                  (if (and (consp value) (not (eq (car value) :%)))
                      (mapcar (lambda (v)
                                (if (keywordp v) v (absolutize v parent-size)))
                              value)
                      (if (keywordp value) value (absolutize value parent-size))))))
         (:background-size
          (setf (computed-background-size style)
                (if (consp value)
                    (list (absolutize (first value) parent-size)
                          (absolutize (second value) parent-size))
                    value)))
         (:background-clip (when value (setf (computed-background-clip style) value)))
         (:background-origin (when value (setf (computed-background-origin style) value)))
         (:object-fit (when value (setf (computed-object-fit style) value)))
         (:object-position (when value (setf (computed-object-position style) value)))
         (:font-size
          (setf (computed-font-size style)
                (cond
                  ((keywordp value) (keyword-font-size value parent-size))
                  ((and (consp value) (eq (car value) :%))
                   (* 0.01d0 (cdr value) parent-size))
                  (t (or (absolutize value parent-size) parent-size)))))
         (:font-weight (setf (computed-font-weight style) value))
         (:font-style (setf (computed-font-style style) value))
         (:font-family (when value (setf (computed-font-family style) value)))
         (:line-height
          (cond
            ((eq value :normal)
             (setf (computed-line-height style) nil)
             (setf (computed-line-height-mult style) nil))
            ((and (consp value) (eq (car value) :mult))
             (setf (computed-line-height style) nil)
             (setf (computed-line-height-mult style) (cdr value)))
            (t
             (setf (computed-line-height style) (len value))
             (setf (computed-line-height-mult style) nil))))
         (:text-align (setf (computed-text-align style) value))
         (:text-transform (when value (setf (computed-text-transform style) value)))
         (:text-indent
          (setf (computed-text-indent style)
                (let ((v (absolutize value (or (computed-font-size style) 16d0))))
                  (if (numberp v) (float v 1d0) (or v 0d0)))))
         (:letter-spacing
          (setf (computed-letter-spacing style)
                (let ((v (absolutize value (or (computed-font-size style) 16d0))))
                  (if (numberp v) (float v 1d0) 0d0))))
         (:word-spacing
          (setf (computed-word-spacing style)
                (let ((v (absolutize value (or (computed-font-size style) 16d0))))
                  (if (numberp v) (float v 1d0) 0d0))))
         (:text-decoration (when value (setf (computed-text-decoration style) value)))
         (:text-decoration-color (setf (computed-text-decoration-color style) value))
         (:text-underline-offset
          (setf (computed-text-underline-offset style)
                (let ((v (if (eq value :auto)
                             0d0
                             (absolutize value (or (computed-font-size style) 16d0)))))
                  (if (numberp v) (float v 1d0) 0d0))))
         (:text-decoration-style
          (when value (setf (computed-text-decoration-style style) value)))
         (:text-decoration-thickness
          (setf (computed-text-decoration-thickness style)
                (let ((v (if (eq value :auto)
                             nil
                             (absolutize value (or (computed-font-size style) 16d0)))))
                  (when (and (numberp v) (> v 0d0)) (float v 1d0)))))
         (:white-space (setf (computed-white-space style) value))
         (:text-overflow (when value (setf (computed-text-overflow style) value)))
         ((:overflow-wrap :word-wrap)
          (when value (setf (computed-overflow-wrap style) value)))
         (:word-break (when value (setf (computed-word-break style) value)))
         (:border-collapse (when value (setf (computed-border-collapse style) value)))
         (:caption-side (when value (setf (computed-caption-side style) value)))
         (:empty-cells (when value (setf (computed-empty-cells style) value)))
         (:border-spacing
          (when (consp value)
            (setf (computed-border-spacing-x style) (or (len (first value)) 0d0)
                  (computed-border-spacing-y style) (or (len (second value)) 0d0))))
         (:vertical-align
          (when value
            (setf (computed-vertical-align style)
                  (if (keywordp value)
                      value
                      (absolutize value (computed-font-size style))))))
         (:flex-direction (setf (computed-flex-direction style) value))
         (:flex-wrap (setf (computed-flex-wrap style) value))
         (:justify-content (setf (computed-justify-content style) value))
         (:align-items (setf (computed-align-items style) value))
         (:align-content (setf (computed-align-content style) value))
         (:align-self (setf (computed-align-self style) value))
         (:flex-grow (setf (computed-flex-grow style) (float value 1d0)))
         (:flex-shrink (setf (computed-flex-shrink style) (float value 1d0)))
         (:flex-basis (setf (computed-flex-basis style) (if (numberp value) (float value 1d0) (len value))))
         (:row-gap (setf (computed-row-gap style) (or (len value) 0d0)))
         (:column-gap (setf (computed-column-gap style) (or (len value) 0d0)))
         (:order (setf (computed-order style) value))
         (:grid-template-columns (setf (computed-grid-columns style) (cdr value)))
         (:grid-template-rows (setf (computed-grid-rows style) (cdr value)))
         (:grid-auto-flow (setf (computed-grid-auto-flow style) value))
         (:grid-column (setf (computed-grid-column style) (cdr value)))
         (:grid-row (setf (computed-grid-row style) (cdr value)))
         (:top (setf (computed-top style) (len value)))
         (:right (setf (computed-right style) (len value)))
         (:bottom (setf (computed-bottom style) (len value)))
         (:left (setf (computed-left style) (len value)))
         (:z-index (setf (computed-z-index style) value))
         (:opacity (setf (computed-opacity style) (float value 1d0)))
         (:visibility (setf (computed-visibility style) value))
         (:overflow (setf (computed-overflow style) value))
         (:transform (setf (computed-transform style) value))
         (:content (setf (computed-content style) value))
         (:quotes (setf (computed-quotes style) value))
         (:column-count (setf (computed-column-count style) value))
         ((:list-style :list-style-type) (setf (computed-list-style style) value))
         (:list-style-position (when value (setf (computed-list-style-position style) value)))
         (:list-style-image (when value (setf (computed-list-style-image style) value)))
         (:animation-name (setf (computed-animation-name style) value))
         (:animation-duration (setf (computed-animation-duration style) (float value 1d0)))
         (:animation-iteration-count (setf (computed-animation-iteration style) value))
         (t
          (unless (computed-extras style)
            (setf (computed-extras style) (make-hash-table :test #'eq)))
          (setf (gethash prop (computed-extras style)) value)))))))

(defun apply-global (style prop which)
  "Global keywords. Inherited properties already copied onto STYLE, so INHERIT is a no-op for them."
  (declare (ignore style prop which))
  nil)

;; origin element is threaded by dynamic variable during cascade
(defvar *cascade-element* nil)

(defun initial-computed ()
  (make-computed :custom (make-hash-table :test #'equal)
                 :color (color-bytes 0 0 0)
                 :font-family '("serif")))

(defun inherit-computed (parent)
  (let ((s (initial-computed)))
    (when parent
      (setf (computed-color s) (copy-list (computed-color parent)))
      (setf (computed-font-size s) (computed-font-size parent))
      (setf (computed-font-weight s) (computed-font-weight parent))
      (setf (computed-font-style s) (computed-font-style parent))
      (setf (computed-font-family s) (computed-font-family parent))
      (setf (computed-line-height s) (computed-line-height parent))
      (setf (computed-line-height-mult s) (computed-line-height-mult parent))
      (setf (computed-text-align s) (computed-text-align parent))
      (setf (computed-text-transform s) (computed-text-transform parent))
      (setf (computed-text-indent s) (computed-text-indent parent))
      (setf (computed-letter-spacing s) (computed-letter-spacing parent))
      (setf (computed-text-underline-offset s) (computed-text-underline-offset parent))
      (setf (computed-text-decoration-thickness s) (computed-text-decoration-thickness parent))
      (setf (computed-text-decoration-style s) (computed-text-decoration-style parent))
      (setf (computed-word-spacing s) (computed-word-spacing parent))
      (setf (computed-text-shadow s) (computed-text-shadow parent))
      (setf (computed-white-space s) (computed-white-space parent))
      (setf (computed-overflow-wrap s) (computed-overflow-wrap parent))
      (setf (computed-word-break s) (computed-word-break parent))
      (setf (computed-border-collapse s) (computed-border-collapse parent))
      (setf (computed-caption-side s) (computed-caption-side parent))
      (setf (computed-empty-cells s) (computed-empty-cells parent))
      (setf (computed-border-spacing-x s) (computed-border-spacing-x parent))
      (setf (computed-border-spacing-y s) (computed-border-spacing-y parent))
      (setf (computed-visibility s) (computed-visibility parent))
      (setf (computed-list-style s) (computed-list-style parent))
      (setf (computed-list-style-position s) (computed-list-style-position parent))
      (setf (computed-list-style-image s) (computed-list-style-image parent))
      (setf (computed-quotes s) (computed-quotes parent))
      (setf (computed-custom s) (copy-custom (computed-custom parent))))
    s))

(defun monospace-family-p (family)
  "True when FAMILY is a generic or named monospace face."
  (let ((name (string-downcase
               (cond ((stringp family) family)
                     ((and (consp family) (stringp (car family))) (car family))
                     (t "")))))
    (member name '("monospace" "courier" "courier new" "ui-monospace") :test #'string=)))

(defun html-font-size (size-attr family)
  "Map an HTML font size attribute onto the browser's 1..7 pixel table.
A leading + or - is relative to 3, the default base. A monospace face uses
the smaller fixed table."
  (let* ((s (string-trim '(#\space #\newline #\tab #\return) (or size-attr "")))
         (n (and (plusp (length s)) (ignore-errors (parse-integer s :junk-allowed t)))))
    (when n
      (let ((index (max 1 (min 7
                               (if (find (char s 0) "+-")
                                   (+ 3 n)
                                   n)))))
        (nth (1- index)
             (if (monospace-family-p family)
                 '(10d0 12d0 13d0 16d0 20d0 26d0 39d0)
                 '(10d0 13d0 16d0 18d0 24d0 32d0 48d0)))))))

(defun apply-hr-presentational (element style)
  "noshade flattens the rule to a solid gray bar. size=1 keeps only the top edge."
  (when (and style (string-equal (dom-element-tag element) "hr"))
    (let ((noshade (dom-attr element "noshade"))
          (raw (string-trim '(#\space #\newline #\tab #\return)
                            (or (dom-attr element "size") ""))))
      (when noshade
        (when (eq (computed-bts style) :inset)
          (setf (computed-bts style) :solid (computed-brs style) :solid
                (computed-bbs style) :solid (computed-bls style) :solid))
        (unless (computed-background style)
          (setf (computed-background style) (color-bytes 128 128 128))))
      (let ((n (and (plusp (length raw))
                    (ignore-errors (parse-integer raw :junk-allowed t)))))
        (when (and n (> n 0) (< n 2)
                   (= (computed-bb style) 1d0)
                   (or (eq (computed-bbs style) :inset)
                       (and noshade (eq (computed-bbs style) :solid))))
          (setf (computed-bb style) 0d0))))))

(defun apply-valign-presentational (element style specified)
  "valign on a cell, or on its row, sets vertical-align. An author value wins."
  (when (and (not (gethash :vertical-align specified))
             (member (dom-element-tag element) '("td" "th") :test #'string-equal))
    (let* ((row (dom-node-parent element))
           (raw (or (dom-attr element "valign")
                    (and (dom-element-p row)
                         (string-equal (dom-element-tag row) "tr")
                         (dom-attr row "valign")))))
      (when (and raw (plusp (length (string-trim '(#\space #\newline #\tab) raw))))
        (let* ((value (string-downcase (string-trim '(#\space #\newline #\tab) raw)))
               (align (cond ((string= value "middle") :middle)
                            ((string= value "bottom") :bottom)
                            ((string= value "top") :top)
                            ((string= value "baseline") :baseline))))
          (when align (setf (computed-vertical-align style) align)))))))

(defun apply-align-presentational (element style specified)
  "align sets text alignment, centers a table, or floats a replaced element."
  (let ((raw (dom-attr element "align")))
    (when (and raw (plusp (length (string-trim '(#\space #\newline #\tab) raw))))
      (let ((tag (string-downcase (dom-element-tag element)))
            (value (string-downcase (string-trim '(#\space #\newline #\tab) raw))))
        (cond
          ((and (string= tag "table")
                (string= value "center")
                (not (gethash :margin-left specified))
                (not (gethash :margin-right specified)))
           (setf (computed-ml style) :auto
                 (computed-mr style) :auto))
          ((and (member tag '("img" "iframe" "embed" "object") :test #'string=)
                (not (gethash :float specified)))
           (cond ((string= value "left") (setf (computed-float style) :left))
                 ((string= value "right") (setf (computed-float style) :right))))
          ((and (not (gethash :text-align specified))
                (member tag '("div" "p" "h1" "h2" "h3" "h4" "h5" "h6"
                              "td" "th" "caption" "tr" "center")
                        :test #'string=))
           (let ((align (cond ((string= value "center") :center)
                              ((string= value "right") :right)
                              ((string= value "justify") :justify)
                              ((string= value "left") :left))))
             (when align (setf (computed-text-align style) align)))))))))

(defun apply-bgcolor-presentational (element style specified)
  "bgcolor on body, table, row, and cell. An author background wins."
  (when (and (not (gethash :background-color specified))
             (member (dom-element-tag element)
                     '("body" "table" "tr" "td" "th") :test #'string-equal))
    (let ((raw (dom-attr element "bgcolor")))
      (when (and raw (plusp (length (string-trim '(#\space #\newline #\tab) raw))))
        (let ((c (parse-color-tokens (css-tokenize raw))))
          (when (and c (listp c))
            (setf (computed-background style) c)))))))

(defun apply-font-presentational (element style specified)
  "The font element's size, color, and face attributes. An author rule wins."
  (when (string-equal (dom-element-tag element) "font")
    (let ((face (dom-attr element "face")))
      (when (and face (not (gethash :font-family specified)) (plusp (length (string-trim '(#\space) face))))
        (let ((families (parse-font-family (css-tokenize face))))
          (when families (setf (computed-font-family style) families)))))
    (let ((size (dom-attr element "size")))
      (when (and size (not (gethash :font-size specified)))
        (let ((px (html-font-size size (computed-font-family style))))
          (when px (setf (computed-font-size style) px)))))
    (let ((color (dom-attr element "color")))
      (when (and color (not (gethash :color specified)) (plusp (length (string-trim '(#\space) color))))
        (let ((c (parse-color-tokens (css-tokenize color))))
          (when (and c (listp c))
            (setf (computed-color style) c)))))))

(defun cascade-element (element rules &optional inline-decls pseudo parent-style)
  (let* ((*cascade-element* element)
         (style (inherit-computed parent-style))
         (previous (dom-element-style element)))
    (setf (computed-custom style)
          (if pseudo
              (copy-custom (and parent-style (computed-custom parent-style)))
              (custom-table-for element rules)))
    ;; matching-longhands reads custom properties off the element's style.
    (setf (dom-element-style element) style)
    (let* ((longhands (matching-longhands element rules pseudo inline-decls))
           (best (make-hash-table :test #'eq)))
      (dolist (item longhands)
        (destructuring-bind (prop value decl spec) item
          (let ((old (gethash prop best)))
            (when (or (null old) (key> (sort-key decl spec) (sort-key (third old) (fourth old))))
              (setf (gethash prop best) (list prop value decl spec))))))
      (let ((parent-size (if parent-style (computed-font-size parent-style) 16d0)))
        (let ((fs (gethash :font-size best)))
          (when fs (apply-longhand style :font-size (second fs) parent-size)))
        (maphash (lambda (prop item)
                   (unless (eq prop :font-size)
                     (apply-longhand style prop (second item) parent-size)))
                 best)
        (unless pseudo
          (apply-font-presentational element style best)
          (apply-bgcolor-presentational element style best)
          (apply-align-presentational element style best)
          (apply-valign-presentational element style best)
          (apply-hr-presentational element style))))
    (if pseudo
        (setf (dom-element-style element) previous)
        (setf (dom-element-style element) style))
    style))

(defun element-inline-decls (element order-box)
  (let ((raw (dom-attr element "style")))
    (when (and raw (plusp (length raw)))
      (parse-declarations raw :author order-box))))

(defun cascade-tree (root rules)
  (let ((order (list 1000000)))
    (labels ((walk (el parent-style)
               (when (dom-element-p el)
                 (let* ((inline (element-inline-decls el order))
                        (st (cascade-element el rules inline nil parent-style)))
                   (setf (dom-element-style el) st)
                   (setf (dom-element-before-style el)
                         (cascade-element el rules nil "before" st))
                   (setf (dom-element-after-style el)
                         (cascade-element el rules nil "after" st))
                   (dolist (c (element-children el))
                     (walk c st))))))
      (walk root nil))))

(defun used-line-height (style)
  "A set length wins, then a unitless multiplier, otherwise the font's own spacing."
  (cond
    ((numberp (computed-line-height style))
     (float (computed-line-height style) 1d0))
    ((numberp (computed-line-height-mult style))
     (* (computed-line-height-mult style) (computed-font-size style)))
    (t (font-height (computed-font-size style)
                    (computed-font-family style)
                    (computed-font-weight style)
                    (computed-font-style style)))))

(defun used-border-width (width style)
  (if (member style '(:none :hidden nil))
      0d0
      (if (numberp width) (float width 1d0) 0d0)))

(defun resolve-px (value container)
  "Resolve a used length against CONTAINER. NIL if the value is auto/none."
  (cond
    ((null value) nil)
    ((numberp value) (float value 1d0))
    ((eq value :auto) nil)
    ((eq value :none) nil)
    ((keywordp value) nil)
    ((and (consp value) (eq (car value) :%))
     (when container (* 0.01d0 (float (cdr value) 1d0) (float container 1d0))))
    ((and (consp value) (eq (car value) :calc))
     (eval-calc (second value) container))
    (t nil)))

(defun eval-calc (expr container)
  (cond
    ((numberp expr) (float expr 1d0))
    ((and (consp expr) (eq (car expr) :%))
     (* 0.01d0 (cdr expr) (or container 0d0)))
    ((and (consp expr) (eq (car expr) :+))
     (+ (eval-calc (second expr) container) (eval-calc (third expr) container)))
    ((and (consp expr) (eq (car expr) :-))
     (- (eval-calc (second expr) container) (eval-calc (third expr) container)))
    ((and (consp expr) (eq (car expr) :*))
     (* (eval-calc (second expr) container) (eval-calc (third expr) container)))
    ((and (consp expr) (eq (car expr) :/))
     (let ((d (eval-calc (third expr) container)))
       (if (zerop d) 0d0 (/ (eval-calc (second expr) container) d))))
    (t 0d0)))

(defun style-value (style property)
  "Read a computed value. STYLE may be a box or a computed style."
  (let ((st (if (box-p style) (box-style style) style)))
    (unless st (return-from style-value nil))
    (case property
      (:display (computed-display st))
      (:color (computed-color st))
      (:width (computed-width st))
      (:height (computed-height st))
      (:font-size (computed-font-size st))
      (:background-color (computed-background st))
      (:margin-left (computed-ml st))
      (:position (computed-position st))
      (t (and (computed-extras st) (gethash property (computed-extras st)))))))

(defun quote-depth (element)
  "How many open quotes already wrap ELEMENT."
  (if (not (dom-element-p element))
      0
      (loop for n = (dom-node-parent element) then (dom-node-parent n)
            while (dom-element-p n)
            count (let ((st (dom-element-before-style n)))
                    (and st (eq (computed-content st) :open-quote))))))

(defun quote-pairs (style)
  "Quote strings for STYLE. Auto, the initial value, is the English pair."
  (let ((raw (and style (computed-quotes style))))
    (cond ((eq raw :none) nil)
          ((consp raw) raw)
          (t (list (string (code-char #x201C))
                   (string (code-char #x201D))
                   (string (code-char #x2018))
                   (string (code-char #x2019)))))))

(defun quote-glyph (element kind style)
  "Open or close glyph for ELEMENT. The last quotes pair repeats."
  (let* ((pairs (quote-pairs style))
         (depth (quote-depth element))
         (pair (if pairs (min depth (1- (max 1 (floor (length pairs) 2)))) 0))
         (offset (if (eq kind :close-quote) 1 0)))
    (or (and pairs (nth (+ (* pair 2) offset) pairs)) "")))

(defun generated-text (style element)
  "Text for a :before or :after style, resolving open-quote and close-quote."
  (let ((c (and style (computed-content style))))
    (cond ((stringp c) c)
          ((member c '(:open-quote :close-quote))
           (quote-glyph element c style))
          (t nil))))

(defun content-string (style)
  (generated-text style nil))
