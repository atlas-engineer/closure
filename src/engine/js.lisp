;;; A JavaScript interpreter for Closure.
;;; It runs classic scripts against the document: declarations, control flow,
;;; calls, and a small DOM (getElementById, textContent, innerHTML, className).

(in-package :closure.engine)

(define-condition js-error (error)
  ((message :initarg :message :reader js-error-message))
  (:report (lambda (c s) (format s "JavaScript error: ~A" (js-error-message c)))))

(define-condition js-exception (error)
  ((value :initarg :value :reader js-exception-value)))

(defstruct js-env
  (bindings (make-hash-table :test #'equal))
  parent)

(defstruct js-fn
  name params body env host
  (props (make-hash-table :test #'equal)))

(defstruct js-obj
  (props (make-hash-table :test #'equal))
  proto
  host)

(defvar *js-log* nil)
(defvar *js-document* nil)
(defvar *pending-navigation* nil
  "Set when a script assigns location.href. layout-html loads that URL.")

(defstruct js-location href)

(defun js-undef () :undefined)
(defun js-null () :null)

(defun js-truthy (v)
  (not (or (eq v :undefined) (eq v :null) (eq v :false) (eq v :nan)
           (and (numberp v) (zerop v))
           (and (stringp v) (zerop (length v))))))

(defun js-to-string (v)
  (cond ((stringp v) v)
        ((numberp v)
         (if (= v (fround v))
             (princ-to-string (round v))
             (format nil "~G" v)))
        ((eq v :true) "true")
        ((eq v :false) "false")
        ((eq v :null) "null")
        ((eq v :undefined) "undefined")
        ((eq v :nan) "NaN")
        ((and (numberp v) (sb-ext:float-infinity-p v))
         (if (minusp v) "-Infinity" "Infinity"))
        ((js-fn-p v) (or (js-fn-name v) "function"))
        ((js-obj-p v) "[object Object]")
        (t (princ-to-string v))))

(defun js-to-number (v)
  (cond ((numberp v) (float v 1d0))
        ((eq v :true) 1d0)
        ((or (eq v :false) (eq v :null)) 0d0)
        ((eq v :undefined) :nan)
        ((stringp v)
         (let ((n (ignore-errors (float (read-from-string v) 1d0))))
           (or n :nan)))
        (t :nan)))

(defun env-get-opt (env name)
  (loop for e = env then (js-env-parent e)
        while e
        do (multiple-value-bind (v ok) (gethash name (js-env-bindings e))
             (when ok (return-from env-get-opt v)))))

(defun env-get (env name)
  (loop for e = env then (js-env-parent e)
        while e
        do (multiple-value-bind (v ok) (gethash name (js-env-bindings e))
             (when ok (return-from env-get v))))
  (error 'js-error :message (format nil "ReferenceError: ~A is not defined" name)))

(defun env-set (env name value)
  (loop for e = env then (js-env-parent e)
        while e
        do (when (nth-value 1 (gethash name (js-env-bindings e)))
             (setf (gethash name (js-env-bindings e)) value)
             (return-from env-set value)))
  (setf (gethash name (js-env-bindings env)) value))

(defun env-define (env name value)
  (setf (gethash name (js-env-bindings env)) value))

;;; Tokenizer

(defstruct jtok kind text number line)

(defun js-whitespace-p (c)
  (and c (or (member c '(#\space #\tab #\newline #\return #\page #\vt))
             (char= c #\no-break_space)
             (char= c #\line_separator)
             (char= c #\paragraph_separator)
             (char= c (code-char #xfeff)))))

(defun js-string-escape (getc peek)
  (declare (ignore peek))
  (let ((esc (funcall getc)))
    (case esc
      (#\n #\newline)
      (#\t #\tab)
      (#\r #\return)
      (#\b #\backspace)
      (#\f #\page)
      (#\v #\vt)
      (#\u (let ((hex (make-string 4)))
             (dotimes (k 4) (setf (char hex k) (or (funcall getc) #\0)))
             (code-char (parse-integer hex :radix 16))))
      (#\x (let ((hex (make-string 2)))
             (dotimes (k 2) (setf (char hex k) (or (funcall getc) #\0)))
             (code-char (parse-integer hex :radix 16))))
      (t (or esc #\?)))))

(defun js-tokenize (source)
  (let ((s (or source ""))
        (i 0)
        (line 1)
        (out nil))
    (labels ((peek () (if (< i (length s)) (char s i) nil))
             (getc ()
               (let ((c (peek)))
                 (when c
                   (incf i)
                   (when (char= c #\newline) (incf line)))
                 c)))
      (loop while (peek) do
        (let ((c (peek)))
          (cond
            ((js-whitespace-p c) (getc))
            ((and (char= c #\/) (< (1+ i) (length s)) (char= (char s (1+ i)) #\/))
             (loop while (and (peek) (not (char= (peek) #\newline))) do (getc)))
            ((and (char= c #\/) (< (1+ i) (length s)) (char= (char s (1+ i)) #\*))
             (incf i 2)
             (loop while (and (< i (length s))
                              (not (and (char= (char s i) #\*)
                                        (< (1+ i) (length s))
                                        (char= (char s (1+ i)) #\/))))
                   do (when (char= (char s i) #\newline) (incf line))
                      (incf i))
             (when (< i (length s)) (incf i 2)))
            ((or (char= c #\") (char= c #\'))
             (getc)
             (let ((buf (make-array 0 :element-type 'character :adjustable t :fill-pointer 0)))
               (loop while (and (peek) (not (char= (peek) c))) do
                 (let ((ch (getc)))
                   (when (and (char= ch #\\) (peek))
                     (setf ch (js-string-escape #'getc #'peek)))
                   (vector-push-extend ch buf)))
               (when (peek) (getc))
               (push (make-jtok :kind :string :text buf :line line) out)))
            ((or (digit-char-p c)
                 (and (char= c #\.) (< (1+ i) (length s)) (digit-char-p (char s (1+ i)))))
             (let ((start i))
               (loop while (and (peek) (or (digit-char-p (peek)) (char= (peek) #\.))) do (getc))
               (push (make-jtok :kind :number
                                :number (float (read-from-string (subseq s start i)) 1d0)
                                :line line)
                     out)))
            ((or (alpha-char-p c) (char= c #\_) (char= c #\$))
             (let ((start i))
               (loop while (and (peek) (or (alphanumericp (peek)) (char= (peek) #\_) (char= (peek) #\$)))
                     do (getc))
               (push (make-jtok :kind :ident :text (subseq s start i) :line line) out)))
            (t
             (let* ((two (and (< (1+ i) (length s)) (subseq s i (+ i 2))))
                    (three (and (< (+ i 2) (length s)) (subseq s i (+ i 3)))))
               (cond
                 ((and three (member three '("===" "!==") :test #'string=))
                  (incf i 3)
                  (push (make-jtok :kind :punct :text three :line line) out))
                 ((and two (member two '("==" "!=" "<=" ">=" "&&" "||" "++" "--"
                                         "+=" "-=" "*=" "/=" "%=" "&=" "|=" "^="
                                         "<<" ">>")
                                   :test #'string=))
                  (incf i 2)
                  (push (make-jtok :kind :punct :text two :line line) out))
                 (t
                  (getc)
                  (push (make-jtok :kind :punct :text (string c) :line line) out)))))))))
    (nreverse out)))

;;; Parser

(defun js-parse (source)
  (let* ((toks (js-tokenize source))
         (i 0))
    (labels ((peek () (if (< i (length toks)) (nth i toks) nil))
             (at (text)
               (let ((tk (peek)))
                 (and tk
                      (string= (jtok-text tk) text)
                      (not (eq (jtok-kind tk) :string))
                      (not (eq (jtok-kind tk) :number)))))
             (eat (text)
               (if (at text)
                   (prog1 t (incf i))
                   nil))
             (expect (text)
               (unless (eat text)
                 (error 'js-error :message (format nil "expected ~A" text))))
             (parse-statements ()
               (let ((body nil))
                 (loop while (and (peek) (not (at "}")))
                       do (push (parse-statement) body))
                 (nreverse body)))
             (parse-block ()
               (expect "{")
               (let ((body (parse-statements)))
                 (expect "}")
                 (list :block body)))
             (parse-var-decl ()
               (let ((name (jtok-text (peek))))
                 (incf i)
                 (list :var name (when (eat "=") (parse-assign)))))
             (parse-statement ()
               (cond
                 ((at "{") (parse-block))
                 ((and (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "var"))
                  (incf i)
                  (let ((decl (parse-var-decl)))
                    (eat ";")
                    decl))
                 ((and (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "function"))
                  (parse-function t))
                 ((and (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "if"))
                  (incf i)
                  (expect "(")
                  (let ((test (parse-expr)))
                    (expect ")")
                    (let ((then (parse-statement))
                          (else (when (and (peek) (eq (jtok-kind (peek)) :ident)
                                           (string= (jtok-text (peek)) "else"))
                                  (incf i)
                                  (parse-statement))))
                      (list :if test then else))))
                 ((and (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "while"))
                  (incf i)
                  (expect "(")
                  (let ((test (parse-expr)))
                    (expect ")")
                    (list :while test (parse-statement))))
                 ((and (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "return"))
                  (incf i)
                  (let ((v (if (or (null (peek)) (at ";") (at "}"))
                               nil
                               (parse-expr))))
                    (eat ";")
                    (list :return v)))
                 ((and (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "throw"))
                  (incf i)
                  (let ((v (parse-expr)))
                    (eat ";")
                    (list :throw v)))
                 ((and (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "for"))
                  (incf i)
                  (expect "(")
                  (let ((init nil))
                    (cond
                      ((eat ";"))
                      ((and (peek) (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "var"))
                       (incf i)
                       (setf init (parse-var-decl))
                       (expect ";"))
                      (t
                       (setf init (list :expr (parse-expr)))
                       (expect ";")))
                    (let ((test (unless (eat ";")
                                  (prog1 (parse-expr) (expect ";")))))
                      (let ((update (unless (at ")") (parse-expr))))
                        (expect ")")
                        (list :for init test update (parse-statement))))))
                 ((and (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "do"))
                  (incf i)
                  (let ((body (parse-statement)))
                    (expect "while")
                    (expect "(")
                    (let ((test (parse-expr)))
                      (expect ")")
                      (eat ";")
                      (list :do body test))))
                 ((and (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "break"))
                  (incf i)
                  (eat ";")
                  (list :break))
                 ((and (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "continue"))
                  (incf i)
                  (eat ";")
                  (list :continue))
                 ((eat ";") (list :empty))
                 ((and (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "try"))
                  (incf i)
                  (let ((body (parse-block))
                        (catch-name nil)
                        (catch-body nil)
                        (finally nil))
                    (when (and (peek) (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "catch"))
                      (incf i)
                      (expect "(")
                      (setf catch-name (jtok-text (peek)))
                      (incf i)
                      (expect ")")
                      (setf catch-body (parse-block)))
                    (when (and (peek) (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "finally"))
                      (incf i)
                      (setf finally (parse-block)))
                    (list :try body catch-name catch-body finally)))
                 (t
                  (let ((e (parse-expr)))
                    (eat ";")
                    (list :expr e)))))
             (parse-function (named)
               (expect "function")
               (let ((name (when (and named (peek) (eq (jtok-kind (peek)) :ident))
                             (prog1 (jtok-text (peek)) (incf i))))
                     (params nil))
                 (expect "(")
                 (loop until (at ")") do
                   (push (jtok-text (peek)) params)
                   (incf i)
                   (unless (at ")") (expect ",")))
                 (expect ")")
                 (let ((body (parse-block)))
                   (list :function name (nreverse params) body))))
             (parse-expr () (parse-comma))
             (parse-comma ()
               (let ((left (parse-assign)))
                 (loop while (eat ",")
                       do (setf left (list :seq left (parse-assign))))
                 left))
             (parse-assign ()
               (let ((left (parse-cond)))
                 (if (and (peek) (member (jtok-text (peek)) '("=" "+=" "-=" "*=" "/=" "%=") :test #'string=)
                          (not (eq (jtok-kind (peek)) :string)))
                     (let ((op (jtok-text (peek))))
                       (incf i)
                       (unless (and (consp left) (member (first left) '(:var :get)))
                         (error 'js-error :message "SyntaxError: invalid assignment"))
                       (list :assign op left (parse-assign)))
                     left)))
             (parse-cond ()
               (let ((test (parse-or)))
                 (if (eat "?")
                     (let ((then (parse-assign)))
                       (expect ":")
                       (list :cond test then (parse-assign)))
                     test)))
             (parse-or ()
               (let ((left (parse-and)))
                 (loop while (eat "||")
                       do (setf left (list :binop "||" left (parse-and))))
                 left))
             (parse-and ()
               (let ((left (parse-eq)))
                 (loop while (eat "&&")
                       do (setf left (list :binop "&&" left (parse-eq))))
                 left))
             (parse-eq ()
               (let ((left (parse-rel)))
                 (loop while (and (peek) (member (jtok-text (peek)) '("==" "!=" "===" "!==") :test #'string=))
                       do (let ((op (jtok-text (peek))))
                            (incf i)
                            (setf left (list :binop op left (parse-rel)))))
                 left))
             (parse-rel ()
               (let ((left (parse-add)))
                 (loop while (and (peek)
                                 (not (eq (jtok-kind (peek)) :string))
                                 (member (jtok-text (peek)) '("<" ">" "<=" ">=" "instanceof" "in") :test #'string=))
                       do (let ((op (jtok-text (peek))))
                            (incf i)
                            (setf left (list :binop op left (parse-add)))))
                 left))
             (parse-add ()
               (let ((left (parse-mul)))
                 (loop while (and (peek) (member (jtok-text (peek)) '("+" "-") :test #'string=))
                       do (let ((op (jtok-text (peek))))
                            (incf i)
                            (setf left (list :binop op left (parse-mul)))))
                 left))
             (parse-mul ()
               (let ((left (parse-unary)))
                 (loop while (and (peek) (member (jtok-text (peek)) '("*" "/" "%") :test #'string=))
                       do (let ((op (jtok-text (peek))))
                            (incf i)
                            (setf left (list :binop op left (parse-unary)))))
                 left))
             (parse-unary ()
               (cond
                 ((eat "++") (list :update "++" t (parse-unary)))
                 ((eat "--") (list :update "--" t (parse-unary)))
                 ((eat "!") (list :unop "!" (parse-unary)))
                 ((eat "-") (list :unop "-" (parse-unary)))
                 ((eat "+") (list :unop "+" (parse-unary)))
                 ((and (peek) (eq (jtok-kind (peek)) :ident)
                       (member (jtok-text (peek)) '("typeof" "void" "delete") :test #'string=))
                  (let ((op (jtok-text (peek))))
                    (incf i)
                    (list :unop op (parse-unary))))
                 ((and (peek) (eq (jtok-kind (peek)) :ident) (string= (jtok-text (peek)) "new"))
                  (incf i)
                  (list :new (parse-postfix)))
                 (t (parse-postfix))))
             (parse-postfix ()
               (let ((expr (parse-primary)))
                 (loop
                   (cond
                     ((eat ".")
                      (let ((name (jtok-text (peek))))
                        (incf i)
                        (setf expr (list :get expr name))))
                     ((eat "[")
                      (let ((key (parse-expr)))
                        (expect "]")
                        (setf expr (list :get expr key))))
                     ((eat "++") (setf expr (list :update "++" nil expr)))
                     ((eat "--") (setf expr (list :update "--" nil expr)))
                     ((eat "(")
                      (let ((args nil))
                        (loop until (at ")") do
                          (push (parse-assign) args)
                          (unless (at ")") (expect ",")))
                        (expect ")")
                        (setf expr (list :call expr (nreverse args)))))
                     (t (return))))
                 expr))
             (parse-primary ()
               (let ((tk (peek)))
                 (unless tk (error 'js-error :message "unexpected end of script"))
                 (cond
                   ((eq (jtok-kind tk) :number) (incf i) (list :num (jtok-number tk)))
                   ((eq (jtok-kind tk) :string) (incf i) (list :str (jtok-text tk)))
                   ((eq (jtok-kind tk) :ident)
                    (let ((name (jtok-text tk)))
                      (incf i)
                      (cond
                        ((string= name "true") (list :bool :true))
                        ((string= name "false") (list :bool :false))
                        ((string= name "null") (list :null))
                        ((string= name "undefined") (list :undef))
                        ((string= name "function")
                         (decf i)
                         (parse-function nil))
                        (t (list :var name)))))
                   ((eat "(")
                    (let ((e (parse-expr)))
                      (expect ")")
                      e))
                   ((eat "[")
                    (let ((elts nil))
                      (loop until (at "]") do
                        (push (parse-assign) elts)
                        (unless (at "]") (expect ",")))
                      (expect "]")
                      (list :array (nreverse elts))))
                   ((eat "{")
                    (let ((pairs nil))
                      (loop until (at "}") do
                        (let ((key (jtok-text (peek))))
                          (incf i)
                          (expect ":")
                          (push (cons key (parse-assign)) pairs)
                          (unless (at "}") (expect ","))))
                      (expect "}")
                      (list :object (nreverse pairs))))
                   (t (error 'js-error :message (format nil "unexpected token ~A" (jtok-text tk))))))))
      (parse-statements))))

;;; Evaluation

(defun js-binop (op a b)
  (cond
    ((string= op "+")
     (if (or (stringp a) (stringp b))
         (concatenate 'string (js-to-string a) (js-to-string b))
         (let ((na (js-to-number a)) (nb (js-to-number b)))
           (cond ((or (eq na :nan) (eq nb :nan)) :nan)
                 ((and (numberp na) (sb-ext:float-infinity-p na)) na)
                 ((and (numberp nb) (sb-ext:float-infinity-p nb)) nb)
                 (t (handler-case (+ na nb)
                      (floating-point-overflow ()
                        (if (minusp na)
                            sb-ext:double-float-negative-infinity
                            sb-ext:double-float-positive-infinity))))))))
    ((member op '("-" "*" "/" "%") :test #'string=)
     (let ((na (js-to-number a)) (nb (js-to-number b)))
       (cond ((or (eq na :nan) (eq nb :nan)) :nan)
             ((string= op "-") (- na nb))
             ((string= op "*") (* na nb))
             ((string= op "/")
              (cond ((not (zerop nb)) (/ na nb))
                    ((zerop na) :nan)
                    ((minusp na) sb-ext:double-float-negative-infinity)
                    (t sb-ext:double-float-positive-infinity)))
             ((string= op "%") (if (zerop nb) :nan (mod na nb))))))
    ((string= op "==") (js-eq a b))
    ((string= op "!=") (if (eq (js-eq a b) :true) :false :true))
    ((string= op "===") (if (js-same a b) :true :false))
    ((string= op "!==") (if (js-same a b) :false :true))
    ((member op '("<" ">" "<=" ">=") :test #'string=)
     (let ((na (js-to-number a)) (nb (js-to-number b)))
       (if (or (eq na :nan) (eq nb :nan))
           :false
           (if (funcall (cond ((string= op "<") #'<)
                              ((string= op ">") #'>)
                              ((string= op "<=") #'<=)
                              (t #'>=))
                        na nb)
               :true :false))))
    ((string= op "&&") (if (js-truthy a) b a))
    ((string= op "||") (if (js-truthy a) a b))
    ((string= op "instanceof") (if (js-instanceof a b) :true :false))
    ((string= op "in") (if (js-has-property b a) :true :false))
    (t (error 'js-error :message (format nil "unknown operator ~A" op)))))

(defun js-same (a b)
  (cond
    ((or (eq a :nan) (eq b :nan)) nil)
    ((and (numberp a) (numberp b) (= a b)) t)
    ((and (stringp a) (stringp b) (string= a b)) t)
    ((eq a b) t)
    (t nil)))

(defun js-eq (a b)
  (cond
    ((or (and (eq a :null) (eq b :undefined))
         (and (eq a :undefined) (eq b :null)))
     :true)
    ((js-same a b) :true)
    ((and (numberp a) (stringp b)) (js-eq a (js-to-number b)))
    ((and (stringp a) (numberp b)) (js-eq (js-to-number a) b))
    (t :false)))

(defun js-get-prop (obj key)
  (cond
    ((and (js-obj-p obj) (dom-element-p (js-obj-host obj)) (string= key "textContent"))
     (dom-text-content (js-obj-host obj)))
    ((and (js-obj-p obj) (dom-element-p (js-obj-host obj)) (string= key "innerHTML"))
     (dom-text-content (js-obj-host obj)))
    ((and (js-obj-p obj) (dom-element-p (js-obj-host obj)) (string= key "id"))
     (or (dom-element-id (js-obj-host obj)) ""))
    ((and (js-obj-p obj) (dom-element-p (js-obj-host obj)) (string= key "className"))
     (format nil "~{~A~^ ~}" (dom-element-classes (js-obj-host obj))))
    ((and (js-obj-p obj) (dom-element-p (js-obj-host obj)) (string= key "value"))
     (form-control-value (js-obj-host obj)))
    ((and (js-obj-p obj) (dom-document-p (js-obj-host obj)) (string= key "title"))
     (document-title-text (js-obj-host obj)))
    ((and (js-obj-p obj) (js-location-p (js-obj-host obj)) (string= key "href"))
     (or (js-location-href (js-obj-host obj)) ""))
    ((js-obj-p obj)
     (multiple-value-bind (v ok) (gethash key (js-obj-props obj))
       (if ok
           v
           (let ((proto (js-obj-proto obj)))
             (if proto (js-get-prop proto key) (js-undef))))))
    ((js-fn-p obj)
     (multiple-value-bind (v ok) (gethash key (js-fn-props obj))
       (if ok v (js-undef))))
    (t (js-undef))))

(defun js-set-prop (obj key value)
  (cond
    ((and (js-obj-p obj) (dom-element-p (js-obj-host obj)) (string= key "textContent"))
     (set-element-text (js-obj-host obj) (js-to-string value))
     value)
    ((and (js-obj-p obj) (dom-element-p (js-obj-host obj)) (string= key "innerHTML"))
     (set-element-inner-html (js-obj-host obj) (js-to-string value))
     value)
    ((and (js-obj-p obj) (dom-element-p (js-obj-host obj)) (string= key "id"))
     (setf (dom-element-id (js-obj-host obj)) (js-to-string value))
     value)
    ((and (js-obj-p obj) (dom-element-p (js-obj-host obj)) (string= key "className"))
     (setf (dom-element-classes (js-obj-host obj)) (split-ws (js-to-string value)))
     value)
    ((and (js-obj-p obj) (dom-element-p (js-obj-host obj)) (string= key "value"))
     (set-form-control-value (js-obj-host obj) (js-to-string value))
     value)
    ((and (js-obj-p obj) (dom-document-p (js-obj-host obj)) (string= key "title"))
     (set-document-title (js-obj-host obj) (js-to-string value))
     value)
    ((and (js-obj-p obj) (js-location-p (js-obj-host obj)) (string= key "href"))
     (let ((href (js-to-string value)))
       (setf (js-location-href (js-obj-host obj)) href
             *pending-navigation* href)
       value))
    ((js-obj-p obj)
     (setf (gethash key (js-obj-props obj)) value))
    ((js-fn-p obj)
     (setf (gethash key (js-fn-props obj)) value))
    (t (error 'js-error :message "cannot set property"))))

(defun js-eval (expr env)
  (cond
    ((eq (first expr) :num) (second expr))
    ((eq (first expr) :str) (second expr))
    ((eq (first expr) :bool) (second expr))
    ((eq (first expr) :null) :null)
    ((eq (first expr) :undef) :undefined)
    ((eq (first expr) :var) (env-get env (second expr)))
    ((eq (first expr) :binop) (js-binop (second expr) (js-eval (third expr) env) (js-eval (fourth expr) env)))
    ((eq (first expr) :unop)
     (let ((v (js-eval (third expr) env)))
       (cond ((string= (second expr) "!") (if (js-truthy v) :false :true))
             ((string= (second expr) "typeof") (js-typeof v))
             ((string= (second expr) "void") :undefined)
             ((string= (second expr) "+")
              (let ((n (js-to-number v))) (if (eq n :nan) :nan n)))
             ((string= (second expr) "-")
              (let ((n (js-to-number v)))
                (if (eq n :nan) :nan (- n))))
             ((string= (second expr) "delete") :true)
             (t v))))
    ((eq (first expr) :new)
     (js-construct (second expr) env))
    ((eq (first expr) :get)
     (js-get-prop (js-eval (second expr) env) (js-key (third expr) env)))
    ((eq (first expr) :assign)
     (js-assign (second expr) (third expr) (js-eval (fourth expr) env) env))
    ((eq (first expr) :update)
     (js-update (second expr) (third expr) (fourth expr) env))
    ((eq (first expr) :seq)
     (js-eval (second expr) env)
     (js-eval (third expr) env))
    ((eq (first expr) :cond)
     (if (js-truthy (js-eval (second expr) env))
         (js-eval (third expr) env)
         (js-eval (fourth expr) env)))
    ((eq (first expr) :call)
     (js-call (second expr) (third expr) env))
    ((eq (first expr) :array)
     (let ((obj (make-js-obj)))
       (loop for elt in (second expr) for i from 0
             do (setf (gethash (princ-to-string i) (js-obj-props obj)) (js-eval elt env)))
       (setf (gethash "length" (js-obj-props obj)) (float (length (second expr)) 1d0))
       obj))
    ((eq (first expr) :object)
     (let ((obj (make-js-obj)))
       (loop for (k . v) in (second expr)
             do (setf (gethash k (js-obj-props obj)) (js-eval v env)))
       obj))
    ((eq (first expr) :function)
     (js-install-prototype
      (make-js-fn :name (second expr) :params (third expr) :body (fourth expr) :env env)))
    (t (error 'js-error :message "bad expression"))))

(defun js-key (key env)
  (if (stringp key)
      key
      (js-to-string (js-eval key env))))

(defun js-assign (op target value env)
  (let ((stored (if (string= op "=")
                    value
                    (js-binop (subseq op 0 1) (js-eval target env) value))))
    (cond
      ((and (consp target) (eq (first target) :var))
       (env-set env (second target) stored))
      ((and (consp target) (eq (first target) :get))
       (js-set-prop (js-eval (second target) env) (js-key (third target) env) stored))
      (t (error 'js-error :message "invalid assignment")))))

(defun js-update (op prefix target env)
  (let* ((cur (js-to-number (js-eval target env)))
         (next (cond ((eq cur :nan) :nan)
                     ((string= op "++") (+ cur 1d0))
                     (t (- cur 1d0)))))
    (js-assign "=" target next env)
    (if prefix next cur)))

(defun js-has-property (obj key)
  (and (or (js-obj-p obj) (js-fn-p obj))
       (let ((k (js-to-string key)))
         (loop for cur = obj then (and (js-obj-p cur) (js-obj-proto cur))
               while (or (js-obj-p cur) (js-fn-p cur))
               thereis (nth-value 1 (gethash k (if (js-fn-p cur) (js-fn-props cur) (js-obj-props cur))))))))

(defun js-call (callee-expr arg-exprs env)
  (let ((args (mapcar (lambda (a) (js-eval a env)) arg-exprs)))
    (cond
      ((and (consp callee-expr) (eq (first callee-expr) :var) (string= (second callee-expr) "eval"))
       (let ((code (first args)))
         (if (stringp code)
             (js-run-source code env)
             (or code :undefined))))
      ((and (consp callee-expr) (eq (first callee-expr) :get))
       (let ((obj (js-eval (second callee-expr) env)))
         (js-apply (js-get-prop obj (js-key (third callee-expr) env)) obj args)))
      (t (js-apply (js-eval callee-expr env) (or (env-get-opt env "this") :undefined) args)))))

(defun js-apply (fn this args)
  (cond
    ((and (js-fn-p fn) (js-fn-host fn))
     (funcall (js-fn-host fn) this args))
    ((js-fn-p fn)
     (let ((local (make-js-env :parent (js-fn-env fn))))
       (env-define local "this" this)
       (loop for p in (js-fn-params fn)
             for a = (pop args)
             do (env-define local p (or a :undefined)))
       (handler-case (js-exec (js-fn-body fn) local)
         (js-return (r) (js-return-value r))
         (:no-error (&rest values) (or (first values) :undefined)))))
    (t (error 'js-error :message "not a function"))))

(define-condition js-return (condition)
  ((value :initarg :value :reader js-return-value)))

(define-condition js-break (condition) ())
(define-condition js-continue (condition) ())

(defun js-install-prototype (fn)
  (let ((proto (make-js-obj)))
    (setf (gethash "constructor" (js-obj-props proto)) fn)
    (setf (gethash "prototype" (js-fn-props fn)) proto)
    fn))

(defun js-exec (stmt env)
  (case (first stmt)
    (:block (dolist (s (second stmt)) (js-exec s env)) :undefined)
    (:expr (js-eval (second stmt) env))
    (:var
     (env-define env (second stmt) (if (third stmt) (js-eval (third stmt) env) :undefined)))
    (:if
     (if (js-truthy (js-eval (second stmt) env))
         (js-exec (third stmt) env)
         (when (fourth stmt) (js-exec (fourth stmt) env))))
    (:while
     (loop while (js-truthy (js-eval (second stmt) env))
           do (handler-case (js-exec (third stmt) env)
                (js-break () (return))
                (js-continue ()))))
    (:for
     (when (second stmt) (js-exec (second stmt) env))
     (loop
       (when (and (third stmt) (not (js-truthy (js-eval (third stmt) env))))
         (return))
       (handler-case (js-exec (fifth stmt) env)
         (js-break () (return))
         (js-continue ()))
       (when (fourth stmt) (js-eval (fourth stmt) env))))
    (:do
     (loop
       (handler-case (js-exec (second stmt) env)
         (js-break () (return))
         (js-continue ()))
       (unless (js-truthy (js-eval (third stmt) env))
         (return))))
    (:break (signal 'js-break))
    (:continue (signal 'js-continue))
    (:empty :undefined)
    (:return
     (signal 'js-return :value (if (second stmt) (js-eval (second stmt) env) :undefined)))
    (:throw
     (signal 'js-exception :value (js-eval (second stmt) env)))
    (:try
     (unwind-protect
          (handler-case (js-exec (second stmt) env)
            (js-exception (exn)
              (if (third stmt)
                  (let ((local (make-js-env :parent env)))
                    (env-define local (third stmt) (js-exception-value exn))
                    (js-exec (fourth stmt) local))
                  (signal exn))))
       (when (fifth stmt) (js-exec (fifth stmt) env))))
    (:function
     (env-define env (second stmt)
                 (js-install-prototype
                  (make-js-fn :name (second stmt) :params (third stmt) :body (fourth stmt) :env env))))
    (t (error 'js-error :message "bad statement"))))

(defun js-exec-program (stmts env)
  (dolist (s stmts)
    (when (and (consp s) (eq (first s) :function) (second s))
      (env-define env (second s)
                  (js-install-prototype
                   (make-js-fn :name (second s) :params (third s) :body (fourth s) :env env)))))
  (dolist (s stmts)
    (when (and (consp s) (eq (first s) :var))
      (unless (nth-value 1 (gethash (second s) (js-env-bindings env)))
        (env-define env (second s) :undefined))))
  (let ((result :undefined))
    (dolist (s stmts)
      (unless (and (consp s) (eq (first s) :function))
        (setf result (or (js-exec s env) :undefined))))
    result))

;;; DOM host objects

(defun js-wrap-element (el)
  (if (null el)
      :null
      (make-js-obj :host el)))

(defun js-make-document (doc)
  (let ((obj (make-js-obj :host doc)))
    (setf (gethash "getElementById" (js-obj-props obj))
          (make-js-fn :name "getElementById" :host
                      (lambda (this args)
                        (declare (ignore this))
                        (js-wrap-element (find-element-by-id doc (js-to-string (first args)))))))
    (let ((body (find-element doc "body")))
      (setf (gethash "body" (js-obj-props obj)) (js-wrap-element body)))
    obj))

(defun js-make-console ()
  (let ((obj (make-js-obj)))
    (setf (gethash "log" (js-obj-props obj))
          (make-js-fn :name "log" :host
                      (lambda (this args)
                        (declare (ignore this))
                        (push (format nil "~{~A~^ ~}" (mapcar #'js-to-string args)) *js-log*)
                        :undefined)))
    obj))

(defun js-typeof (value)
  (cond ((or (eq value :undefined) (null value)) "undefined")
        ((eq value :null) "object")
        ((stringp value) "string")
        ((or (numberp value) (eq value :nan)) "number")
        ((or (eq value :true) (eq value :false)) "boolean")
        ((js-fn-p value) "function")
        (t "object")))

(defun js-instanceof (obj ctor)
  (when (and (js-obj-p obj) (js-fn-p ctor))
    (let ((proto (gethash "prototype" (js-fn-props ctor))))
      (loop for p = obj then (and (js-obj-p p) (js-obj-proto p))
            while (js-obj-p p)
            thereis (eq p proto)))))

(defun js-construct (call env)
  (let* ((callee-expr (if (and (consp call) (eq (first call) :call)) (second call) call))
         (arg-exprs (if (and (consp call) (eq (first call) :call)) (third call) nil))
         (args (mapcar (lambda (a) (js-eval a env)) arg-exprs))
         (fn (js-eval callee-expr env))
         (proto (and (js-fn-p fn) (gethash "prototype" (js-fn-props fn))))
         (this (make-js-obj :proto (if (js-obj-p proto) proto nil))))
    (setf (gethash "constructor" (js-obj-props this)) fn)
    (cond
      ((and (js-fn-p fn) (js-fn-host fn))
       (let ((returned (funcall (js-fn-host fn) this args)))
         (if (js-obj-p returned) returned this)))
      ((js-fn-p fn)
       (let ((returned (js-apply fn this args)))
         (if (js-obj-p returned) returned this)))
      (t (error 'js-error :message "TypeError: not a constructor")))))

(defun js-host (name fn)
  (js-install-prototype (make-js-fn :name name :host fn)))

(defun js-install-builtins (env)
  (let ((obj-proto (make-js-obj)))
    (setf (gethash "toString" (js-obj-props obj-proto))
          (js-host "toString"
                   (lambda (this args)
                     (declare (ignore args))
                     (cond ((eq this :undefined) "undefined")
                           ((eq this :null) "null")
                           ((js-fn-p this) "function () { [native code] }")
                           ((and (js-obj-p this) (numberp (js-obj-host this)))
                            (js-to-string (js-obj-host this)))
                           (t "[object Object]")))))
    (setf (gethash "valueOf" (js-obj-props obj-proto))
          (js-host "valueOf"
                   (lambda (this args)
                     (declare (ignore args))
                     (if (and (js-obj-p this) (js-obj-host this))
                         (js-obj-host this)
                         this))))
    (labels ((ctor (name host proto)
               (let ((fn (make-js-fn :name name :host host)))
                 (setf (gethash "prototype" (js-fn-props fn)) proto)
                 (when proto
                   (setf (gethash "constructor" (js-obj-props proto)) fn))
                 (env-define env name fn)
                 fn))
             (fn (name host)
               (env-define env name (js-host name host))))
      (ctor "Object"
            (lambda (this args)
              (declare (ignore this))
              (let ((v (first args)))
                (if (and args (js-obj-p v))
                    v
                    (make-js-obj :proto obj-proto))))
            obj-proto)
      (let ((num-proto (make-js-obj :proto obj-proto)))
        (setf (gethash "valueOf" (js-obj-props num-proto))
              (js-host "valueOf"
                       (lambda (this args)
                         (declare (ignore args))
                         (if (and (js-obj-p this) (numberp (js-obj-host this)))
                             (js-obj-host this)
                             (js-to-number this)))))
        (ctor "Number"
              (lambda (this args)
                (let ((n (if args (js-to-number (first args)) 0d0)))
                  (when (js-obj-p this) (setf (js-obj-host this) n))
                  n))
              num-proto)
        (let ((number (env-get env "Number")))
          (setf (gethash "NaN" (js-fn-props number)) :nan)
          (setf (gethash "POSITIVE_INFINITY" (js-fn-props number))
                sb-ext:double-float-positive-infinity)
          (setf (gethash "NEGATIVE_INFINITY" (js-fn-props number))
                sb-ext:double-float-negative-infinity)
          (setf (gethash "MAX_VALUE" (js-fn-props number)) most-positive-double-float)
          (setf (gethash "MIN_VALUE" (js-fn-props number)) least-positive-double-float)))
      (ctor "Boolean"
            (lambda (this args)
              (declare (ignore this))
              (if (and args (js-truthy (first args))) :true :false))
            (make-js-obj :proto obj-proto))
      (ctor "String"
            (lambda (this args)
              (let ((s (if args (js-to-string (first args)) "")))
                (when (js-obj-p this) (setf (js-obj-host this) s))
                s))
            (make-js-obj :proto obj-proto))
      (ctor "Array"
            (lambda (this args)
              (let ((obj (if (js-obj-p this) this (make-js-obj :proto obj-proto))))
                (loop for a in args for i from 0
                      do (setf (gethash (princ-to-string i) (js-obj-props obj)) a))
                (setf (gethash "length" (js-obj-props obj)) (float (length args) 1d0))
                obj))
            (make-js-obj :proto obj-proto))
      (ctor "Function"
            (lambda (this args)
              (declare (ignore this))
              (let ((src (if args (js-to-string (car (last args))) "")))
                (js-install-prototype
                 (make-js-fn :params nil :body (second (first (js-parse (format nil "(~A)" src)))) :env env))))
            (make-js-obj :proto obj-proto))
      (dolist (name '("Error" "EvalError" "RangeError" "ReferenceError" "SyntaxError"
                      "TypeError" "URIError" "Test262Error"))
        (ctor name
              (let ((n name))
                (lambda (this args)
                  (let ((obj (if (js-obj-p this) this (make-js-obj :proto obj-proto))))
                    (setf (gethash "name" (js-obj-props obj)) n)
                    (setf (gethash "message" (js-obj-props obj))
                          (if args (js-to-string (first args)) ""))
                    obj)))
              (make-js-obj :proto obj-proto)))
      (fn "isNaN" (lambda (this args)
                    (declare (ignore this))
                    (if (eq (js-to-number (first args)) :nan) :true :false)))
      (fn "isFinite" (lambda (this args)
                       (declare (ignore this))
                       (let ((n (js-to-number (first args))))
                         (if (and (numberp n) (not (sb-ext:float-infinity-p n))) :true :false))))
      (fn "parseInt" (lambda (this args)
                       (declare (ignore this))
                       (let* ((s (string-left-trim " " (js-to-string (or (first args) ""))))
                              (radix (if (and (second args) (not (eq (second args) :undefined)))
                                         (round (js-to-number (second args)))
                                         10))
                              (n (ignore-errors (parse-integer s :radix radix :junk-allowed t))))
                         (if n (float n 1d0) :nan))))
      (fn "parseFloat" (lambda (this args)
                         (declare (ignore this))
                         (let ((n (ignore-errors (float (read-from-string (js-to-string (or (first args) ""))) 1d0))))
                           (if (numberp n) n :nan))))
      (fn "eval" (lambda (this args)
                   (declare (ignore this))
                   (if (stringp (first args))
                       (js-run-source (first args) env)
                       (or (first args) :undefined))))
      (let ((math (make-js-obj :proto obj-proto)))
        (setf (gethash "PI" (js-obj-props math)) pi)
        (setf (gethash "E" (js-obj-props math)) (exp 1d0))
        (setf (gethash "abs" (js-obj-props math))
              (js-host "abs" (lambda (this args)
                               (declare (ignore this))
                               (let ((n (js-to-number (first args))))
                                 (if (numberp n) (abs n) :nan)))))
        (setf (gethash "floor" (js-obj-props math))
              (js-host "floor" (lambda (this args)
                                 (declare (ignore this))
                                 (let ((n (js-to-number (first args))))
                                   (if (numberp n) (float (floor n) 1d0) n)))))
        (setf (gethash "ceil" (js-obj-props math))
              (js-host "ceil" (lambda (this args)
                                (declare (ignore this))
                                (let ((n (js-to-number (first args))))
                                  (if (numberp n) (float (ceiling n) 1d0) n)))))
        (setf (gethash "round" (js-obj-props math))
              (js-host "round" (lambda (this args)
                                 (declare (ignore this))
                                 (let ((n (js-to-number (first args))))
                                   (if (numberp n) (float (round n) 1d0) n)))))
        (setf (gethash "max" (js-obj-props math))
              (js-host "max" (lambda (this args)
                               (declare (ignore this))
                               (if args (reduce #'max (mapcar #'js-to-number args)) sb-ext:double-float-negative-infinity))))
        (setf (gethash "min" (js-obj-props math))
              (js-host "min" (lambda (this args)
                               (declare (ignore this))
                               (if args (reduce #'min (mapcar #'js-to-number args)) sb-ext:double-float-positive-infinity))))
        (setf (gethash "pow" (js-obj-props math))
              (js-host "pow" (lambda (this args)
                               (declare (ignore this))
                               (let ((a (js-to-number (first args))) (b (js-to-number (second args))))
                                 (if (and (numberp a) (numberp b)) (expt a b) :nan)))))
        (setf (gethash "sqrt" (js-obj-props math))
              (js-host "sqrt" (lambda (this args)
                                (declare (ignore this))
                                (let ((n (js-to-number (first args))))
                                  (if (and (numberp n) (>= n 0)) (sqrt n) :nan)))))
        (env-define env "Math" math)))
    env))

(defun js-global-environment (doc)
  (let ((env (make-js-env))
        (document (and doc (js-make-document doc)))
        (global (make-js-obj)))
    (setf *js-document* doc)
    (env-define env "this" global)
    (when document (env-define env "document" document))
    (env-define env "location" (make-js-obj :host (make-js-location :href (or *document-base* ""))))
    (env-define env "console" (js-make-console))
    (env-define env "undefined" :undefined)
    (env-define env "NaN" :nan)
    (env-define env "Infinity" sb-ext:double-float-positive-infinity)
    (js-install-builtins env)
    env))

(defun js-run-source (source env)
  (let ((program (js-parse source)))
    (js-exec-program program env)))

(defun fetch-script (url)
  "Load a classic script in Lisp. Relative URLs use the document base."
  (let* ((abs (or (resolve-url url *document-base*) url))
         (text (fetch-css-text abs)))
    (when (and text (plusp (length text)))
      text)))

(defun js-execute-document (doc)
  "Run every classic script in document order. Failures in one script are recorded and skipped."
  (let ((*js-log* nil)
        (env (js-global-environment doc))
        (errors nil))
    (labels ((walk (node)
               (dolist (c (dom-node-children node))
                 (when (dom-element-p c)
                   (when (string= (dom-element-tag c) "script")
                     (let* ((typ (dom-attr c "type"))
                            (src (dom-attr c "src"))
                            (code (cond
                                    ((and typ (not (member typ '("" "text/javascript" "application/javascript")
                                                           :test #'string-equal)))
                                     nil)
                                    ((and src (plusp (length src)))
                                     (fetch-script src))
                                    (t (dom-text-content c)))))
                       (when (and code (plusp (length (string-trim '(#\space #\newline #\tab) code))))
                         (handler-case (js-run-source code env)
                           (js-error (e) (push (js-error-message e) errors))
                           (error (e) (push (princ-to-string e) errors))))))
                   (walk c)))))
      (walk doc))
    (values env (nreverse errors) (nreverse *js-log*))))
