;;; Layout: block, inline, flex, grid, table, float, and positioned boxes.

(in-package :closure.engine)

(defstruct box
  (kind :block)
  element
  style
  (id nil)
  (tag nil)
  (x 0d0) (y 0d0) (w 0d0) (h 0d0)
  (advance nil)
  (text nil)
  (children nil)
  (baseline 0d0)
  (marker nil)
  (marker-inside nil)
  (sticky-top nil)
  (collapsed-top 0d0)
  (collapsed-bottom 0d0))

(defun pad4 (style avail)
  (values (px (computed-pt style) avail)
          (px (computed-pr style) avail)
          (px (computed-pb style) avail)
          (px (computed-pl style) avail)))

(defun border4 (style)
  (values (used-border-width (computed-bt style) (computed-bts style))
          (used-border-width (computed-br style) (computed-brs style))
          (used-border-width (computed-bb style) (computed-bbs style))
          (used-border-width (computed-bl style) (computed-bls style))))

(defun px (value container)
  (or (resolve-px value container) 0d0))

(defun definite-length (value container)
  (resolve-px value container))

(defun inline-level-p (node)
  (or (dom-text-p node)
      (and (dom-element-p node)
           (member (computed-display (dom-element-style node))
                   '(:inline :inline-block :inline-flex :inline-grid :inline-table)))))

(defun flow-nodes (element)
  (let ((out nil))
    (labels ((add-generated (text style)
               (when (and text (not (string= text "")))
                 (push (list :gen text style) out)))
             (walk (nodes)
               (dolist (c nodes)
                 (cond
                   ((dom-text-p c) (push c out))
                   ((not (dom-element-p c)))
                   ((eq (computed-display (dom-element-style c)) :none))
                   ((eq (computed-display (dom-element-style c)) :contents)
                    (walk (dom-node-children c)))
                   (t (push c out))))))
      (add-generated (generated-text (dom-element-before-style element) element)
                     (dom-element-before-style element))
      (walk (dom-node-children element))
      (add-generated (generated-text (dom-element-after-style element) element)
                     (dom-element-after-style element))
      (nreverse out))))

(defun replaced-p (el)
  (and (dom-element-p el)
       (member (dom-element-tag el) '("img" "video" "canvas" "audio" "svg" "input" "iframe")
               :test #'string=)))

(defun attr-px (el name)
  (let ((a (and (dom-element-p el) (dom-attr el name))))
    (when (and a (plusp (length a)))
      (let ((n (ignore-errors (parse-integer a :junk-allowed t))))
        (when n (float n 1d0))))))

(defun apply-svg-size (box el avail-w avail-h)
  "Size an svg from its width and height attributes when CSS leaves them auto."
  (let* ((style (box-style box))
         (aw (attr-px el "width"))
         (ah (attr-px el "height")))
    (when (or aw ah)
      (multiple-value-bind (bt br bb bl) (border4 style)
        (multiple-value-bind (pt pr pb pl) (pad4 style avail-w)
          (let* ((extra-w (+ bl br pl pr))
                 (extra-h (+ bt bb pt pb))
                 (css-w (definite-length (computed-width style) avail-w))
                 (css-h (definite-length (computed-height style) avail-h))
                 (cw (or css-w aw ah 0d0))
                 (ch (or css-h ah aw 0d0)))
            (when (and css-w (not css-h) aw ah (> aw 0d0))
              (setf ch (* css-w (/ ah aw))))
            (when (and css-h (not css-w) aw ah (> ah 0d0))
              (setf cw (* css-h (/ aw ah))))
            (setf (box-w box) (+ cw extra-w)
                  (box-h box) (+ ch extra-h))))))))

(defun apply-image-size (box el avail-w avail-h)
  "Size an img from CSS, then HTML width/height, then the file's intrinsic pixels.
A replaced image does not stretch to the container the way an ordinary block does."
  (let* ((style (box-style box))
         (path (image-pathname (dom-attr el "src")))
         (attr-w (attr-px el "width"))
         (attr-h (attr-px el "height")))
    (multiple-value-bind (iw ih) (and path (image-intrinsic-size path))
      (let ((spec-w (definite-length (computed-width style) avail-w))
            (spec-h (definite-length (computed-height style) avail-h)))
        (unless (or iw ih attr-w attr-h spec-w spec-h)
          (let ((alt (dom-attr el "alt")))
            (when (and alt (plusp (length alt)))
              (setf (box-w box) (text-advance alt
                                              (computed-font-size style)
                                              (computed-font-family style)
                                              (computed-font-weight style)
                                              (computed-font-style style))
                    (box-h box) (used-line-height style)
                    (box-text box) alt)))
          (return-from apply-image-size nil))
        (multiple-value-bind (bt br bb bl) (border4 style)
          (multiple-value-bind (pt pr pb pl) (pad4 style avail-w)
            (let* ((extra-w (+ bl br pl pr))
                   (extra-h (+ bt bb pt pb))
                   (border-box (eq (computed-box-sizing style) :border-box))
                   (cw spec-w)
                   (ch spec-h)
                   (css-ratio (computed-aspect-ratio style))
                   (ratio (cond
                            ((and (numberp css-ratio) (> css-ratio 0d0))
                             (/ 1d0 css-ratio))
                            ((and iw ih (> iw 0d0) (> ih 0d0))
                             (/ ih iw)))))
              (when (and cw border-box) (setf cw (max 0d0 (- cw extra-w))))
              (when (and ch border-box) (setf ch (max 0d0 (- ch extra-h))))
              (cond
                ((and cw ch))
                (cw (setf ch (cond (attr-h attr-h)
                                   (ratio (* cw ratio))
                                   (ih ih)
                                   (t cw))))
                (ch (setf cw (cond (attr-w attr-w)
                                   (ratio (/ ch ratio))
                                   (iw iw)
                                   (t ch))))
                (t (setf cw (or attr-w iw 0d0)
                         ch (or attr-h ih 0d0))
                   (when (and attr-w (not attr-h) ratio)
                     (setf ch (* attr-w ratio)))
                   (when (and attr-h (not attr-w) ratio)
                     (setf cw (/ attr-h ratio)))))
              (setf (box-w box) (+ (or cw 0d0) extra-w)
                    (box-h box) (+ (or ch 0d0) extra-h)))))))))

(defun make-element-box (el kind style)
  (make-box :kind kind
            :element el
            :style style
            :id (and (dom-element-p el) (dom-element-id el))
            :tag (and (dom-element-p el) (dom-element-tag el))))

(defun solve-width (style avail)
  "Return (values border-box-width margin-left margin-right content-width)."
  (multiple-value-bind (bt br bb bl) (border4 style)
    (declare (ignore bt bb))
    (multiple-value-bind (pt pr pb pl) (pad4 style avail)
      (declare (ignore pt pb))
      (let* ((extra (+ bl br pl pr))
             (ml (computed-ml style))
             (mr (computed-mr style))
             (mlv (if (eq ml :auto) nil (definite-length ml avail)))
             (mrv (if (eq mr :auto) nil (definite-length mr avail)))
             (specified (definite-length (computed-width style) avail)))
        (cond
          ((null specified)
           (let ((ml* (or mlv 0d0)) (mr* (or mrv 0d0)))
             (let ((bw (max 0d0 (- avail ml* mr*))))
               (values bw ml* mr* (max 0d0 (- bw extra))))))
          (t
           (let* ((bw (if (eq (computed-box-sizing style) :border-box)
                          specified
                          (+ specified extra)))
                  (ml* mlv)
                  (mr* mrv))
             (cond
               ((and (null ml*) (null mr*))
                (let ((free (- avail bw)))
                  (setf ml* (/ (max 0d0 free) 2d0)
                        mr* (- (max 0d0 free) ml*))))
               ((null ml*) (setf ml* (max 0d0 (- avail bw (or mr* 0d0)))))
               ((null mr*) (setf mr* (- avail bw ml*)))
               (t (setf mr* (- avail bw ml*))))
             (values (max 0d0 bw) (or ml* 0d0) (or mr* 0d0) (max 0d0 (- bw extra))))))))))

(defun clamp-size (size min-v max-v)
  (let ((s size))
    (when (numberp min-v) (setf s (max s min-v)))
    (when (numberp max-v) (setf s (min s max-v)))
    s))

(defun layout-element (el x y avail-w avail-h containing &key shrink)
  (let* ((style (dom-element-style el))
         (disp (computed-display style)))
    (cond
      ((eq disp :none) nil)
      ((member disp '(:flex :inline-flex))
       (layout-flex el x y avail-w avail-h containing))
      ((member disp '(:grid :inline-grid))
       (layout-grid el x y avail-w avail-h containing))
      ((or (eq disp :table) (eq disp :inline-table) (string= (dom-element-tag el) "table"))
       (layout-table el x y avail-w avail-h containing))
      ((eq disp :inline)
       (layout-inline-element el x y avail-w))
      (t
       (layout-block el x y avail-w avail-h containing :shrink (or shrink (eq disp :inline-block)))))))

(defun layout-block (el x y avail-w avail-h containing &key shrink)
  (let* ((style (dom-element-style el))
         (box (make-element-box el :block style)))
    (multiple-value-bind (bw ml mr cw) (solve-width style avail-w)
      (let* ((min-w (definite-length (computed-min-width style) avail-w))
             (max-w (definite-length (computed-max-width style) avail-w))
             (bw (clamp-size bw (or min-w 0d0) max-w)))
        (multiple-value-bind (bt br bb bl) (border4 style)
          (multiple-value-bind (pt pr pb pl) (pad4 style avail-w)
            (setf cw (max 0d0 (- bw bl br pl pr)))
            (let ((ratio (computed-aspect-ratio style))
                  (specified-h (definite-length (computed-height style) avail-h)))
              (when (and (eq (computed-width style) :auto)
                         (numberp ratio) (> ratio 0d0)
                         (numberp specified-h) (> specified-h 0d0))
                (let ((content-h (if (eq (computed-box-sizing style) :border-box)
                                     (max 0d0 (- specified-h pt pb bt bb))
                                     specified-h)))
                  (setf cw (* content-h ratio)
                        bw (+ cw bl br pl pr)))))
            (setf (box-x box) (+ x ml)
                  (box-y box) y
                  (box-w box) bw)
            (let* ((pos (computed-position style))
                   (cont (if (member pos '(:relative :absolute :fixed :sticky)) box containing))
                   (content-x (+ (box-x box) bl pl))
                   (flow-y 0d0)
                   (kids nil)
                   (pending nil)
                   (abs nil)
                   (float-clear 0d0)
                   (float-right 0d0)
                   (float-avoid 0d0)
                   (open-margin 0d0)
                   (flow-started nil)
                   (child-h (unless (eq (computed-height style) :auto)
                              (definite-length (computed-height style) avail-h))))
              (labels ((consume-margin ()
                         (when (> open-margin 0d0)
                           (incf flow-y open-margin)
                           (setf open-margin 0d0)))
                       (flush-inline ()
                         (when pending
                           (setf flow-started t)
                           (consume-margin)
                           (let* ((beside (and (< flow-y float-clear)
                                                     (or (> float-right content-x) (> float-avoid 0d0))))
                                  (line-box (layout-inline-run (nreverse pending) content-x
                                                               (+ (box-y box) bt pt flow-y)
                                                               cw style
                                                               :float-inset (if beside
                                                                                (max 0d0 (- float-right content-x))
                                                                                0d0)
                                                               :float-avoid (if beside float-avoid 0d0)
                                                               :float-span (if beside
                                                                               (max 0d0 (- float-clear flow-y))
                                                                               0d0))))
                             (when line-box
                               (incf flow-y (box-h line-box))
                               (push line-box kids)))
                           (setf pending nil)))
                       (take (node)
                         (cond
                           ((and (consp node) (eq (car node) :gen))
                            (push node pending))
                           ((dom-text-p node)
                            ;; A whitespace-only node between blocks is discarded.
                            ;; Between inlines it is the space that separates them.
                            (unless (and (whitespace-only-p (dom-text-text node))
                                         (not (member (computed-white-space style) '(:pre :pre-wrap :break-spaces)))
                                         (not pending))
                              (push node pending)))
                           ((dom-element-p node)
                            (let ((cs (dom-element-style node)))
                              (cond
                                ((member (computed-position cs) '(:absolute :fixed))
                                 (flush-inline)
                                 (push node abs))
                                ((member (computed-float cs) '(:left :right))
                                 (flush-inline)
                                 (consume-margin)
                                 (let ((fb (layout-element node content-x
                                                           (+ (box-y box) bt pt flow-y)
                                                           cw child-h cont :shrink t)))
                                   (when fb
                                     (cond
                                       ((eq (computed-float cs) :right)
                                        (setf (box-x fb) (- (+ content-x cw) (box-w fb))
                                              float-avoid (box-w fb)))
                                       (t
                                        (setf (box-x fb) content-x
                                              float-right (+ content-x (box-w fb)))))
                                     (push fb kids)
                                     (setf flow-started t)
                                     (setf float-clear (max float-clear
                                                            (- (+ (box-y fb) (box-h fb))
                                                               (+ (box-y box) bt pt)))))))
                                ((inline-level-p node)
                                 (push node pending))
                                (t
                                 (flush-inline)
                                 (setf flow-y (max flow-y float-clear))
                                 (when (member (computed-clear cs) '(:left :right :both))
                                   (setf flow-y (max flow-y float-clear)))
                                 (let ((cb (layout-element node content-x
                                                           (+ (box-y box) bt pt flow-y)
                                                           cw child-h cont)))
                                   (when cb
                                     (let* ((mt (px (computed-mt (dom-element-style node)) cw))
                                            (mb (max (px (computed-mb (dom-element-style node)) cw)
                                                     (box-collapsed-bottom cb)))
                                            (through (box-collapsed-top cb))
                                            (collapse (and (not flow-started)
                                                           (<= pt 0d0) (<= bt 0d0)))
                                            (used (if collapse 0d0 (max mt through)))
                                            (gap (max open-margin used)))
                                       (setf (box-y cb) (+ (box-y cb) gap))
                                       (dolist (k (box-children cb))
                                         (translate-box k 0d0 gap))
                                       (when collapse
                                         (setf (box-collapsed-top box)
                                               (max (box-collapsed-top box) (max mt through))))
                                       (setf open-margin mb
                                             flow-started t)
                                       (incf flow-y (+ gap (box-h cb)))
                                       (push cb kids)))))))))))
                (unless (member (dom-element-tag el) '("svg" "input" "select" "textarea")
                                :test #'string=)
                  (dolist (n (flow-nodes el)) (take n)))
                (flush-inline)
                (if (and (eq (computed-height style) :auto)
                         (<= pb 0d0)
                         (<= bb 0d0)
                         (> open-margin 0d0))
                    (setf (box-collapsed-bottom box) open-margin)
                    (consume-margin))
                (setf flow-y (max flow-y float-clear))
                (let* ((specified-h (definite-length (computed-height style) avail-h))
                       (content-h (if specified-h
                                      (if (eq (computed-box-sizing style) :border-box)
                                          (max 0d0 (- specified-h pt pb bt bb))
                                          specified-h)
                                      flow-y))
                       (ratio (computed-aspect-ratio style))
                       (content-h (if (and (null specified-h)
                                           (numberp ratio) (> ratio 0d0) (> cw 0d0))
                                      (max content-h (/ cw ratio))
                                      content-h))
                       (min-h (definite-length (computed-min-height style) avail-h))
                       (max-h (definite-length (computed-max-height style) avail-h)))
                  (setf content-h (clamp-size content-h (or min-h 0d0) max-h))
                  (when (and shrink (eq (computed-width style) :auto) kids)
                    (let ((need (reduce #'max kids
                                        :key (lambda (k) (max 0d0 (- (+ (box-x k) (box-w k)) content-x)))
                                        :initial-value 0d0)))
                      (setf cw (min cw need))
                      (setf (box-w box) (+ cw bl br pl pr))))
                  (setf (box-h box) (+ content-h bt bb pt pb))
                  (when (eq pos :relative)
                    (let ((dx (px (computed-left style) avail-w))
                          (dy (px (computed-top style) (or avail-h 0d0))))
                      (incf (box-x box) dx)
                      (incf (box-y box) dy)
                      (dolist (k kids)
                        (translate-box k dx dy))))
                  (when (and (eq pos :sticky) (not (eq (computed-top style) :auto)))
                    (setf (box-sticky-top box) (px (computed-top style) (or avail-h 0d0))))
                  (dolist (a (nreverse abs))
                    (let ((ab (layout-absolute a box content-x (+ (box-y box) bt pt) cw content-h)))
                      (when ab (push ab kids))))
                  (when (and (numberp (computed-column-count style))
                             (> (computed-column-count style) 1)
                             kids)
                    (pack-columns box kids cw content-h))
                  (setf (box-children box) (nreverse kids))
                  (when (eq (computed-display style) :list-item)
                    (let ((marker (list-item-marker el style)))
                      (setf (box-marker box) marker)
                      (when (and (eq (computed-list-style-position style) :inside)
                                 (not (eq marker :none)))
                        (setf (box-marker-inside box) t)
                        (let ((first (car (box-children box)))
                              (dx (if (stringp marker)
                                      (+ (text-advance marker
                                                       (computed-font-size style)
                                                       (computed-font-family style)
                                                       (computed-font-weight style)
                                                       (computed-font-style style))
                                         6d0)
                                      16d0)))
                          (when first (translate-box first dx 0d0))))))
                  (when (string= (dom-element-tag el) "img")
                    (apply-image-size box el avail-w avail-h))
                  (when (string= (dom-element-tag el) "svg")
                    (apply-svg-size box el avail-w avail-h))
                  (when (and (string= (dom-element-tag el) "input")
                             (member (string-downcase (or (dom-attr el "type") "text"))
                                     '("checkbox" "radio") :test #'string=))
                    (setf (box-w box) 16d0
                          (box-h box) 16d0))
                  (when (and (string= (dom-element-tag el) "button")
                             (eq (computed-width style) :auto))
                    (let ((adv (text-advance (dom-text-content el)
                                             (computed-font-size style)
                                             (computed-font-family style)
                                             (computed-font-weight style)
                                             (computed-font-style style))))
                      (multiple-value-bind (bt br bb bl) (border4 style)
                        (declare (ignore bt bb))
                        (multiple-value-bind (pt pr pb pl) (pad4 style avail-w)
                          (declare (ignore pt pb))
                          (setf (box-w box) (+ adv bl br pl pr))))))
          box)))))))))

(defun pack-columns (box kids cw content-h)
  (declare (ignore content-h))
  (let* ((n (computed-column-count (box-style box)))
         (gap (computed-column-gap (box-style box)))
         (col-w (max 1d0 (/ (- cw (* gap (1- n))) n)))
         (total (reduce #'+ kids :key #'box-h :initial-value 0d0))
         (target (max 1d0 (/ total n)))
         (col 0) (y 0d0) (max-h 0d0))
    (dolist (k kids)
      (when (and (> y 0d0) (> (+ y (box-h k)) target) (< col (1- n)))
        (incf col)
        (setf y 0d0))
      (setf (box-x k) (+ (box-x box) (* col (+ col-w gap)))
            (box-y k) (+ (box-y k) (- y (box-y k)) y))
      ;; place relative to the column top, which is the box content top
      (setf (box-y k) (+ (- (box-y box) (box-y box)) (box-y box) y))
      (incf y (box-h k))
      (setf max-h (max max-h y)))
    (setf (box-h box) (max (box-h box) max-h))))

(defun transform-text (text transform)
  "Apply text-transform. NONE and an empty string stay as they are."
  (cond
    ((or (null text) (zerop (length text))) text)
    ((eq transform :uppercase) (string-upcase text))
    ((eq transform :lowercase) (string-downcase text))
    ((eq transform :capitalize)
     (concatenate 'string
                  (string-upcase (subseq text 0 1))
                  (string-downcase (subseq text 1))))
    (t text)))

(defun spaced-advance (text size family weight fstyle spacing)
  "Advance of TEXT plus letter-spacing between its characters."
  (let ((base (text-advance text size family weight fstyle))
        (gap (if (and (numberp spacing) (> (length text) 1))
                 (* (float spacing 1d0) (1- (length text)))
                 0d0)))
    (+ base gap)))

(defun spaced-cursor (text size family weight fstyle spacing)
  "Pen movement to the next glyph, plus letter-spacing."
  (let ((base (text-cursor text size family weight fstyle))
        (gap (if (and (numberp spacing) (> (length text) 1))
                 (* (float spacing 1d0) (1- (length text)))
                 0d0)))
    (+ base gap)))

(defun box-step (box)
  "How far the next item starts after BOX. The border box can extend past it."
  (let ((a (box-advance box)))
    (if (numberp a) a (box-w box))))

(defun used-text-indent (style width)
  "Pixels to shift the first line. A percentage is of WIDTH."
  (let ((v (and style (computed-text-indent style))))
    (cond
      ((numberp v) (float v 1d0))
      ((and (consp v) (eq (car v) :%))
       (* 0.01d0 (float (cdr v) 1d0) (float (or width 0d0) 1d0)))
      (t 0d0))))

(defun ellipsis-run-p (style)
  (and style
       (eq (computed-text-overflow style) :ellipsis)
       (member (computed-white-space style) '(:nowrap :pre))
       (member (computed-overflow style) '(:hidden :clip :scroll :auto))))

(defun fit-ellipsis (text style limit)
  "Shorten TEXT so it and an ellipsis fit in LIMIT pixels."
  (let* ((fs (computed-font-size style))
         (fam (computed-font-family style))
         (wt (computed-font-weight style))
         (fst (computed-font-style style))
         (spacing (computed-letter-spacing style))
         (ell (string #\…))
         (measure (lambda (s) (spaced-advance s fs fam wt fst spacing))))
    (cond
      ((<= (funcall measure text) limit) text)
      (t
       (let ((best ell))
         (loop for i from 1 below (length text)
               for prefix = (concatenate 'string (subseq text 0 i) ell)
               while (<= (funcall measure prefix) limit)
               do (setf best prefix))
         best)))))

(defun break-all-p (style)
  (and style
       (eq (computed-word-break style) :break-all)
       (not (member (computed-white-space style) '(:nowrap :pre)))))

(defun fit-prefix (text style limit)
  "Longest prefix of TEXT that fits in LIMIT. One character stays whole."
  (let* ((fs (computed-font-size style))
         (fam (computed-font-family style))
         (wt (computed-font-weight style))
         (fst (computed-font-style style))
         (spacing (computed-letter-spacing style))
         (measure (lambda (s) (spaced-advance s fs fam wt fst spacing))))
    (if (or (<= (length text) 1)
            (<= (funcall measure text) limit))
        text
        (let ((end 1))
          (loop while (and (< end (length text))
                           (<= (funcall measure (subseq text 0 (1+ end))) limit))
                do (incf end))
          (subseq text 0 end)))))

(defun break-word-p (style)
  (and style
       (member (computed-overflow-wrap style) '(:break-word :anywhere))
       (not (member (computed-white-space style) '(:nowrap :pre)))))

(defun split-to-width (text style limit)
  "Split TEXT into pieces that each fit in LIMIT. A single character always stays whole."
  (let* ((fs (computed-font-size style))
         (fam (computed-font-family style))
         (wt (computed-font-weight style))
         (fst (computed-font-style style))
         (spacing (computed-letter-spacing style))
         (measure (lambda (s) (spaced-advance s fs fam wt fst spacing)))
         (parts nil)
         (start 0))
    (loop while (< start (length text))
          do (let ((end (1+ start)))
               (loop while (and (< end (length text))
                                (<= (funcall measure (subseq text start (1+ end))) limit))
                     do (incf end))
               (push (subseq text start end) parts)
               (setf start end)))
    (nreverse parts)))

(defun baseline-shift (em divisor)
  "Sub and super shift. A browser divides the parent size in 1/64px units,
then adds one pixel: size/5 for sub, size/3 for super."
  (float (+ (/ (floor (* em 64d0) divisor) 64d0) 1d0) 1d0))

(defun layout-inline-run (nodes x y width style &key (float-inset 0d0) (float-avoid 0d0) (float-span 0d0))
  (let ((font (computed-font-size style))
        (family (computed-font-family style))
        (weight (computed-font-weight style))
        (fstyle (computed-font-style style))
        (lh (used-line-height style))
        (white (computed-white-space style))
        (lines nil)
        (current nil)
        (current-w 0d0)
        (previous nil)
        (line-y 0d0)
        (ellipsized nil)
        (wrap-limit (max 1d0 (- width
                                (max 0d0 (used-text-indent style width))
                                (if (and (> float-span 0d0)
                                         (or (> float-inset 0d0) (> float-avoid 0d0)))
                                    (+ float-inset float-avoid)
                                    0d0)))))
    (labels (             (break-line ()
               (push (nreverse current) lines)
               (incf line-y lh)
               (setf current nil current-w 0d0 previous nil
                     wrap-limit (max 1d0 (- width
                                            (if (and (< line-y float-span)
                                                     (or (> float-inset 0d0) (> float-avoid 0d0)))
                                                (+ float-inset float-avoid)
                                                0d0)))))
             (keeps-together (st)
               "nowrap and pre glue to the previous run of the same kind."
               (and previous st
                    (member (computed-white-space previous) '(:nowrap :pre))
                    (member (computed-white-space st) '(:nowrap :pre))))
             (emit-word (text st &optional element)
               (when ellipsized
                 (return-from emit-word nil))
               (let ((use (or st style)))
                 (when (and (break-all-p use)
                            (not (member white '(:nowrap :pre)))
                            (> (length text) 1))
                   (let* ((shown (transform-text text (computed-text-transform use)))
                          (fs (computed-font-size use))
                          (fam (computed-font-family use))
                          (wt (computed-font-weight use))
                          (fst (computed-font-style use))
                          (spacing (computed-letter-spacing use))
                          (adv (spaced-advance shown fs fam wt fst spacing)))
                     (when (> (+ current-w adv) wrap-limit)
                       (let ((rest shown))
                         (loop while (plusp (length rest))
                               do (let ((room (if (> current-w 0d0)
                                                  (- wrap-limit current-w)
                                                  wrap-limit)))
                                    (when (and (> current-w 0d0)
                                               (or (<= room 0d0)
                                                   (> (spaced-advance (subseq rest 0 1)
                                                                      fs fam wt fst spacing)
                                                      room)))
                                      (break-line)
                                      (setf room wrap-limit))
                                    (let ((prefix (fit-prefix rest use (max 1d0 room))))
                                      (emit-word prefix st element)
                                      (setf rest (subseq rest (length prefix)))))))
                       (return-from emit-word nil))))
                 (when (and (break-word-p use)
                            (not (member white '(:nowrap :pre)))
                            (> (length text) 1))
                   (let* ((shown (transform-text text (computed-text-transform use)))
                          (adv (spaced-advance shown
                                               (computed-font-size use)
                                               (computed-font-family use)
                                               (computed-font-weight use)
                                               (computed-font-style use)
                                               (computed-letter-spacing use))))
                     (when (> adv wrap-limit)
                       (when (> current-w 0d0)
                         (break-line))
                       (dolist (part (split-to-width shown use (max 1d0 wrap-limit)))
                         (when (> current-w 0d0)
                           (break-line))
                         (emit-word part st element))
                       (return-from emit-word nil)))))
               (let* ((use (or st style))
                      (shown (transform-text text (computed-text-transform use)))
                      (fs (computed-font-size use))
                      (fam (computed-font-family use))
                      (wt (computed-font-weight use))
                      (fst (computed-font-style use))
                      (gap (if (and (string= shown " ")
                                   (numberp (computed-word-spacing use)))
                              (computed-word-spacing use)
                              0d0))
                      (adv (+ (spaced-advance shown fs fam wt fst (computed-letter-spacing use))
                              gap))
                      (step (+ (spaced-cursor shown fs fam wt fst (computed-letter-spacing use))
                               gap)))
                 (when (and (ellipsis-run-p use)
                            (> (+ current-w adv) wrap-limit))
                   (setf shown (fit-ellipsis shown use (max 0d0 (- wrap-limit current-w)))
                         adv (spaced-advance shown fs fam wt fst (computed-letter-spacing use))
                         ellipsized t))
                 (let* ((asc (font-ascent fs fam wt fst))
                        (desc (font-descent fs fam wt fst))
                        (tb (make-box :kind :text :style use :text shown
                                      :element element
                                      :tag (and (dom-element-p element) (dom-element-tag element))
                                      :id (and (dom-element-p element) (dom-element-id element))
                                      :w adv :advance step :h (+ asc desc) :baseline asc)))
                   (let ((k 0d0))
                     (when (and current (plusp (length shown)))
                       (let* ((prev (car current))
                              (pt (box-text prev)))
                         (when (and pt (plusp (length pt)))
                           (let ((pst (or (box-style prev) style)))
                             (setf k (snap-layout-unit
                                      (pair-kern (char pt (1- (length pt)))
                                                 (char shown 0)
                                                 (computed-font-size pst)
                                                 (computed-font-family pst)
                                                 (computed-font-weight pst)
                                                 (computed-font-style pst))))))))
                     (when (and (> current-w 0d0) (> (+ current-w k adv) wrap-limit)
                                (not (member white '(:nowrap :pre)))
                                (not (keeps-together use)))
                       (break-line)
                       (setf k 0d0)
                       ;; A collapsible space that does not fit ends the line.
                       ;; It must not become a blank line of its own.
                       (when (string= shown " ")
                         (return-from emit-word nil)))
                     (when (and current (not (zerop k)))
                       (incf (box-w (car current)) k)
                       (when (numberp (box-advance (car current)))
                         (incf (box-advance (car current)) k))
                       (incf current-w k)))
                   (push tb current)
                   (incf current-w step)
                   (setf previous use))))
             (emit-atomic (el)
               (let ((b (layout-element el 0d0 0d0 width nil nil :shrink t)))
                 (when b
                   (when (zerop (box-baseline b))
                     (setf (box-baseline b) (box-h b)))
                   (when (and (> current-w 0d0) (> (+ current-w (box-w b)) wrap-limit)
                              (not (member white '(:nowrap :pre)))
                              (not (keeps-together (dom-element-style el))))
                     (break-line))
                   (push b current)
                   (incf current-w (box-w b))
                   (setf previous (dom-element-style el)))))
             (feed-words (text st &optional element)
               (let* ((lead (and (plusp (length text))
                                 (whitespace-char-p (char text 0))))
                      (trail (and (plusp (length text))
                                  (whitespace-char-p (char text (1- (length text))))))
                      (words (split-ws (collapse-space text))))
                 (when (and lead (or words trail) (> current-w 0d0))
                   (emit-word " " st element))
                 (loop for w in words
                       for first = t then nil
                       do (unless first (emit-word " " st element))
                          (when (plusp (length w)) (emit-word w st element)))
                 (when (and trail words)
                   (emit-word " " st element))))
             (feed-lines (text st collapse &optional element)
               (let ((parts (split-lines text)))
                 (loop for line in parts
                       for more = (cdr parts) then (cdr more)
                       do (if collapse
                              (feed-words line st element)
                              (when (plusp (length line)) (emit-word line st element)))
                          (when more (break-line)))))
             (feed-inline (nodes st element)
               "Lay out inline descendants, keeping each element's own font."
               (dolist (n nodes)
                 (cond
                   ((and (consp n) (eq (car n) :gen))
                    (feed-words (second n) (or (third n) st)))
                   ((dom-text-p n)
                    (cond
                      ((member white '(:pre :pre-wrap :break-spaces))
                       (feed-lines (dom-text-text n) st nil element))
                      ((eq white :pre-line)
                       (feed-lines (dom-text-text n) st t element))
                      (t (feed-words (dom-text-text n) st element))))
                   ((dom-element-p n)
                    (cond
                      ((eq (computed-display (dom-element-style n)) :none))
                      ((string= (dom-element-tag n) "br")
                       (break-line))
                      ((string= (dom-element-tag n) "wbr"))
                      ((eq (computed-display (dom-element-style n)) :contents)
                       (feed-inline (dom-node-children n) st element))
                      ((eq (computed-display (dom-element-style n)) :inline)
                       (let ((before (generated-text (dom-element-before-style n) n))
                             (after (generated-text (dom-element-after-style n) n)))
                         (when before
                           (feed-words before (or (dom-element-before-style n)
                                                  (dom-element-style n))
                                       n))
                         (feed-inline (dom-node-children n) (dom-element-style n) n)
                         (when after
                           (feed-words after (or (dom-element-after-style n)
                                                 (dom-element-style n))
                                       n))))
                      (t (emit-atomic n)))))))
             (align-kind (item)
               (let ((st (or (box-style item) style)))
                 (or (computed-vertical-align st) :baseline)))
             (raw-y (item)
               "Item top relative to the parent baseline. Smaller is higher."
               (let* ((base (if (plusp (box-baseline item)) (box-baseline item) (box-h item)))
                      (em (computed-font-size style)))
                 (case (align-kind item)
                   (:super (- (+ base (baseline-shift em 3))))
                   (:sub (+ (- base) (baseline-shift em 5)))
                   (:middle (- (* -0.25d0 em) (/ (box-h item) 2d0)))
                   (t (- base))))))
      (feed-inline nodes style nil)
      (when current (break-line))
      (setf lines (nreverse lines))
      (when lines
        (let ((line-boxes nil)
              (yy y)
              (parent-asc (font-ascent font family weight fstyle))
              (parent-desc (font-descent font family weight fstyle)))
          (let ((line-i 0))
          (dolist (line lines)
            (let* ((offset (- yy y))
                   (fudge (if (and (> float-span 0d0) (< offset float-span)) float-inset 0d0))
                   (avoid (if (and (> float-span 0d0) (< offset float-span)) float-avoid 0d0))
                   (indent (if (zerop line-i) (used-text-indent style width) 0d0))
                   (used (reduce #'+ line :key #'box-step :initial-value 0d0))
                   (align (computed-text-align style))
                   (slack (max 0d0 (- width fudge avoid indent used)))
                   (justify-extra (if (and (eq align :justify)
                                           (not (eq line (car (last lines)))))
                                      (let* ((last-word (find-if (lambda (item)
                                                                   (and (stringp (box-text item))
                                                                        (not (string= (box-text item) " "))))
                                                                 line :from-end t))
                                             (gaps 0)
                                             (ink 0d0)
                                             (seen nil))
                                        (dolist (item line)
                                          (unless seen
                                            (incf ink (box-w item))
                                            (when (and (stringp (box-text item))
                                                       (string= (box-text item) " "))
                                              (incf gaps))
                                            (when (eq item last-word)
                                              (setf seen t))))
                                        (let ((room (max 0d0 (- width fudge avoid indent ink))))
                                          (if (and (> gaps 0) (> room 0.5d0))
                                              (/ room gaps)
                                              0d0)))
                                      0d0))
                   (xx (+ x fudge indent (cond
                                           ((member align '(:center)) (/ slack 2d0))
                                           ((member align '(:right :end)) slack)
                                           (t 0d0))))
                   (top (- parent-asc))
                   ;; Line gap sits below the descent, so the strut is the
                   ;; full line height, not just the glyphs.
                   (bottom (- lh parent-asc)))
              (incf line-i)
              (dolist (item line)
                (unless (member (align-kind item) '(:top :bottom :text-top :text-bottom))
                  (let* ((ry (raw-y item))
                         (st (or (box-style item) style))
                         ;; The line box includes the item's line gap, which
                         ;; sits below the glyphs.
                         (extent (max (box-h item) (used-line-height st))))
                    (setf top (min top ry)
                          bottom (max bottom (+ ry extent))))))
              (dolist (item line)
                (case (align-kind item)
                  ((:top :text-top)
                   (setf top (min top (if (eq (align-kind item) :text-top) (- parent-asc) top))))
                  ((:bottom :text-bottom)
                   (let ((edge (if (eq (align-kind item) :text-bottom) parent-desc bottom)))
                     (setf bottom (max bottom (+ edge (box-h item))))))))
              (let ((lh-line (max lh (- bottom top)))
                    (lb (make-box :kind :line :style style :x x :y yy :w width)))
                (dolist (item line)
                  (let ((ry (case (align-kind item)
                              (:top top)
                              (:text-top (- parent-asc))
                              (:bottom (- bottom (box-h item)))
                              (:text-bottom (- parent-desc (box-h item)))
                              (t (raw-y item)))))
                    (setf (box-x item) xx
                          (box-y item) (+ yy (- ry top)))
                    (when (and (> justify-extra 0d0)
                               (stringp (box-text item))
                               (string= (box-text item) " "))
                      (if (find-if (lambda (next)
                                     (and (stringp (box-text next))
                                          (not (string= (box-text next) " "))))
                                   (cdr (member item line)))
                          (progn
                            (incf (box-w item) justify-extra)
                            (when (numberp (box-advance item))
                              (incf (box-advance item) justify-extra)))
                          (progn
                            (setf (box-w item) 0d0)
                            (when (numberp (box-advance item))
                              (setf (box-advance item) 0d0)))))
                    (incf xx (box-step item))))
                (setf (box-h lb) lh-line
                      (box-children lb) line)
                (push lb line-boxes)
                (incf yy lh-line)))))
          (make-box :kind :block :style style :x x :y y :w width
                    :h (- yy y) :children (nreverse line-boxes)))))))

(defun split-lines (text)
  (let ((out nil) (start 0))
    (loop for i from 0 below (length text)
          when (char= (char text i) #\newline)
            do (push (subseq text start i) out)
               (setf start (1+ i)))
    (push (subseq text start) out)
    (nreverse out)))

(defun collapse-space (text)
  (let* ((s (substitute #\space #\newline text))
         (s2 (substitute #\space #\tab s)))
    (with-output-to-string (o)
      (let ((sp nil))
        (loop for c across s2 do
          (if (char= c #\space)
              (unless sp (write-char #\space o) (setf sp t))
              (progn (write-char c o) (setf sp nil))))))))

(defun list-item-number (el)
  "1-based index of EL among li siblings, honoring an ol start attribute."
  (let ((parent (dom-node-parent el))
        (start 1)
        (n 0))
    (when (and (dom-element-p parent) (dom-attr parent "start"))
      (let ((v (ignore-errors (parse-integer (dom-attr parent "start") :junk-allowed t))))
        (when v (setf start v))))
    (when (dom-element-p parent)
      (dolist (c (dom-node-children parent))
        (when (and (dom-element-p c) (string= (dom-element-tag c) "li"))
          (incf n)
          (when (eq c el)
            (return-from list-item-number (+ start (1- n)))))))
    start))

(defun list-item-marker (el style)
  "A decimal item is its number. Other markers stay the list-style keyword."
  (cond
    ((eq (computed-list-style style) :none) :none)
    ((eq (computed-list-style style) :decimal)
     (format nil "~D." (list-item-number el)))
    (t (computed-list-style style))))

(defun inline-text (el)
  (with-output-to-string (o)
    (dolist (c (dom-node-children el))
      (when (dom-text-p c) (write-string (dom-text-text c) o)))))

(defun layout-inline-element (el x y avail)
  (let ((b (layout-inline-run (list el) x y avail (dom-element-style el))))
    b))

(defun layout-absolute (el containing cx cy cw ch)
  (declare (ignore cx cy cw ch))
  (let* ((style (dom-element-style el))
         (cbx (if containing (box-x containing) 0d0))
         (cby (if containing (box-y containing) 0d0))
         (cbw (if containing (box-w containing) *viewport-width*))
         (cbh (if containing (box-h containing) *viewport-height*))
         (left (definite-length (computed-left style) cbw))
         (right (definite-length (computed-right style) cbw))
         (top (definite-length (computed-top style) cbh))
         (bottom (definite-length (computed-bottom style) cbh))
         (width (computed-width style)))
    (when (and (eq (computed-position style) :fixed))
      (setf cbx 0d0 cby 0d0 cbw *viewport-width* cbh *viewport-height*))
    (let ((avail (cond
                   ((and left right (eq width :auto)) (max 0d0 (- cbw left right)))
                   (left cbw)
                   (t cbw))))
      (let ((b (layout-block el
                             (+ cbx (or left 0d0))
                             (+ cby (or top 0d0))
                             avail cbh containing)))
        (when (and b left) (setf (box-x b) (+ cbx left)))
        (when (and b right (null left))
          (setf (box-x b) (- (+ cbx cbw right) (box-w b))))
        (when (and b top) (setf (box-y b) (+ cby top)))
        (when (and b bottom (null top))
          (setf (box-y b) (- (+ cby cbh bottom) (box-h b))))
        b))))

(defun flex-items (el)
  (let ((items nil))
    (dolist (n (flow-nodes el))
      (cond
        ((dom-element-p n) (push n items))
        ((dom-text-p n)
         (unless (whitespace-only-p (dom-text-text n))
           (push n items)))
        ((and (consp n) (eq (car n) :gen))
         (push n items))))
    (stable-sort (nreverse items) #'<
                 :key (lambda (n)
                        (if (dom-element-p n)
                            (computed-order (dom-element-style n))
                            0)))))

(defun item-main-base (item row inner-w)
  (if (dom-element-p item)
      (let* ((st (dom-element-style item))
             (basis (computed-flex-basis st))
             (main-prop (if row (computed-width st) (computed-height st))))
        (cond
          ((numberp basis) (float basis 1d0))
          ((and (not (eq basis :auto)) (definite-length basis inner-w))
           (definite-length basis inner-w))
          ((definite-length main-prop inner-w)
           (definite-length main-prop inner-w))
          (t
           (let ((b (layout-element item 0d0 0d0 inner-w nil nil :shrink t)))
             (if b (if row (box-w b) (box-h b)) 0d0)))))
      (text-advance (if (dom-text-p item) (dom-text-text item) (second item))
                    16d0 "sans-serif" :normal :normal)))

(defun flex-line-indexes (bases inner gap)
  "Group item indexes into lines that fit INNER. One item always keeps a line."
  (let ((lines nil)
        (line nil)
        (used 0d0))
    (loop for b in bases
          for i from 0
          do (when (and line (> (+ used gap b) inner))
               (push (nreverse line) lines)
               (setf line nil
                     used 0d0))
             (push i line)
             (incf used (if (cdr line) (+ gap b) b)))
    (when line (push (nreverse line) lines))
    (nreverse lines)))

(defun flex-line-mains (indexes bases grows shrinks inner gap)
  (let* ((bs (mapcar (lambda (i) (float (nth i bases) 1d0)) indexes))
         (gs (mapcar (lambda (i) (nth i grows)) indexes))
         (ss (mapcar (lambda (i) (nth i shrinks)) indexes))
         (n (length indexes))
         (gap-total (if (plusp n) (* gap (1- n)) 0d0))
         (free (- inner (reduce #'+ bs :initial-value 0d0) gap-total))
         (mains (mapcar #'float bs)))
    (cond
      ((and (> free 0d0) (some (lambda (g) (> g 0d0)) gs))
       (let ((sg (reduce #'+ gs :initial-value 0d0)))
         (when (> sg 0d0)
           (loop for i from 0 below n do
             (incf (nth i mains) (* free (/ (nth i gs) sg)))))))
      ((and (< free 0d0) (some (lambda (s) (> s 0d0)) ss))
       (let* ((weighted (loop for b in bs for s in ss collect (* b s)))
              (sw (reduce #'+ weighted :initial-value 0d0)))
         (when (> sw 0d0)
           (loop for i from 0 below n do
             (incf (nth i mains) (* free (/ (nth i weighted) sw))))))))
    (mapcar (lambda (m) (max 0d0 m)) mains)))

(defun place-flex-wrap (box items bases grows shrinks style
                        &key row rev inner gap x y ml bt bb bl br pt pb pl pr bw avail-h cw)
  (let* ((cross-gap (if row (computed-row-gap style) (computed-column-gap style)))
         (lines (flex-line-indexes bases inner gap))
         (lines (if rev (mapcar #'reverse lines) lines))
         (lines (if (eq (computed-flex-wrap style) :wrap-reverse) (reverse lines) lines))
         (specified-h (definite-length (computed-height style) avail-h))
         (cross-definite (when specified-h
                           (if (eq (computed-box-sizing style) :border-box)
                               (max 0d0 (- specified-h pt pb bt bb))
                               specified-h)))
         (cross-cursor 0d0)
         (main-max 0d0)
         (kids nil)
         (groups nil)
         (nlines (length lines)))
    (loop for indexes in lines
          for line-i from 0
          do (let* ((mains (flex-line-mains indexes bases grows shrinks inner gap))
                    (n (length indexes))
                    (used (+ (reduce #'+ mains :initial-value 0d0)
                             (if (plusp n) (* gap (1- n)) 0d0)))
                    (slack (max 0d0 (- inner used)))
                    (justify (computed-justify-content style))
                    (offset 0d0)
                    (between 0d0)
                    (cursor 0d0)
                    (line-cross 0d0)
                    (line-kids nil))
               (cond
                 ((member justify '(:flex-end :end :right)) (setf offset slack))
                 ((eq justify :center) (setf offset (/ slack 2d0)))
                 ((and (eq justify :space-between) (> n 1))
                  (setf between (/ slack (1- n))))
                 ((eq justify :space-around)
                  (setf between (/ slack n) offset (/ between 2d0)))
                 ((eq justify :space-evenly)
                  (setf between (/ slack (1+ n)) offset between)))
               (setf cursor offset)
               (loop for i in indexes
                     for main in mains
                     for it = (nth i items)
                     do (let ((child
                               (cond
                                 ((dom-element-p it)
                                  (if row
                                      (layout-element it 0d0 0d0 main avail-h nil)
                                      (layout-element it 0d0 0d0 cw main nil)))
                                 (t
                                  (let ((text (if (dom-text-p it) (dom-text-text it) (second it))))
                                    (make-box :kind :text :style style :text text
                                              :w (if row
                                                     main
                                                     (text-advance text
                                                                   (computed-font-size style)
                                                                   (computed-font-family style)
                                                                   (computed-font-weight style)
                                                                   (computed-font-style style)))
                                              :h (if row (used-line-height style) main)))))))
                          (when child
                            (let ((cross (if row (box-h child) (box-w child))))
                              (when (and cross-definite
                                         (= nlines 1)
                                         (eq (computed-align-items style) :stretch)
                                         (dom-element-p it)
                                         (eq (if row
                                                 (computed-height (dom-element-style it))
                                                 (computed-width (dom-element-style it)))
                                             :auto))
                                (if row
                                    (setf (box-h child) cross-definite)
                                    (setf (box-w child) cross-definite))
                                (setf cross cross-definite))
                              (setf line-cross (max line-cross cross))
                              (if row
                                  (place-box child
                                             (+ x ml bl pl cursor)
                                             (+ y bt pt cross-cursor))
                                  (place-box child
                                             (+ x ml bl pl cross-cursor)
                                             (+ y bt pt cursor)))
                              (incf cursor (+ main gap between))
                              (push child line-kids)))))
               (setf main-max (max main-max cursor))
               (let ((line-size (if (and cross-definite (= nlines 1))
                                    cross-definite
                                    line-cross)))
                 (dolist (k line-kids)
                   (let ((align (if (and (box-element k)
                                         (dom-element-p (box-element k))
                                         (not (eq (computed-align-self (box-style k)) :auto)))
                                    (computed-align-self (box-style k))
                                    (computed-align-items style)))
                         (cross (if row (box-h k) (box-w k))))
                     (when (member align '(:flex-end :end))
                       (if row
                           (translate-box k 0d0 (- line-size cross))
                           (translate-box k (- line-size cross) 0d0)))
                     (when (eq align :center)
                       (if row
                           (translate-box k 0d0 (/ (- line-size cross) 2d0))
                           (translate-box k (/ (- line-size cross) 2d0) 0d0)))))
                 (let ((ordered (nreverse line-kids)))
                   (dolist (k ordered) (push k kids))
                   (push ordered groups))
                 (incf cross-cursor line-size)
                 (when (< line-i (1- nlines))
                   (incf cross-cursor cross-gap)))))
    (let* ((extra (if (and row cross-definite (> cross-definite cross-cursor))
                      (- cross-definite cross-cursor)
                      0d0))
           (align (computed-align-content style))
           (shift (cond
                    ((eq align :center) (/ extra 2d0))
                    ((member align '(:flex-end :end)) extra)
                    ((and (eq (computed-flex-wrap style) :wrap-reverse)
                          (not (member align '(:space-between :space-around :space-evenly))))
                     extra)
                    (t 0d0))))
      (when (and (eq align :space-between) (> nlines 1) (> extra 0d0))
        (let ((between (/ extra (1- nlines))))
          (loop for group in (reverse groups)
                for i from 0
                do (dolist (k group)
                     (translate-box k 0d0 (* i between))))))
      (when (and (eq align :space-around) (> nlines 0) (> extra 0d0))
        (let* ((slot (/ extra nlines))
               (edge (/ slot 2d0)))
          (loop for group in (reverse groups)
                for i from 0
                do (dolist (k group)
                     (translate-box k 0d0 (+ edge (* i slot)))))))
      (when (and (eq align :space-evenly) (> nlines 0) (> extra 0d0))
        (let ((gap (/ extra (1+ nlines))))
          (loop for group in (reverse groups)
                for i from 0
                do (dolist (k group)
                     (translate-box k 0d0 (* (1+ i) gap))))))
      (when (> shift 0d0)
        (dolist (k kids)
          (translate-box k 0d0 shift))))
    (setf (box-x box) (+ x ml)
          (box-y box) y
          (box-w box) (if row bw (max bw (+ cross-cursor pl pr bl br)))
          (box-h box) (+ (if row
                             (if cross-definite
                                 (max cross-definite cross-cursor)
                                 cross-cursor)
                             (if specified-h
                                 (max main-max (or cross-definite 0d0))
                                 main-max))
                         bt bb pt pb)
          (box-children box) (nreverse kids))
    box))

(defun layout-flex (el x y avail-w avail-h containing)
  (declare (ignore containing))
  (let* ((style (dom-element-style el))
         (box (make-element-box el :flex style)))
    (multiple-value-bind (bw ml mr cw) (solve-width style avail-w)
      (declare (ignore mr))
      (multiple-value-bind (bt br bb bl) (border4 style)
        (multiple-value-bind (pt pr pb pl) (pad4 style avail-w)
          (let* ((dir (computed-flex-direction style))
                 (row (member dir '(:row :row-reverse)))
                 (rev (member dir '(:row-reverse :column-reverse)))
                 (inner (if row cw (or (definite-length (computed-height style) avail-h) cw)))
                 (items (flex-items el))
                 (gap (if row (computed-column-gap style) (computed-row-gap style)))
                 (bases (mapcar (lambda (it) (item-main-base it row cw)) items))
                 (grows (mapcar (lambda (it)
                                  (if (dom-element-p it) (computed-flex-grow (dom-element-style it)) 0d0))
                                items))
                 (shrinks (mapcar (lambda (it)
                                    (if (dom-element-p it) (computed-flex-shrink (dom-element-style it)) 1d0))
                                  items))
                 (n (length items))
                 (gap-total (if (plusp n) (* gap (1- n)) 0d0))
                 (sum (reduce #'+ bases :initial-value 0d0))
                 (free (- inner sum gap-total))
                 (mains (mapcar #'float bases)))
            (if (member (computed-flex-wrap style) '(:wrap :wrap-reverse))
                (place-flex-wrap box items bases grows shrinks style
                                 :row row :rev rev :inner inner :gap gap
                                 :x x :y y :ml ml :bt bt :bb bb :bl bl :br br
                                 :pt pt :pb pb :pl pl :pr pr :bw bw
                                 :avail-h avail-h :cw cw)
                (progn
            (cond
              ((and (> free 0d0) (some (lambda (g) (> g 0d0)) grows))
               (let ((sg (reduce #'+ grows)))
                 (loop for i from 0 below n do
                   (incf (nth i mains) (* free (/ (nth i grows) sg))))))
              ((and (< free 0d0) (some (lambda (s) (> s 0d0)) shrinks))
               (let ((weighted (loop for b in bases for s in shrinks collect (* b s)))
                     (sw 0d0))
                 (setf sw (reduce #'+ weighted))
                 (when (> sw 0d0)
                   (loop for i from 0 below n do
                     (incf (nth i mains) (* free (/ (nth i weighted) sw))))))))
            (setf mains (mapcar (lambda (m) (max 0d0 m)) mains))
            (when rev
              (setf items (nreverse items) mains (nreverse mains)))
            (let* ((specified-h (definite-length (computed-height style) avail-h))
                   (cross-definite (when specified-h
                                     (if (eq (computed-box-sizing style) :border-box)
                                         (max 0d0 (- specified-h pt pb bt bb))
                                         specified-h)))
                   (cursor 0d0)
                   (cross-max 0d0)
                   (kids nil)
                   (justify (computed-justify-content style))
                   (used-main (+ (reduce #'+ mains :initial-value 0d0) gap-total))
                   (slack (max 0d0 (- inner used-main)))
                   (offset 0d0)
                   (between 0d0))
              (cond
                ((member justify '(:flex-end :end :right)) (setf offset slack))
                ((eq justify :center) (setf offset (/ slack 2d0)))
                ((and (eq justify :space-between) (> n 1))
                 (setf between (/ slack (1- n))))
                ((eq justify :space-around)
                 (setf between (/ slack n) offset (/ between 2d0)))
                ((eq justify :space-evenly)
                 (setf between (/ slack (1+ n)) offset between)))
              (setf cursor offset)
              (loop for it in items
                    for main in mains
                    do (let ((child
                              (cond
                                ((dom-element-p it)
                                 (if row
                                     (layout-element it 0d0 0d0 main avail-h nil)
                                     (layout-element it 0d0 0d0 cw main nil)))
                                (t
                                 (let ((text (if (dom-text-p it) (dom-text-text it) (second it))))
                                   (make-box :kind :text :style style :text text
                                             :w (if row main (text-advance text (computed-font-size style)
                                                                           (computed-font-family style)
                                                                           (computed-font-weight style)
                                                                           (computed-font-style style)))
                                             :h (if row (used-line-height style) main)))))))
                         (when child
                           (let ((cross (if row (box-h child) (box-w child))))
                             (when (and cross-definite
                                        (eq (computed-align-items style) :stretch)
                                        (dom-element-p it)
                                        (eq (if row (computed-height (dom-element-style it))
                                                (computed-width (dom-element-style it)))
                                            :auto))
                               (if row
                                   (setf (box-h child) cross-definite)
                                   (setf (box-w child) cross-definite))
                               (setf cross cross-definite))
                             (setf cross-max (max cross-max cross))
                             (if row
                                 (place-box child
                                            (+ x ml bl pl cursor)
                                            (+ y bt pt))
                                 (place-box child
                                            (+ x ml bl pl)
                                            (+ y bt pt cursor)))
                             (incf cursor (+ main gap between))
                             (push child kids)))))
              (let ((content-cross (or cross-definite cross-max)))
                (dolist (k kids)
                  (let ((align (if (and (box-element k) (dom-element-p (box-element k))
                                        (not (eq (computed-align-self (box-style k)) :auto)))
                                   (computed-align-self (box-style k))
                                   (computed-align-items style)))
                        (cross (if row (box-h k) (box-w k))))
                    (when (member align '(:flex-end :end))
                      (if row
                          (translate-box k 0d0 (- content-cross cross))
                          (translate-box k (- content-cross cross) 0d0)))
                    (when (eq align :center)
                      (if row
                          (translate-box k 0d0 (/ (- content-cross cross) 2d0))
                          (translate-box k (/ (- content-cross cross) 2d0) 0d0)))))
                (setf (box-x box) (+ x ml)
                      (box-y box) y
                      (box-w box) bw
                      (box-h box) (+ (if row content-cross (max content-cross cursor))
                                     bt bb pt pb)
                      (box-children box) (nreverse kids))
                (when (and (not row) (null specified-h))
                  (setf (box-h box) (+ cursor bt bb pt pb))))
              box)))))))))

(defun expand-repeats (tracks space)
  (let ((out nil))
    (dolist (tr tracks)
      (cond
        ((and (consp tr) (eq (car tr) :repeat))
         (let* ((count (second tr))
                (inner (third tr))
                (n (cond
                     ((numberp count) count)
                     ((member count '(:auto-fit :auto-fill))
                      (let ((min-size (track-min (car inner))))
                        (max 1 (floor (/ (+ space (max 0d0 0d0)) (max 1d0 min-size))))))
                     (t 1))))
           (loop repeat n do (dolist (in inner) (push in out)))))
        (t (push tr out))))
    (nreverse out)))

(defun track-min (tr)
  (cond
    ((numberp tr) tr)
    ((and (consp tr) (eq (car tr) :px)) (cdr tr))
    ((and (consp tr) (eq (car tr) :minmax))
     (track-min (second tr)))
    (t 100d0)))

(defun resolve-track-sizes (tracks space gap)
  (let* ((expanded (or (expand-repeats tracks space) (list :auto)))
         (n (length expanded))
         (gap-total (if (> n 1) (* gap (1- n)) 0d0))
         (budget (max 0d0 (- space gap-total)))
         (sizes (make-list n :initial-element 0d0))
         (flex nil)
         (fixed-sum 0d0))
    (loop for tr in expanded
          for i from 0
          do (cond
               ((numberp tr) (setf (nth i sizes) tr) (incf fixed-sum tr))
               ((and (consp tr) (eq (car tr) :px))
                (setf (nth i sizes) (cdr tr)) (incf fixed-sum (cdr tr)))
               ((and (consp tr) (eq (car tr) :%))
                (let ((p (* 0.01d0 (cdr tr) space)))
                  (setf (nth i sizes) p) (incf fixed-sum p)))
               ((and (consp tr) (eq (car tr) :fr))
                (push (cons i (cdr tr)) flex))
               ((eq tr :auto) (push (cons i 1d0) flex))
               ((and (consp tr) (eq (car tr) :minmax))
                (let ((lo (or (track-min (second tr)) 0d0))
                      (hi (third tr)))
                  (cond
                    ((and (consp hi) (eq (car hi) :fr))
                     (push (cons i (cdr hi)) flex)
                     (setf (nth i sizes) lo))
                    (t (let ((h (or (track-min hi) lo)))
                         (setf (nth i sizes) (max lo h))
                         (incf fixed-sum (nth i sizes)))))))
               (t (push (cons i 1d0) flex))))
    (let* ((flex-sum (reduce #'+ flex :key #'cdr :initial-value 0d0))
           (free (max 0d0 (- budget fixed-sum))))
      (when (and flex (> flex-sum 0d0))
        (dolist (f flex)
          (incf (nth (car f) sizes) (* free (/ (cdr f) flex-sum))))))
    sizes))

(defun layout-grid (el x y avail-w avail-h containing)
  (declare (ignore containing avail-h))
  (let* ((style (dom-element-style el))
         (box (make-element-box el :grid style)))
    (multiple-value-bind (bw ml mr cw) (solve-width style avail-w)
      (declare (ignore mr))
      (multiple-value-bind (bt br bb bl) (border4 style)
        (declare (ignore br))
        (multiple-value-bind (pt pr pb pl) (pad4 style avail-w)
          (declare (ignore pr))
          (let* ((col-gap (computed-column-gap style))
                 (row-gap (computed-row-gap style))
                 (cols (resolve-track-sizes (or (computed-grid-columns style) (list :auto)) cw col-gap))
                 (items (remove-if-not #'dom-element-p (flex-items el)))
                 (flow-col (eq (computed-grid-auto-flow style) :column))
                 (cursor-c 0) (cursor-r 0)
                 (placements nil)
                 (nrow 0) (ncol (length cols)))
            (dolist (it items)
              (let* ((gs (computed-grid-column (dom-element-style it)))
                     (gr (computed-grid-row (dom-element-style it)))
                     (cspan (or (and gs (cdr gs)) 1))
                     (rspan (or (and gr (cdr gr)) 1))
                     (cs (and gs (car gs)))
                     (rs (and gr (car gr))))
                (unless cs
                  (setf cs (1+ cursor-c)))
                (unless rs
                  (setf rs (1+ cursor-r)))
                (push (list it (1- cs) (1- rs) cspan rspan) placements)
                (setf ncol (max ncol (+ (1- cs) cspan)))
                (setf nrow (max nrow (+ (1- rs) rspan)))
                (if flow-col
                    (setf cursor-r (+ (1- rs) rspan))
                    (progn
                      (setf cursor-c (+ (1- cs) cspan))
                      (when (>= cursor-c ncol)
                        (setf cursor-c 0)
                        (incf cursor-r))))))
            (when (< (length cols) ncol)
              (setf cols (append cols (make-list (- ncol (length cols)) :initial-element
                                                 (/ cw (max 1 ncol))))))
            (let* ((explicit-rows (computed-grid-rows style))
                   (row-count (max 1 nrow))
                   (measured nil))
              (dolist (p (nreverse placements))
                (destructuring-bind (it c r cs rs) p
                  (let* ((w (loop for i from c below (min (+ c cs) (length cols))
                                  sum (nth i cols)))
                         (child (layout-element it 0d0 0d0 (max 1d0 w) nil nil)))
                    (when child
                      (push (list child c r cs rs (max 1d0 w)) measured)))))
              (setf measured (nreverse measured))
              (let* ((content-rows (make-list row-count :initial-element 0d0))
                     (resolved (resolve-track-sizes
                                (or explicit-rows (make-list row-count :initial-element :auto))
                                (or (definite-length (computed-height style) avail-w) 0d0)
                                row-gap)))
                (dolist (m measured)
                  (let ((r (third m))
                        (h (box-h (first m))))
                    (when (< r row-count)
                      (setf (nth r content-rows) (max (nth r content-rows) h)))))
                (loop for i from 0 below (min row-count (length resolved))
                      when (< (nth i resolved) 0.5d0)
                        do (setf (nth i resolved) (nth i content-rows)))
                (let ((row-y (make-array row-count :initial-element 0d0))
                      (col-x (make-array (length cols) :initial-element 0d0))
                      (acc 0d0)
                      (kids nil)
                      (content-h 0d0))
                  (loop for s in cols for i from 0 do
                    (setf (aref col-x i) acc)
                    (incf acc (+ s col-gap)))
                  (setf acc 0d0)
                  (loop for s in resolved for i from 0 below row-count do
                    (setf (aref row-y i) acc)
                    (incf acc (+ s row-gap)))
                  (dolist (m measured)
                    (destructuring-bind (child c r cs rs w) m
                      (declare (ignore rs w))
                      (place-box child
                                 (+ x ml bl pl (aref col-x (min c (1- (length cols)))))
                                 (+ y bt pt (if (< r row-count) (aref row-y r) 0d0)))
                      (when (and cs (> cs 1))
                        (setf (box-w child)
                              (loop for i from c below (min (+ c cs) (length cols))
                                    sum (nth i cols))))
                      (push child kids)
                      (setf content-h (max content-h
                                           (- (+ (box-y child) (box-h child))
                                              (+ y bt pt))))))
                  (setf (box-x box) (+ x ml)
                        (box-y box) y
                        (box-w box) bw
                        (box-h box) (+ (if (definite-length (computed-height style) nil)
                                           (definite-length (computed-height style) nil)
                                           content-h)
                                       bt bb pt pb)
                        (box-children box) (nreverse kids))
                  box)))))))))

(defun table-caption (el)
  (labels ((walk (n)
             (dolist (c (dom-node-children n))
               (when (dom-element-p c)
                 (cond
                   ((or (eq (computed-display (dom-element-style c)) :table-caption)
                        (string= (dom-element-tag c) "caption"))
                    (return-from table-caption c))
                   ((not (or (string= (dom-element-tag c) "tr")
                             (eq (computed-display (dom-element-style c)) :table-row)))
                    (walk c)))))))
    (walk el)
    nil))

(defun table-rows (el)
  (let ((rows nil))
    (labels ((walk (n)
               (dolist (c (dom-node-children n))
                 (when (dom-element-p c)
                   (cond
                     ((or (eq (computed-display (dom-element-style c)) :table-row)
                          (string= (dom-element-tag c) "tr"))
                      (push c rows))
                     (t (walk c)))))))
      (walk el))
    (nreverse rows)))

(defun cell-colspan (cell)
  (let* ((raw (and (dom-element-p cell) (dom-attr cell "colspan")))
         (n (and raw (ignore-errors (parse-integer raw :junk-allowed t)))))
    (max 1 (or n 1))))

(defun cell-rowspan (cell)
  (let* ((raw (and (dom-element-p cell) (dom-attr cell "rowspan")))
         (n (and raw (ignore-errors (parse-integer raw :junk-allowed t)))))
    (max 1 (or n 1))))

(defun row-column-count (row)
  (reduce #'+ (row-cells row) :key #'cell-colspan :initial-value 0))

(defun row-cells (row)
  (or (remove-if-not
       (lambda (c)
         (or (member (computed-display (dom-element-style c)) '(:table-cell))
             (member (dom-element-tag c) '("td" "th") :test #'string=)))
       (element-children row))
      (element-children row)))

(defun border-edge (style side)
  (multiple-value-bind (bt br bb bl) (border4 style)
    (case side
      (:right br)
      (:left bl)
      (:bottom bb)
      (t bt))))

(defun content-ink-right (box)
  "Right edge of real content inside BOX. Line boxes and the block that
wraps a line stretch to the available width, so their own width is ignored."
  (labels ((walk (b)
             (let ((kids (box-children b)))
               (if (and kids (member (box-kind b) '(:line :block)))
                   (reduce #'max kids :key #'walk :initial-value (box-x b))
                   (+ (box-x b) (box-w b))))))
    (let ((kids (box-children box)))
      (if kids
          (reduce #'max kids :key #'walk :initial-value (box-x box))
          (+ (box-x box) (box-w box))))))

(defun ink-border-box (style box)
  "Border-box width from the ink inside BOX, plus the right border and padding."
  (multiple-value-bind (bt br bb bl) (border4 style)
    (declare (ignore bt bb bl))
    (multiple-value-bind (pt pr pb pl) (pad4 style 0d0)
      (declare (ignore pt pb pl))
      (+ (max 0d0 (- (content-ink-right box) (box-x box))) br pr))))

(defun cell-max-content-width (cell)
  "Border-box width of CELL on one line. A specified width is that width."
  (let* ((style (dom-element-style cell))
         (box (layout-element cell 0d0 0d0 100000d0 nil nil :shrink t)))
    (cond
      ((null box) 0d0)
      ((not (eq (computed-width style) :auto)) (box-w box))
      (t (ink-border-box style box)))))

(defun element-min-content-width (el)
  "Width of the longest unbreakable line. Used so a caption can widen a table."
  (let* ((style (dom-element-style el))
         (box (layout-element el 0d0 0d0 1d0 nil nil :shrink t)))
    (cond
      ((null box) 0d0)
      ((not (eq (computed-width style) :auto)) (box-w box))
      (t (ink-border-box style box)))))

(defun measure-table-columns (rows ncols)
  "Preferred border-box width of each column. A colspan cell that is wider
than the columns it covers shares the extra across those columns."
  (let ((cols (make-array ncols :initial-element 0d0))
        (spans nil)
        (covered (make-array ncols :initial-element 0)))
    (dolist (row rows)
      (let ((col 0))
        (dolist (cell (row-cells row))
          (loop while (and (< col ncols) (> (aref covered col) 0))
                do (incf col))
          (when (< col ncols)
            (let* ((span (min (cell-colspan cell) (max 1 (- ncols col))))
                   (rspan (cell-rowspan cell))
                   (w (cell-max-content-width cell)))
              (if (= span 1)
                  (setf (aref cols col) (max (aref cols col) w))
                  (push (list col span w) spans))
              (dotimes (i span)
                (when (< (+ col i) ncols)
                  (setf (aref covered (+ col i)) rspan)))
              (incf col span))))
        (dotimes (i ncols)
          (when (> (aref covered i) 0)
            (decf (aref covered i))))))
    (dolist (sp spans)
      (destructuring-bind (start span w) sp
        (let ((sum (loop for i from start below (+ start span) sum (aref cols i))))
          (when (> w (+ sum 0.5d0))
            (let ((extra (/ (- w sum) span)))
              (dotimes (i span)
                (incf (aref cols (+ start i)) extra)))))))
    cols))

(defun inset-collapsed-cell (box)
  "Center a collapsed border on the cell edge. Half of each border sits
outside the border box, so the box is content plus padding plus one border."
  (let ((st (box-style box)))
    (when st
      (multiple-value-bind (bt br bb bl) (border4 st)
        (let ((hl (/ bl 2d0)) (hr (/ br 2d0))
              (ht (/ bt 2d0)) (hb (/ bb 2d0)))
          (incf (box-x box) hl)
          (decf (box-w box) (+ hl hr))
          (incf (box-y box) ht)
          (decf (box-h box) (+ ht hb)))))))

(defun collapsed-shared-width (rows)
  "The widest shared vertical border. Counted in both neighboring cells."
  (let ((share 0d0))
    (dolist (row rows)
      (let ((prev nil))
        (dolist (cell (row-cells row))
          (when prev
            (setf share (max share
                             (max (border-edge (dom-element-style prev) :right)
                                  (border-edge (dom-element-style cell) :left)))))
          (setf prev cell))))
    share))

(defun column-outer-width (cols gap space-x)
  "Content width of the columns plus the gaps or border-spacing around them."
  (let ((n (length cols)))
    (+ (reduce #'+ cols :initial-value 0d0)
       (if (> space-x 0d0)
           (* space-x (1+ n))
           (* gap (max 0 (1- n)))))))

(defun column-span-width (cols start span gap)
  (+ (loop for i from start below (+ start span) sum (if (< i (length cols))
                                                         (aref cols i)
                                                         0d0))
     (* gap (max 0 (1- span)))))

(defun layout-table (el x y avail-w avail-h containing)
  (declare (ignore avail-h containing))
  (let* ((style (dom-element-style el))
         (box (make-element-box el :table style))
         (rows (table-rows el)))
    (multiple-value-bind (bw ml mr cw) (solve-width style avail-w)
      (declare (ignore mr))
      (multiple-value-bind (bt br bb bl) (border4 style)
        (multiple-value-bind (pt pr pb pl) (pad4 style avail-w)
          (let* ((collapse (eq (computed-border-collapse style) :collapse))
                 (ncols (max 1 (reduce #'max rows :key #'row-column-count :initial-value 1)))
                 (space-x (if collapse 0d0 (computed-border-spacing-x style)))
                 (space-y (if collapse 0d0 (computed-border-spacing-y style)))
                 (gap (if collapse 0d0 (if (> space-x 0d0) space-x (computed-column-gap style))))
                 (specified (numberp (definite-length (computed-width style) avail-w)))
                 (cols (if specified
                           (make-array ncols :initial-element
                                       (max 1d0 (/ (- cw (* gap (max 0 (1- ncols))))
                                                  (max 1 ncols))))
                           (measure-table-columns rows ncols)))
                 (cap-el (table-caption el))
                 (cap-min (if (and cap-el (not specified))
                              (element-min-content-width cap-el)
                              0d0)))
            (unless specified
              (let* ((fixed (if (> space-x 0d0)
                                (* space-x (1+ ncols))
                                (* gap (max 0 (1- ncols)))))
                     (sum (reduce #'+ cols :initial-value 0d0))
                     (outer (+ sum fixed)))
                (cond
                  ((and (> cap-min outer) (> ncols 0))
                   (let ((extra (/ (min (- cap-min outer) (max 0d0 (- cw outer))) ncols)))
                     (when (> extra 0d0)
                       (dotimes (i ncols) (incf (aref cols i) extra)))))
                  ((and (> outer cw) (> sum 0d0))
                   (let* ((room (max 0d0 (- cw fixed)))
                          (scale (/ room sum)))
                     (dotimes (i ncols)
                       (setf (aref cols i) (max 1d0 (* (aref cols i) scale)))))))
                (setf cw (min cw (max 0d0 cap-min
                                     (- (column-outer-width cols gap space-x)
                                        (if collapse
                                            (* (collapsed-shared-width rows)
                                               (max 0 (1- ncols)))
                                            0d0))))
                      bw (+ cw bl br pl pr))))
            (let* ((cap-bottom (and cap-el
                                  (dom-element-style cap-el)
                                  (eq (computed-caption-side (dom-element-style cap-el)) :bottom)))
                 (cap (when (and cap-el
                                 (not cap-bottom)
                                 (dom-element-style cap-el)
                                 (not (eq (computed-display (dom-element-style cap-el)) :none)))
                        (layout-block cap-el (+ x ml bl pl) (+ y bt pt) cw nil nil)))
                 (yy (+ y bt pt (if cap (box-h cap) 0d0) (if (> space-y 0d0) space-y 0d0)))
                 (kids nil)
                 (prev-row nil)
                 (row-heights nil)
                 (rowspans nil)
                 (covered (make-array ncols :initial-element 0)))
            (dolist (row rows)
              (let ((xx (+ x ml bl pl (if (> space-x 0d0) space-x 0d0)))
                    (col 0)
                    (rh 0d0)
                    (cells nil)
                    (prev nil))
                (dolist (cell (row-cells row))
                  (loop while (and (< col ncols) (> (aref covered col) 0))
                        do (incf xx (cond
                                      (collapse (aref cols col))
                                      ((> space-x 0d0) (+ (aref cols col) space-x))
                                      (t (+ (aref cols col) gap))))
                           (incf col))
                  (let* ((span (min (cell-colspan cell) (max 1 (- ncols col))))
                         (rspan (cell-rowspan cell))
                         (slot (column-span-width cols col span gap))
                         (cb (layout-element cell xx yy (max 1d0 slot) nil nil)))
                    (when cb
                      (when (and collapse prev)
                        (decf xx (max (border-edge (box-style prev) :right)
                                      (border-edge (box-style cb) :left))))
                      (setf (box-x cb) xx (box-y cb) yy)
                      (setf rh (max rh (box-h cb)))
                      (push cb cells)
                      (when (> rspan 1)
                        (push (list cb (length row-heights) rspan) rowspans))
                      (dotimes (i span)
                        (when (< (+ col i) ncols)
                          (setf (aref covered (+ col i)) rspan)))
                      (incf col span)
                      (incf xx (cond
                                 (collapse (box-w cb))
                                 ((> space-x 0d0) (+ (box-w cb) space-x))
                                 (t (+ slot gap))))
                      (setf prev cb))))
                (dotimes (i ncols)
                  (when (> (aref covered i) 0)
                    (decf (aref covered i))))
                (push rh row-heights)
                (dolist (cb cells)
                  (let* ((old (box-h cb))
                         (align (and (box-style cb) (computed-vertical-align (box-style cb))))
                         (shift (cond
                                  ((eq align :bottom) (- rh old))
                                  ((eq align :middle) (/ (- rh old) 2d0))
                                  (t 0d0))))
                    (setf (box-h cb) rh)
                    (when (> shift 0d0)
                      (dolist (child (box-children cb))
                        (translate-box child 0d0 shift)))))
                (when (and collapse prev-row cells)
                  (let ((share (max (border-edge (box-style (car prev-row)) :bottom)
                                    (border-edge (box-style (car cells)) :top))))
                    (dolist (cb cells) (decf (box-y cb) share))
                    (decf yy share)))
                (when collapse
                  (dolist (cb cells) (inset-collapsed-cell cb)))
                (setf kids (append (nreverse cells) kids))
                (setf prev-row cells)
                (incf yy (+ rh (cond
                                 (collapse 0d0)
                                 ((> space-y 0d0) space-y)
                                 (t (computed-row-gap style)))))))
            (setf row-heights (nreverse row-heights))
            (dolist (sp rowspans)
              (destructuring-bind (cb index rspan) sp
                (setf (box-h cb)
                      (loop for i from index below (min (+ index rspan) (length row-heights))
                            sum (or (nth i row-heights) 0d0)))))
            (when (and cap-el cap-bottom
                       (dom-element-style cap-el)
                       (not (eq (computed-display (dom-element-style cap-el)) :none)))
              (let ((placed (layout-block cap-el (+ x ml bl pl) yy cw nil nil)))
                (when placed
                  (setf cap placed)
                  (incf yy (box-h placed)))))
            (when cap (push cap kids))
            (setf (box-x box) (+ x ml)
                  (box-y box) y
                  (box-w box) bw
                  (box-h box) (+ (- yy y bt pt) bt bb pt pb)
                  (box-children box) (nreverse kids))
            box)))))))

(defun layout-document (html-element)
  (let ((root (layout-element html-element 0d0 0d0 *viewport-width* *viewport-height* nil)))
    (when (and root (> (box-collapsed-top root) 0d0))
      (translate-box root 0d0 (box-collapsed-top root)))
    root))

(defun box-width (box) (box-w box))
(defun box-height (box) (box-h box))

(defun translate-box (box dx dy)
  (incf (box-x box) dx)
  (incf (box-y box) dy)
  (dolist (c (box-children box))
    (translate-box c dx dy)))

(defun place-box (box x y)
  (translate-box box (- x (box-x box)) (- y (box-y box))))

(defun find-box (box id)
  (when box
    (if (and (box-id box) (string= (box-id box) id))
        box
        (some (lambda (c) (find-box c id)) (box-children box)))))

(defun %hit-test (box x y)
  "Deepest box containing the point. Children are tested even when a parent
box is empty, so absolute boxes outside the flow can still be hit."
  (when box
    (or (some (lambda (c) (%hit-test c x y)) (reverse (box-children box)))
        (when (and (<= (box-x box) x (+ (box-x box) (box-w box)))
                   (<= (box-y box) y (+ (box-y box) (box-h box)))
                   (> (box-w box) 0d0)
                   (> (box-h box) 0d0))
          box))))

(defun link-href (box)
  "The href of BOX or its nearest anchor ancestor, or NIL."
  (loop for el = (and box (box-element box)) then (and el (dom-node-parent el))
        while (dom-element-p el)
        when (and (string-equal (dom-element-tag el) "a")
                  (dom-attr el "href"))
          return (dom-attr el "href")))

(defun hit-test (box x y &optional (scroll-y 0d0))
  "Box under viewport point X,Y. SCROLL-Y is how far the document has moved up."
  (%hit-test box (float x 1d0) (+ (float y 1d0) (float scroll-y 1d0))))

(defun describe-box (box &optional (indent 0))
  (when box
    (format t "~&~vT~A ~A ~A ~,1Fx~,1F ~,1Fx~,1F~@[ \"~A\"~]~%"
            indent (box-kind box) (or (box-tag box) "") (or (box-id box) "")
            (box-x box) (box-y box) (box-w box) (box-h box)
            (and (box-text box) (subseq (box-text box) 0 (min 24 (length (box-text box))))))
    (dolist (c (box-children box))
      (describe-box c (+ indent 2)))))
