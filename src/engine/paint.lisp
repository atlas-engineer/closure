;;; Paint a box tree with Cairo.

(in-package :closure.engine)

(defun color-or (color style)
  (cond
    ((and (consp color) (numberp (car color))) color)
    ((eq color :currentcolor) (computed-color style))
    ((null color) (computed-color style))
    (t (computed-color style))))

(defun set-color (cr color &optional (alpha 1d0))
  (cairo-set-source-rgba cr
                         (or (first color) 0d0)
                         (or (second color) 0d0)
                         (or (third color) 0d0)
                         (* (or (fourth color) 1d0) alpha)))

(defun rounded-rect (cr x y w h r)
  (let ((r (max 0d0 (min r (/ w 2d0) (/ h 2d0)))))
    (cairo-new-sub-path cr)
    (if (<= r 0.5d0)
        (cairo-rectangle cr x y w h)
        (progn
          (cairo-arc cr (+ x w (- r)) (+ y r) r (- (/ pi 2d0)) 0d0)
          (cairo-arc cr (+ x w (- r)) (+ y h (- r)) r 0d0 (/ pi 2d0))
          (cairo-arc cr (+ x r) (+ y h (- r)) r (/ pi 2d0) pi)
          (cairo-arc cr (+ x r) (+ y r) r pi (* 1.5d0 pi))
          (cairo-close-path cr)))))

(defun paint-border (cr box)
  (let* ((st (box-style box))
         (x (box-x box)) (y (box-y box)) (w (box-w box)) (h (box-h box)))
    (when (and st (> w 0d0) (> h 0d0))
      (multiple-value-bind (bt br bb bl) (border4 st)
        (flet ((side (bw color style x1 y1 ww hh)
                 (when (and (> bw 0d0) (not (member style '(:none :hidden nil))))
                   (set-color cr (color-or color st))
                   (cairo-set-line-width cr bw)
                   (cond
                     ((eq style :dashed)
                      (cffi:with-foreign-object (dash :double 2)
                        (setf (cffi:mem-aref dash :double 0) (* 3d0 bw)
                              (cffi:mem-aref dash :double 1) (* 2d0 bw))
                        (cairo-set-dash cr dash 2 0d0)))
                     ((eq style :dotted)
                      (cffi:with-foreign-object (dash :double 2)
                        (setf (cffi:mem-aref dash :double 0) bw
                              (cffi:mem-aref dash :double 1) bw)
                        (cairo-set-dash cr dash 2 0d0)))
                     (t (cairo-set-dash cr (cffi:null-pointer) 0 0d0)))
                   (cairo-rectangle cr (+ x1 (/ bw 2d0)) (+ y1 (/ bw 2d0))
                                    (max 0d0 (- ww bw)) (max 0d0 (- hh bw)))
                   (cairo-stroke cr))))
          (side bt (computed-btc st) (computed-bts st) x y w bt)
          (side bb (computed-bbc st) (computed-bbs st) x (+ y h (- bb)) w bb)
          (side bl (computed-blc st) (computed-bls st) x y bl h)
          (side br (computed-brc st) (computed-brs st) (+ x w (- br)) y br h))))))

(defun paint-text-box (cr box)
  (let ((st (box-style box))
        (text (box-text box)))
    (when (and st text (plusp (length text)))
      (set-color cr (computed-color st))
      (cairo-select-font-face cr
                              (cairo-family (computed-font-family st))
                              (cairo-slant (computed-font-style st))
                              (cairo-weight (computed-font-weight st)))
      (cairo-set-font-size cr (computed-font-size st))
      (cairo-move-to cr (box-x box)
                     (+ (box-y box)
                        (or (box-baseline box)
                            (font-ascent (computed-font-size st)
                                         (computed-font-family st)
                                         (computed-font-weight st)
                                         (computed-font-style st)))))
      (cairo-show-text cr text))))

(defun apply-transform (cr box)
  (let ((ops (and (box-style box) (computed-transform (box-style box))))
        (ox (+ (box-x box) (/ (box-w box) 2d0)))
        (oy (+ (box-y box) (/ (box-h box) 2d0))))
    (when ops
      (cairo-translate cr ox oy)
      (dolist (op ops)
        (case (car op)
          (:translate
           (let ((tx (or (resolve-px (second op) (box-w box)) 0d0))
                 (ty (or (resolve-px (third op) (box-h box)) 0d0)))
             (cairo-translate cr tx ty)))
          (:scale (cairo-scale cr (float (second op) 1d0) (float (third op) 1d0)))
          (:rotate (cairo-rotate cr (float (second op) 1d0)))))
      (cairo-translate cr (- ox) (- oy)))))

(defun paint-box (cr box &optional (scroll-y 0d0))
  (when (and box (or (null (box-style box))
                     (not (eq (computed-visibility (box-style box)) :hidden))))
    (let ((sticky (or (box-sticky-top box) 0d0))
          (dy 0d0))
      (when (and (box-sticky-top box) (box-style box)
                 (eq (computed-position (box-style box)) :sticky))
        (setf dy (max 0d0 (- (+ scroll-y sticky) (box-y box)))))
      (cairo-save cr)
      (when (/= dy 0d0) (cairo-translate cr 0d0 dy))
      (apply-transform cr box)
      (let ((opacity (if (box-style box) (computed-opacity (box-style box)) 1d0)))
        (when (< opacity 1d0) (cairo-push-group cr))
        (when (and (box-style box) (computed-background (box-style box))
                   (> (box-w box) 0d0) (> (box-h box) 0d0))
          (set-color cr (color-or (computed-background (box-style box)) (box-style box)))
          (rounded-rect cr (box-x box) (box-y box) (box-w box) (box-h box)
                        (or (computed-radius (box-style box)) 0d0))
          (cairo-fill cr))
        (paint-border cr box)
        (when (and (box-marker box) (not (eq (box-marker box) :none)))
          (set-color cr (computed-color (box-style box)))
          (if (eq (box-marker box) :decimal)
              (progn
                (cairo-set-font-size cr (computed-font-size (box-style box)))
                (cairo-move-to cr (- (box-x box) 16d0) (+ (box-y box) (computed-font-size (box-style box))))
                (cairo-show-text cr "•"))
              (progn
                (cairo-arc cr (- (box-x box) 10d0) (+ (box-y box) 8d0) 2.5d0 0d0 (* 2d0 pi))
                (cairo-fill cr))))
        (if (eq (box-kind box) :text)
            (paint-text-box cr box)
            (progn
              (when (and (box-style box)
                         (member (computed-overflow (box-style box)) '(:hidden :clip :scroll :auto)))
                (cairo-rectangle cr (box-x box) (box-y box) (box-w box) (box-h box))
                (cairo-clip cr))
              (dolist (c (box-children box))
                (paint-box cr c scroll-y))))
        (when (< opacity 1d0)
          (cairo-pop-group-to-source cr)
          (cairo-paint-with-alpha cr opacity)))
      (cairo-restore cr))))

(defun paint-png (root pathname width height &key (scroll-y 0d0))
  (ensure-cairo)
  (let* ((w (max 1 (round width)))
         (h (max 1 (round height)))
         (surface (cairo-image-surface-create 0 w h))
         (cr (cairo-create surface)))
    (unwind-protect
         (progn
           (cairo-set-source-rgba cr 1d0 1d0 1d0 1d0)
           (cairo-paint cr)
           (paint-box cr root scroll-y)
           (cairo-surface-flush surface)
           (let ((status (cairo-surface-write-to-png surface (namestring pathname))))
             (unless (zerop status)
               (error "Cairo PNG write failed: ~A" (cairo-status-to-string status)))))
      (cairo-destroy cr)
      (cairo-surface-destroy surface)))
  pathname)

(defun count-ink (pathname)
  "Count pixels in a PNG that are not opaque white. Used by the renderer tests."
  (ensure-cairo)
  (cffi:defcfun ("cairo_image_surface_create_from_png" cairo-image-surface-create-from-png)
      :pointer
    (filename :string))
  (let* ((surface (cairo-image-surface-create-from-png (namestring pathname)))
         (w 0) (h 0) (ink 0))
    (unwind-protect
         (progn
           (cairo-surface-flush surface)
           (setf w (cffi:foreign-funcall "cairo_image_surface_get_width" :pointer surface :int)
                 h (cffi:foreign-funcall "cairo_image_surface_get_height" :pointer surface :int))
           (let* ((data (cairo-image-surface-get-data surface))
                  (stride (cairo-image-surface-get-stride surface)))
             (loop for y below h do
               (loop for x below w do
                 (let ((px (cffi:mem-ref (cffi:inc-pointer data (+ (* y stride) (* x 4))) :uint32)))
                   (unless (= px #xffffffff)
                     (incf ink)))))))
      (cairo-surface-destroy surface))
    ink))
