;;; Paint a box tree with Cairo.

(in-package :closure.engine)

(defun color-or (color style)
  (cond
    ((and (consp color) (numberp (car color))) color)
    ((eq color :currentcolor) (computed-color style))
    ((null color) (computed-color style))
    (t (computed-color style))))

(defun set-color (cr color &optional (alpha 1d0))
  (cairo-set-source-rgba cr
                         (or (first color) 0d0)
                         (or (second color) 0d0)
                         (or (third color) 0d0)
                         (* (or (fourth color) 1d0) alpha)))

(defun rounded-rect (cr x y w h r)
  (let ((r (max 0d0 (min r (/ w 2d0) (/ h 2d0)))))
    (cairo-new-sub-path cr)
    (if (<= r 0.5d0)
        (cairo-rectangle cr x y w h)
        (progn
          (cairo-arc cr (+ x w (- r)) (+ y r) r (- (/ pi 2d0)) 0d0)
          (cairo-arc cr (+ x w (- r)) (+ y h (- r)) r 0d0 (/ pi 2d0))
          (cairo-arc cr (+ x r) (+ y h (- r)) r (/ pi 2d0) pi)
          (cairo-arc cr (+ x r) (+ y r) r pi (* 1.5d0 pi))
          (cairo-close-path cr)))))

(defun paint-border (cr box)
  (let* ((st (box-style box))
         (x (box-x box)) (y (box-y box)) (w (box-w box)) (h (box-h box)))
    (when (and st (> w 0d0) (> h 0d0))
      (multiple-value-bind (bt br bb bl) (border4 st)
        (flet ((side (bw color style x1 y1 ww hh)
                 (when (and (> bw 0d0) (not (member style '(:none :hidden nil))))
                   (set-color cr (color-or color st))
                   (cairo-set-line-width cr bw)
                   (cond
                     ((eq style :double)
                      (let ((line (/ bw 3d0)))
                        (cairo-set-dash cr (cffi:null-pointer) 0 0d0)
                        (cairo-set-line-width cr line)
                        (if (>= ww hh)
                            (progn
                              (cairo-move-to cr x1 (+ y1 (/ line 2d0)))
                              (cairo-line-to cr (+ x1 ww) (+ y1 (/ line 2d0)))
                              (cairo-stroke cr)
                              (cairo-move-to cr x1 (+ y1 bw (- (/ line 2d0))))
                              (cairo-line-to cr (+ x1 ww) (+ y1 bw (- (/ line 2d0))))
                              (cairo-stroke cr))
                            (progn
                              (cairo-move-to cr (+ x1 (/ line 2d0)) y1)
                              (cairo-line-to cr (+ x1 (/ line 2d0)) (+ y1 hh))
                              (cairo-stroke cr)
                              (cairo-move-to cr (+ x1 bw (- (/ line 2d0))) y1)
                              (cairo-line-to cr (+ x1 bw (- (/ line 2d0))) (+ y1 hh))
                              (cairo-stroke cr)))))
                     (t
                      (cond
                        ((eq style :dashed)
                         (cffi:with-foreign-object (dash :double 2)
                           (setf (cffi:mem-aref dash :double 0) (* 3d0 bw)
                                 (cffi:mem-aref dash :double 1) (* 2d0 bw))
                           (cairo-set-dash cr dash 2 0d0)))
                        ((eq style :dotted)
                         (cffi:with-foreign-object (dash :double 2)
                           (setf (cffi:mem-aref dash :double 0) bw
                                 (cffi:mem-aref dash :double 1) bw)
                           (cairo-set-dash cr dash 2 0d0)))
                        (t (cairo-set-dash cr (cffi:null-pointer) 0 0d0)))
                      (cairo-rectangle cr (+ x1 (/ bw 2d0)) (+ y1 (/ bw 2d0))
                                       (max 0d0 (- ww bw)) (max 0d0 (- hh bw)))
                      (cairo-stroke cr))))))
          (labels ((shade (color light)
                     (let* ((c (color-or color st))
                            (r (float (or (first c) 0d0) 1d0))
                            (g (float (or (second c) 0d0) 1d0))
                            (b (float (or (third c) 0d0) 1d0))
                            (a (float (or (fourth c) 1d0) 1d0)))
                       (if light
                           (list (+ r (* (- 1d0 r) 0.6d0))
                                 (+ g (* (- 1d0 g) 0.6d0))
                                 (+ b (* (- 1d0 b) 0.6d0))
                                 a)
                           (list (* r 0.45d0) (* g 0.45d0) (* b 0.45d0) a))))
                   (tone (color style light)
                     (cond
                       ((or (eq style :groove) (eq style :inset))
                        (values (shade color light) :solid))
                       ((or (eq style :ridge) (eq style :outset))
                        (values (shade color (not light)) :solid))
                       (t (values color style)))))
            (multiple-value-bind (c s) (tone (computed-btc st) (computed-bts st) nil)
              (side bt c s x y w bt))
            (multiple-value-bind (c s) (tone (computed-bbc st) (computed-bbs st) t)
              (side bb c s x (+ y h (- bb)) w bb))
            (multiple-value-bind (c s) (tone (computed-blc st) (computed-bls st) nil)
              (side bl c s x y bl h))
            (multiple-value-bind (c s) (tone (computed-brc st) (computed-brs st) t)
              (side br c s (+ x w (- br)) y br h))))))))

(defun paint-outline (cr box)
  "Draw an outline outside the border box. It does not change layout."
  (let* ((st (box-style box))
         (bw (and st (computed-outline-width st)))
         (style (and st (computed-outline-style st))))
    (when (and st (numberp bw) (> bw 0d0)
               (not (member style '(:none :hidden nil)))
               (> (box-w box) 0d0) (> (box-h box) 0d0))
      (let ((out (+ (/ bw 2d0) (or (computed-outline-offset st) 0d0))))
        (set-color cr (color-or (computed-outline-color st) st))
        (cairo-set-line-width cr bw)
        (flet ((stroke-rect ()
                 (cairo-rectangle cr
                                  (- (box-x box) out)
                                  (- (box-y box) out)
                                  (+ (box-w box) (* 2d0 out))
                                  (+ (box-h box) (* 2d0 out)))
                 (cairo-stroke cr)))
          (cond
            ((eq style :dashed)
             (cffi:with-foreign-object (dash :double 2)
               (setf (cffi:mem-aref dash :double 0) (* 3d0 bw)
                     (cffi:mem-aref dash :double 1) (* 2d0 bw))
               (cairo-set-dash cr dash 2 0d0)
               (stroke-rect)
               (cairo-set-dash cr (cffi:null-pointer) 0 0d0)))
            ((eq style :dotted)
             (cffi:with-foreign-object (dash :double 2)
               (setf (cffi:mem-aref dash :double 0) bw
                     (cffi:mem-aref dash :double 1) bw)
               (cairo-set-dash cr dash 2 0d0)
               (stroke-rect)
               (cairo-set-dash cr (cffi:null-pointer) 0 0d0)))
            ((eq style :double)
             (let* ((off (or (computed-outline-offset st) 0d0))
                    (line (/ bw 3d0))
                    (inner (+ off (/ line 2d0)))
                    (outer (+ off bw (- (/ line 2d0)))))
               (cairo-set-dash cr (cffi:null-pointer) 0 0d0)
               (cairo-set-line-width cr line)
               (flet ((stroke-at (dist)
                        (cairo-rectangle cr
                                         (- (box-x box) dist)
                                         (- (box-y box) dist)
                                         (+ (box-w box) (* 2d0 dist))
                                         (+ (box-h box) (* 2d0 dist)))
                        (cairo-stroke cr)))
                 (stroke-at inner)
                 (stroke-at outer))))
            (t
             (cairo-set-dash cr (cffi:null-pointer) 0 0d0)
             (stroke-rect))))))))

(defun fitted-image-origin (fit iw ih x y w h)
  "Where to draw an image of IW by IH inside the box at X Y W H.
Returns the destination origin and size. FILL stretches. The others keep aspect ratio."
  (let* ((sx (/ w iw))
         (sy (/ h ih))
         (s (case fit
              (:contain (min sx sy))
              (:cover (max sx sy))
              (:none 1d0)
              (:scale-down (min 1d0 (min sx sy)))
              (t nil))))
    (if (null s)
        (values x y w h)
        (let ((dw (* iw s)) (dh (* ih s)))
          (values (+ x (/ (- w dw) 2d0))
                  (+ y (/ (- h dh) 2d0))
                  dw dh)))))

(defun paint-surface-in-box (cr surface x y w h &key (fit :fill))
  (let ((iw (float (cairo-image-surface-get-width surface) 1d0))
        (ih (float (cairo-image-surface-get-height surface) 1d0)))
    (when (and (> iw 0d0) (> ih 0d0) (> w 0d0) (> h 0d0))
      (multiple-value-bind (dx dy dw dh) (fitted-image-origin fit iw ih x y w h)
        (cairo-save cr)
        (cairo-rectangle cr x y w h)
        (cairo-clip cr)
        (cairo-translate cr dx dy)
        (cairo-scale cr (/ dw iw) (/ dh ih))
        (cairo-set-source-surface cr surface 0d0 0d0)
        (cairo-paint cr)
        (cairo-restore cr)))))

(defun background-position-offset (value area image origin)
  "Place one background-position axis. A percentage aligns that point of the image with the same point of the area."
  (cond ((or (eq value :left) (eq value :top) (null value)) origin)
        ((or (eq value :right) (eq value :bottom)) (- (+ origin area) image))
        ((eq value :center) (+ origin (/ (- area image) 2d0)))
        ((numberp value) (+ origin (float value 1d0)))
        ((and (consp value) (eq (car value) :%))
         (+ origin (* 0.01d0 (float (cdr value) 1d0) (- area image))))
        (t origin)))

(defun background-length (value box-size)
  "Resolve one background-size component against BOX-SIZE. NIL means auto."
  (cond ((numberp value) (float value 1d0))
        ((and (consp value) (eq (car value) :%))
         (* 0.01d0 (float (cdr value) 1d0) box-size))
        (t nil)))

(defun gradient-stop-offsets (stops)
  "Positions from 0 to 1. A missing first stop is 0, a missing last stop is 1,
and gaps between known stops are split evenly."
  (let* ((n (length stops))
         (offs (make-list n)))
    (loop for color in stops
          for i from 0
          for given = (fifth color)
          when (numberp given)
            do (setf (nth i offs) (max 0d0 (min 1d0 (float given 1d0)))))
    (unless (numberp (nth 0 offs))
      (setf (nth 0 offs) 0d0))
    (unless (numberp (nth (1- n) offs))
      (setf (nth (1- n) offs) 1d0))
    (loop for i from 0 below n
          unless (numberp (nth i offs))
            do (let* ((start (loop for j from (1- i) downto 0
                                   when (numberp (nth j offs)) return j))
                      (end (loop for j from (1+ i) below n
                                 when (numberp (nth j offs)) return j))
                      (span (- end start)))
                 (setf (nth i offs)
                       (+ (nth start offs)
                          (* (/ (- i start) span)
                             (- (nth end offs) (nth start offs)))))))
    offs))

(defun radial-center (value origin size)
  "Pixel position of one radial-gradient center component."
  (cond ((or (eq value :center) (null value)) (+ origin (* 0.5d0 size)))
        ((numberp value) (+ origin value))
        ((and (consp value) (eq (car value) :%))
         (+ origin (* 0.01d0 (float (cdr value) 1d0) size)))
        ((or (eq value :left) (eq value :top)) origin)
        ((or (eq value :right) (eq value :bottom)) (+ origin size))
        (t (+ origin (* 0.5d0 size)))))

(defun radial-radius (extent cx cy x y w h)
  "Ending radius. closest-side meets the nearest edge; otherwise the farthest corner."
  (let ((left (- cx x))
        (right (- (+ x w) cx))
        (top (- cy y))
        (bottom (- (+ y h) cy)))
    (if (eq extent :closest-side)
        (min left right top bottom)
        (sqrt (max (+ (expt left 2) (expt top 2))
                   (+ (expt right 2) (expt top 2))
                   (+ (expt left 2) (expt bottom 2))
                   (+ (expt right 2) (expt bottom 2)))))))

(defun paint-background-gradient (cr box)
  "Paint a linear-gradient across the border box. The default runs top to bottom."
  (let* ((st (box-style box))
         (raw (and st (computed-background-gradient st)))
         (repeating (and (consp raw) (eq (car raw) :repeat)))
         (spec (if repeating (cdr raw) raw))
         (dir (cond ((or (keywordp (car spec)) (numberp (car spec))) (car spec))
                    (t :bottom)))
         (stops (if (or (keywordp (car spec)) (numberp (car spec))) (cdr spec) spec)))
    (when (and stops (> (length stops) 1)
               (> (box-w box) 0d0) (> (box-h box) 0d0))
      (multiple-value-bind (x0 y0 x1 y1)
          (let ((x (box-x box)) (y (box-y box)) (w (box-w box)) (h (box-h box)))
            (cond
              ((numberp dir)
               (let* ((rad (* dir (/ pi 180d0)))
                      (dx (sin rad))
                      (dy (- (cos rad)))
                      (half (* 0.5d0 (+ (abs (* w dx)) (abs (* h dy)))))
                      (cx (+ x (* 0.5d0 w)))
                      (cy (+ y (* 0.5d0 h))))
                 (values (- cx (* dx half)) (- cy (* dy half))
                         (+ cx (* dx half)) (+ cy (* dy half)))))
              (t
               (case dir
                 (:right (values x y (+ x w) y))
                 (:left (values (+ x w) y x y))
                 (:top (values x (+ y h) x y))
                 (t (values x y x (+ y h)))))))
        (let* ((extent (if (and (eq dir :radial) (keywordp (car stops)))
                           (car stops)
                           :farthest-corner))
               (at-x (if (eq dir :radial) (second stops) :center))
               (at-y (if (eq dir :radial) (third stops) :center))
               (colors (if (eq dir :radial) (cdddr stops) stops))
               (raw-offsets (gradient-stop-offsets colors))
               (period (if repeating (or (car (last raw-offsets)) 1d0) 1d0))
               (period (if (and repeating (> period 0d0) (< period 1d0)) period 1d0))
               (pat (if (eq dir :radial)
                        (let* ((cx (radial-center at-x (box-x box) (box-w box)))
                               (cy (radial-center at-y (box-y box) (box-h box)))
                               (r (radial-radius extent cx cy (box-x box) (box-y box)
                                                 (box-w box) (box-h box))))
                          (cairo-pattern-create-radial cx cy 0d0 cx cy r))
                        (cairo-pattern-create-linear x0 y0
                                                     (+ x0 (* (- x1 x0) period))
                                                     (+ y0 (* (- y1 y0) period)))))
               (offsets (if (< period 1d0)
                            (mapcar (lambda (o) (/ o period)) raw-offsets)
                            raw-offsets)))
          (when repeating (cairo-pattern-set-extend pat 1))
          (loop for color in colors
                for offset in offsets
                do (cairo-pattern-add-color-stop-rgba
                    pat offset
                    (or (first color) 0d0) (or (second color) 0d0)
                    (or (third color) 0d0) (or (fourth color) 1d0)))
          (cairo-save cr)
          (cairo-set-source cr pat)
          (rounded-rect cr (box-x box) (box-y box) (box-w box) (box-h box)
                        (or (computed-radius st) 0d0))
          (cairo-fill cr)
          (cairo-restore cr)
          (cairo-pattern-destroy pat))))))

(defun paint-background-image (cr box)
  "Paint a background-image in the padding box. The default tiles it; no-repeat paints it once."
  (let* ((st (box-style box))
         (url (and st (computed-background-image st))))
    (when (and (stringp url) (plusp (length url)))
      (let* ((path (image-pathname url))
             (surface (and path (load-image-surface path)))
             (repeat (or (and st (computed-background-repeat st)) :repeat)))
        (when surface
          (multiple-value-bind (bt br bb bl) (border4 st)
            (let* ((x (+ (box-x box) bl))
                   (y (+ (box-y box) bt))
                   (w (max 0d0 (- (box-w box) bl br)))
                   (h (max 0d0 (- (box-h box) bt bb)))
                   (iw (float (cairo-image-surface-get-width surface) 1d0))
                   (ih (float (cairo-image-surface-get-height surface) 1d0))
                   (tile-x (member repeat '(:repeat :repeat-x)))
                   (tile-y (member repeat '(:repeat :repeat-y)))
                   (pos (or (computed-background-position st) :left))
                   (horizontal (cond ((member pos '(:top :bottom)) :left)
                                     ((and (consp pos) (not (eq (car pos) :%))) (first pos))
                                     (t pos)))
                   (vertical (cond ((member pos '(:top :bottom)) pos)
                                   ((and (consp pos) (not (eq (car pos) :%))) (or (second pos) :top))
                                   (t :top)))
                   (size (or (computed-background-size st) :auto))
                   (scale (cond ((not (and (> iw 0d0) (> ih 0d0) (> w 0d0) (> h 0d0)))
                                 1d0)
                                ((eq size :contain) (min (/ w iw) (/ h ih)))
                                ((eq size :cover) (max (/ w iw) (/ h ih)))
                                (t 1d0)))
                   (explicit (consp size))
                   (tw-spec (and explicit (background-length (first size) w)))
                   (th-spec (and explicit (background-length (second size) h)))
                   (tw (cond (tw-spec tw-spec)
                             ((and th-spec (> ih 0d0)) (* th-spec (/ iw ih)))
                             (t (* iw scale))))
                   (th (cond (th-spec th-spec)
                             ((and tw-spec (> iw 0d0)) (* tw-spec (/ ih iw)))
                             (t (* ih scale))))
                   (sx (if (> iw 0d0) (/ tw iw) 1d0))
                   (sy (if (> ih 0d0) (/ th ih) 1d0)))
              (let ((origin (or (computed-background-origin st) :padding-box)))
                (when (eq origin :content-box)
                  (multiple-value-bind (pt pr pb pl) (pad4 st (box-w box))
                    (incf x pl)
                    (incf y pt)
                    (setf w (max 0d0 (- w pl pr))
                          h (max 0d0 (- h pt pb)))))
                (when (eq origin :border-box)
                  (decf x bl)
                  (decf y bt)
                  (incf w (+ bl br))
                  (incf h (+ bt bb)))
                (let ((x0 (background-position-offset horizontal w tw x))
                      (y0 (background-position-offset vertical h th y)))
                  (multiple-value-bind (cx cy cw ch)
                      (let ((clip (or (computed-background-clip st) :border-box)))
                        (multiple-value-bind (pt pr pb pl) (pad4 st (box-w box))
                          (cond
                            ((eq clip :content-box)
                             (values (+ (box-x box) bl pl)
                                     (+ (box-y box) bt pt)
                                     (max 0d0 (- (box-w box) bl br pl pr))
                                     (max 0d0 (- (box-h box) bt bb pt pb))))
                            ((eq clip :padding-box)
                             (values (+ (box-x box) bl)
                                     (+ (box-y box) bt)
                                     (max 0d0 (- (box-w box) bl br))
                                     (max 0d0 (- (box-h box) bt bb))))
                            (t
                             (values (box-x box) (box-y box) (box-w box) (box-h box))))))
                    (when (and (> cw 0d0) (> ch 0d0) (> iw 0d0) (> ih 0d0))
                      (when tile-x
                        (loop while (> x0 x) do (decf x0 tw)))
                      (when tile-y
                        (loop while (> y0 y) do (decf y0 th)))
                      (cairo-save cr)
                      (cairo-rectangle cr cx cy cw ch)
                      (cairo-clip cr)
                      (loop for yy = y0 then (+ yy th)
                            while (and (< yy (+ y h)) (or tile-y (= yy y0)))
                            do (loop for xx = x0 then (+ xx tw)
                                     while (and (< xx (+ x w)) (or tile-x (= xx x0)))
                                     do (cairo-save cr)
                                        (cairo-translate cr xx yy)
                                        (cairo-scale cr sx sy)
                                        (cairo-set-source-surface cr surface 0d0 0d0)
                                        (cairo-paint cr)
                                        (cairo-restore cr)))
                      (cairo-restore cr))))))))))))

(defun paint-image (cr box)
  "Paint a replaced image into its content box, honoring object-fit."
  (let* ((el (box-element box))
         (path (and el (image-pathname (dom-attr el "src"))))
         (surface (and path (load-image-surface path)))
         (st (box-style box)))
    (when (and el st)
    (multiple-value-bind (bt br bb bl) (border4 st)
      (multiple-value-bind (pt pr pb pl) (pad4 st (box-w box))
        (cond
          (surface
           (paint-surface-in-box cr surface
                                 (+ (box-x box) bl pl)
                                 (+ (box-y box) bt pt)
                                 (max 0d0 (- (box-w box) bl br pl pr))
                                 (max 0d0 (- (box-h box) bt bb pt pb))
                                 :fit (or (computed-object-fit st) :fill)))
          (t
           (let ((alt (dom-attr el "alt")))
             (when (and alt (plusp (length alt)))
               (let ((x (+ (box-x box) bl pl))
                     (y (+ (box-y box) bt pt))
                     (w (max 0d0 (- (box-w box) bl br pl pr)))
                     (h (max 0d0 (- (box-h box) bt bb pt pb))))
                 (cairo-save cr)
                 (cairo-rectangle cr x y w h)
                 (cairo-clip cr)
                 (set-color cr (computed-color st))
                 (cairo-select-font-face cr
                                         (cairo-family (computed-font-family st))
                                         (cairo-slant (computed-font-style st))
                                         (cairo-weight (computed-font-weight st)))
                 (cairo-set-font-size cr (computed-font-size st))
                 (cairo-move-to cr x
                                (+ y (font-ascent (computed-font-size st)
                                                  (computed-font-family st)
                                                  (computed-font-weight st)
                                                  (computed-font-style st))))
                 (cairo-show-text cr alt)
                 (cairo-restore cr)))))))))))

(defun paint-control (cr box)
  "Draw the value of an input, select, or textarea. Buttons paint their own text."
  (let* ((el (box-element box))
         (st (box-style box))
         (label (and el (control-label el))))
    (when (and st label (plusp (length label)))
      (multiple-value-bind (bt br bb bl) (border4 st)
        (declare (ignore br bb))
        (multiple-value-bind (pt pr pb pl) (pad4 st (box-w box))
          (declare (ignore pr pb))
          (set-color cr (computed-color st))
          (cairo-select-font-face cr
                                  (cairo-family (computed-font-family st))
                                  (cairo-slant (computed-font-style st))
                                  (cairo-weight (computed-font-weight st)))
          (cairo-set-font-size cr (computed-font-size st))
          (cairo-move-to cr (+ (box-x box) bl pl)
                         (+ (box-y box) bt pt
                            (font-ascent (computed-font-size st)
                                         (computed-font-family st)
                                         (computed-font-weight st)
                                         (computed-font-style st))))
          (cairo-show-text cr label))))))

(defun paint-text-box (cr box)
  (let ((st (box-style box))
        (text (box-text box)))
    (when (and st text (plusp (length text)))
      (set-color cr (computed-color st))
      (cairo-select-font-face cr
                              (cairo-family (computed-font-family st))
                              (cairo-slant (computed-font-style st))
                              (cairo-weight (computed-font-weight st)))
      (cairo-set-font-size cr (computed-font-size st))
      (let ((baseline (+ (box-y box)
                          (or (box-baseline box)
                              (font-ascent (computed-font-size st)
                                           (computed-font-family st)
                                           (computed-font-weight st)
                                           (computed-font-style st))))))
        (labels ((show-at (ox oy)
                   (let ((spacing (computed-letter-spacing st)))
                     (if (and (numberp spacing) (not (zerop spacing)) (> (length text) 1))
                         (let ((x ox))
                           (loop for i from 0 below (length text)
                                 for ch = (subseq text i (1+ i))
                                 for adv = (text-advance ch (computed-font-size st)
                                                         (computed-font-family st)
                                                         (computed-font-weight st)
                                                         (computed-font-style st))
                                 do (cairo-move-to cr x oy)
                                    (cairo-show-text cr ch)
                                    (incf x (+ adv (if (< i (1- (length text))) spacing 0d0)))))
                         (progn
                           (cairo-move-to cr ox oy)
                           (cairo-show-text cr text))))))
          (dolist (sh (reverse (computed-text-shadow st)))
            (destructuring-bind (dx dy color) sh
              (set-color cr (color-or color st))
              (show-at (+ (box-x box) dx) (+ baseline dy))))
          (set-color cr (computed-color st))
          (show-at (box-x box) baseline))
        (paint-text-decorations cr box baseline)))))

(defun paint-text-decorations (cr box baseline)
  "Underline, overline, and strike-through from BOX and its ancestors, each in that element's color."
  (loop for el = (box-element box) then (dom-node-parent el)
        while (dom-element-p el)
        for st = (dom-element-style el)
        for kinds = (let ((kind (and st (computed-text-decoration st))))
                      (cond ((or (null kind) (eq kind :none)) nil)
                            ((keywordp kind) (list kind))
                            (t kind)))
        do (dolist (kind kinds)
             (when (member kind '(:underline :overline :line-through))
               (let* ((size (computed-font-size st))
                      (thick (computed-text-decoration-thickness st))
                      (width (if (and (numberp thick) (> thick 0d0))
                                 thick
                                 (max 1d0 (* 0.06d0 size)))))
                 (set-color cr (color-or (computed-text-decoration-color st) st))
                 (if (eq kind :overline)
                     (let ((top (+ 1d0
                                   (- baseline
                                      (font-ascent size
                                                   (computed-font-family st)
                                                   (computed-font-weight st)
                                                   (computed-font-style st))))))
                       (cairo-rectangle cr (box-x box) top (box-w box) width)
                       (cairo-fill cr))
                     (let ((y (if (eq kind :underline)
                                  (+ baseline (* 0.15d0 size)
                                     (or (computed-text-underline-offset st) 0d0))
                                  (- baseline (* 0.30d0 size))))
                           (style (or (computed-text-decoration-style st) :solid)))
                       (cairo-set-line-width cr width)
                       (flet ((stroke-line ()
                                (cairo-move-to cr (box-x box) y)
                                (cairo-line-to cr (+ (box-x box) (box-w box)) y)
                                (cairo-stroke cr)))
                         (cond
                           ((eq style :dashed)
                            (cffi:with-foreign-object (dash :double 2)
                              (setf (cffi:mem-aref dash :double 0) (* 3d0 width)
                                    (cffi:mem-aref dash :double 1) (* 2d0 width))
                              (cairo-set-dash cr dash 2 0d0)
                              (stroke-line)
                              (cairo-set-dash cr (cffi:null-pointer) 0 0d0)))
                           ((eq style :dotted)
                            (cffi:with-foreign-object (dash :double 2)
                              (setf (cffi:mem-aref dash :double 0) width
                                    (cffi:mem-aref dash :double 1) width)
                              (cairo-set-dash cr dash 2 0d0)
                              (stroke-line)
                              (cairo-set-dash cr (cffi:null-pointer) 0 0d0)))
                           ((eq style :wavy)
                            (let* ((x0 (box-x box))
                                   (x1 (+ x0 (box-w box)))
                                   (amp 4d0)
                                   (period 12d0))
                              (cairo-move-to cr x0 y)
                              (loop for x from (+ x0 1d0) to x1 by 1d0
                                    do (cairo-line-to
                                        cr x
                                        (+ y (* amp (sin (* 2d0 pi (/ (- x x0) period)))))))
                              (cairo-stroke cr)))
                           ((eq style :double)
                            (stroke-line)
                            (setf y (+ y (max 4d0 (* 3d0 width))))
                            (stroke-line))
                           (t (stroke-line)))))))))))

(defun apply-transform (cr box)
  (let ((ops (and (box-style box) (computed-transform (box-style box))))
        (ox (+ (box-x box) (/ (box-w box) 2d0)))
        (oy (+ (box-y box) (/ (box-h box) 2d0))))
    (when ops
      (cairo-translate cr ox oy)
      (dolist (op ops)
        (case (car op)
          (:translate
           (let ((tx (or (resolve-px (second op) (box-w box)) 0d0))
                 (ty (or (resolve-px (third op) (box-h box)) 0d0)))
             (cairo-translate cr tx ty)))
          (:scale (cairo-scale cr (float (second op) 1d0) (float (third op) 1d0)))
          (:rotate (cairo-rotate cr (float (second op) 1d0)))))
      (cairo-translate cr (- ox) (- oy)))))

(defun background-clip-rect (box)
  "Origin and size of a background, honoring background-clip. The default is the border box."
  (let* ((st (box-style box))
         (clip (or (and st (computed-background-clip st)) :border-box))
         (x (box-x box))
         (y (box-y box))
         (w (box-w box))
         (h (box-h box)))
    (when (and st (member clip '(:padding-box :content-box)))
      (multiple-value-bind (bt br bb bl) (border4 st)
        (multiple-value-bind (pt pr pb pl) (pad4 st (box-w box))
          (incf x bl)
          (incf y bt)
          (decf w (+ bl br))
          (decf h (+ bt bb))
          (when (eq clip :content-box)
            (incf x pl)
            (incf y pt)
            (decf w (+ pl pr))
            (decf h (+ pt pb))))))
    (values x y (max 0d0 w) (max 0d0 h))))

(defun background-style (box)
  "Style whose background fills BOX. Nested inline text uses an ancestor's."
  (or (and (box-style box) (computed-background (box-style box)) (box-style box))
      (and (eq (box-kind box) :text)
           (loop for el = (and (box-element box) (dom-node-parent (box-element box)))
                   then (dom-node-parent el)
                 while (and (dom-element-p el)
                            (dom-element-style el)
                            (eq (computed-display (dom-element-style el)) :inline))
                 when (computed-background (dom-element-style el))
                   return (dom-element-style el)))))

(defun paint-marker (cr box)
  "Paint a list marker. Decimal markers are the item number; others are a bullet."
  (let ((marker (box-marker box))
        (st (box-style box)))
    (when (and marker st (not (eq marker :none)))
      (set-color cr (computed-color st))
      (if (stringp marker)
          (let* ((size (computed-font-size st))
                 (family (computed-font-family st))
                 (weight (computed-font-weight st))
                 (fstyle (computed-font-style st))
                 (adv (text-advance marker size family weight fstyle)))
            (cairo-select-font-face cr (cairo-family family)
                                    (cairo-slant fstyle)
                                    (cairo-weight weight))
            (cairo-set-font-size cr size)
            (let ((tx (if (box-marker-inside box)
                          (+ (box-x box) (px (computed-pl st) (box-w box))
                             (used-border-width (computed-bl st) (computed-bls st)))
                          (- (box-x box) adv 6d0))))
              (cairo-move-to cr tx
                             (+ (box-y box)
                                (font-ascent size family weight fstyle)))
              (cairo-show-text cr marker)))
          (let* ((cy (+ (box-y box) 8d0))
                 (cx (if (box-marker-inside box)
                         (+ (box-x box) 6d0
                            (px (computed-pl st) (box-w box))
                            (used-border-width (computed-bl st) (computed-bls st)))
                         (- (box-x box) 10d0))))
            (cond
              ((paint-list-style-image cr st cx cy))
              ((eq marker :square)
               (cairo-rectangle cr (- cx 2.5d0) (- cy 2.5d0) 5d0 5d0)
               (cairo-fill cr))
              ((eq marker :circle)
               (cairo-set-line-width cr 1d0)
               (cairo-arc cr cx cy 2.5d0 0d0 (* 2d0 pi))
               (cairo-stroke cr))
              (t
               (cairo-arc cr cx cy 2.5d0 0d0 (* 2d0 pi))
               (cairo-fill cr))))))))

(defun paint-list-style-image (cr st cx cy)
  "Paint a list-style-image centered on the marker. Returns T when an image was drawn."
  (let* ((url (and st (computed-list-style-image st)))
         (path (and (stringp url) (image-pathname url)))
         (surface (and path (load-image-surface path))))
    (when surface
      (let* ((iw (float (cairo-image-surface-get-width surface) 1d0))
             (ih (float (cairo-image-surface-get-height surface) 1d0))
             (side 8d0)
             (sx (if (> iw 0d0) (/ side iw) 1d0))
             (sy (if (> ih 0d0) (/ side ih) 1d0)))
        (cairo-save cr)
        (cairo-translate cr (- cx (/ side 2d0)) (- cy (/ side 2d0)))
        (cairo-scale cr sx sy)
        (cairo-set-source-surface cr surface 0d0 0d0)
        (cairo-paint cr)
        (cairo-restore cr)
        t))))

(defun paint-box-shadow (cr box)
  "Paint solid outer shadows behind the box. They do not change layout."
  (let ((shadows (and (box-style box) (computed-box-shadow (box-style box)))))
    (dolist (sh (reverse shadows))
      (destructuring-bind (dx dy color inset) sh
        (when (and (not inset) (> (box-w box) 0d0) (> (box-h box) 0d0))
          (set-color cr (color-or color (box-style box)))
          (cairo-rectangle cr (+ (box-x box) dx) (+ (box-y box) dy)
                           (box-w box) (box-h box))
          (cairo-fill cr))))))

(defun paint-inset-shadow (cr box)
  "Paint solid inset shadows inside the box edge."
  (let ((shadows (and (box-style box) (computed-box-shadow (box-style box))))
        (x (box-x box)) (y (box-y box)) (w (box-w box)) (h (box-h box)))
    (when (and (> w 0d0) (> h 0d0))
      (dolist (sh (reverse shadows))
        (destructuring-bind (dx dy color inset) sh
          (when inset
            (set-color cr (color-or color (box-style box)))
            (when (> dx 0d0)
              (cairo-rectangle cr x y (min dx w) h)
              (cairo-fill cr))
            (when (< dx 0d0)
              (cairo-rectangle cr (+ x w dx) y (min (- dx) w) h)
              (cairo-fill cr))
            (when (> dy 0d0)
              (cairo-rectangle cr x y w (min dy h))
              (cairo-fill cr))
            (when (< dy 0d0)
              (cairo-rectangle cr x (+ y h dy) w (min (- dy) h))
              (cairo-fill cr))))))))

(defun box-has-visible-content-p (box)
  (when box
    (or (and (eq (box-kind box) :text)
             (notevery #'whitespace-char-p (or (box-text box) "")))
        (and (box-tag box)
             (member (box-tag box) '("img" "svg" "video" "canvas" "input" "select" "textarea")
                     :test #'string=))
        (some #'box-has-visible-content-p (box-children box)))))

(defun hide-empty-cell-p (box)
  "empty-cells: hide suppresses the border and background of an empty cell.
It does not apply when borders are collapsed."
  (and (box-style box)
       (member (box-tag box) '("td" "th") :test #'string=)
       (eq (computed-empty-cells (box-style box)) :hide)
       (not (eq (computed-border-collapse (box-style box)) :collapse))
       (not (box-has-visible-content-p box))))

(defun paint-box (cr box &optional (scroll-y 0d0))
  (when (and box (or (null (box-style box))
                     (not (eq (computed-visibility (box-style box)) :hidden))))
    (let ((sticky (or (box-sticky-top box) 0d0))
          (dy 0d0))
      (when (and (box-sticky-top box) (box-style box)
                 (eq (computed-position (box-style box)) :sticky))
        (setf dy (max 0d0 (- (+ scroll-y sticky) (box-y box)))))
      (cairo-save cr)
      (when (/= dy 0d0) (cairo-translate cr 0d0 dy))
      (apply-transform cr box)
      (let ((opacity (if (box-style box) (computed-opacity (box-style box)) 1d0)))
        (when (< opacity 1d0) (cairo-push-group cr))
        (let ((skip-chrome (hide-empty-cell-p box)))
          (unless skip-chrome
            (paint-box-shadow cr box)
            (let ((bg (background-style box)))
              (when (and bg (> (box-w box) 0d0) (> (box-h box) 0d0))
                (multiple-value-bind (x y w h) (background-clip-rect box)
                  (when (and (> w 0d0) (> h 0d0))
                    (set-color cr (color-or (computed-background bg) bg))
                    (rounded-rect cr x y w h
                                  (or (and (box-style box) (computed-radius (box-style box))) 0d0))
                    (cairo-fill cr)))))
            (paint-background-gradient cr box)
            (paint-inset-shadow cr box)
            (paint-background-image cr box)
            (paint-border cr box)
            (paint-outline cr box)))
        (paint-marker cr box)
        (if (eq (box-kind box) :text)
            (paint-text-box cr box)
            (progn
              (when (and (box-tag box) (string= (box-tag box) "img"))
                (paint-image cr box))
              (when (and (box-tag box) (string= (box-tag box) "svg"))
                (paint-svg cr box))
              (when (and (box-tag box)
                         (member (box-tag box) '("input" "select" "textarea") :test #'string=))
                (paint-control cr box))
              (when (and (box-style box)
                         (member (computed-overflow (box-style box)) '(:hidden :clip :scroll :auto)))
                (cairo-rectangle cr (box-x box) (box-y box) (box-w box) (box-h box))
                (cairo-clip cr))
              (dolist (c (box-children box))
                (paint-box cr c scroll-y))))
        (when (< opacity 1d0)
          (cairo-pop-group-to-source cr)
          (cairo-paint-with-alpha cr opacity)))
      (cairo-restore cr))))

(defun paint-cr (cr root width height &key (scroll-y 0d0))
  "Paint ROOT into an existing Cairo context. PNG and windows both use this."
  (cairo-set-source-rgba cr 1d0 1d0 1d0 1d0)
  (cairo-paint cr)
  (cairo-rectangle cr 0d0 0d0 (float width 1d0) (float height 1d0))
  (cairo-clip cr)
  (when (> scroll-y 0d0)
    (cairo-translate cr 0d0 (- (float scroll-y 1d0))))
  (paint-box cr root scroll-y))

(defun paint-png (root pathname width height &key (scroll-y 0d0))
  (ensure-cairo)
  (let* ((w (max 1 (round width)))
         (h (max 1 (round height)))
         (surface (cairo-image-surface-create 0 w h))
         (cr (cairo-create surface)))
    (unwind-protect
         (progn
           (paint-cr cr root w h :scroll-y scroll-y)
           (cairo-surface-flush surface)
           (let ((status (cairo-surface-write-to-png surface (namestring pathname))))
             (unless (zerop status)
               (error "Cairo PNG write failed: ~A" (cairo-status-to-string status)))))
      (cairo-destroy cr)
      (cairo-surface-destroy surface)))
  pathname)

(cffi:define-foreign-library x11
  (:unix (:or "libX11.so.6" "libX11.so"))
  (t (:default "X11")))

(cffi:defcfun ("XOpenDisplay" x-open-display) :pointer (name :pointer))
(cffi:defcfun ("XCloseDisplay" x-close-display) :int (display :pointer))
(cffi:defcfun ("XDefaultRootWindow" x-default-root-window) :unsigned-long (display :pointer))
(cffi:defcfun ("XDefaultScreen" x-default-screen) :int (display :pointer))
(cffi:defcfun ("XDefaultVisual" x-default-visual) :pointer (display :pointer) (screen :int))
(cffi:defcfun ("XCreateSimpleWindow" x-create-simple-window) :unsigned-long
  (display :pointer) (parent :unsigned-long) (x :int) (y :int)
  (width :unsigned-int) (height :unsigned-int) (border :unsigned-int)
  (border-pixel :unsigned-long) (background :unsigned-long))
(cffi:defcfun ("XMapWindow" x-map-window) :int (display :pointer) (window :unsigned-long))
(cffi:defcfun ("XStoreName" x-store-name) :int
  (display :pointer) (window :unsigned-long) (name :string))
(cffi:defcfun ("XFlush" x-flush) :int (display :pointer))
(cffi:defcfun ("XSelectInput" x-select-input) :int
  (display :pointer) (window :unsigned-long) (mask :long))
(cffi:defcfun ("XNextEvent" x-next-event) :int (display :pointer) (event :pointer))
(cffi:defcfun ("XLookupString" x-lookup-string) :int
  (event :pointer) (buffer :pointer) (nbytes :int) (keysym :pointer) (status :pointer))

(defun document-extent (box)
  "Bottom of the furthest descendant, in document pixels."
  (let ((bottom 0d0))
    (labels ((walk (b)
               (when b
                 (setf bottom (max bottom (+ (box-y b) (box-h b))))
                 (dolist (c (box-children b)) (walk c)))))
      (walk box))
    bottom))

(defun clamp-scroll (scroll viewport extent)
  (max 0d0 (min (max 0d0 (- extent viewport)) (float scroll 1d0))))

(defun scroll-step (scroll command viewport extent)
  "New scroll offset after a pointer or keyboard command."
  (case command
    (:home 0d0)
    (:end (clamp-scroll extent viewport extent))
    (t (let ((delta (case command
                      (:wheel-up -48d0)
                      (:wheel-down 48d0)
                      (:line-up -24d0)
                      (:line-down 24d0)
                      (:page-up (- viewport))
                      (:page-down viewport)
                      (t 0d0))))
         (clamp-scroll (+ scroll delta) viewport extent)))))

(defun event-scroll-command (kind detail &optional (state 0))
  "Map an X button number or keysym to a scroll command. :QUIT leaves the window.
STATE is the X modifier mask: shift is 1, alt is 8."
  (cond
    ((and (eq kind :button) (= detail 4)) :wheel-up)
    ((and (eq kind :button) (= detail 5)) :wheel-down)
    ((eq kind :key)
     (cond
       ((= detail #xff52) :line-up)
       ((= detail #xff54) :line-down)
       ((= detail #xff55) :page-up)
       ((= detail #xff56) :page-down)
       ((= detail #xff50) :home)
       ((= detail #xff57) :end)
       ((or (= detail #x71) (= detail #x51) (= detail #xff1b)) :quit)
       ((and (= detail #xff08) (plusp (logand state 1))) :forward)
       ((= detail #xff08) :back)
       ((and (= detail #xff53) (plusp (logand state 8))) :forward)
       ((and (= detail #xff51) (plusp (logand state 8))) :back)))
    (t nil)))

(defun document-title (root)
  "Text of the document's title element, or NIL."
  (let ((doc (and root (box-element root))))
    (when (dom-element-p doc)
      (let ((title (find-element doc "title")))
        (when title
          (let ((text (string-trim '(#\space #\tab #\newline #\return #\page)
                                   (dom-text-content title))))
            (when (plusp (length text)) text)))))))

(defun window-title (root base &optional fallback)
  "Prefer the document title, then the URL, then FALLBACK."
  (let ((title (document-title root)))
    (cond
      ((and title (plusp (length title)))
       (concatenate 'string title " — Closure"))
      ((and (stringp base) (plusp (length base)))
       (concatenate 'string "Closure — " base))
      ((and (stringp fallback) (plusp (length fallback))) fallback)
      (t "Closure"))))

(defun paint-window (root &key (width 800) (height 600) (scroll-y 0d0) (title "Closure"))
  "Paint ROOT into an X11 window using paint-cr, the same path as paint-png.
Returns NIL when no display can be opened. The caller must close the display
with close-window."
  (handler-case
      (progn
        (cffi:use-foreign-library x11)
        (let ((display (x-open-display (cffi:null-pointer))))
          (when (cffi:null-pointer-p display)
            (return-from paint-window nil))
          (let* ((screen (x-default-screen display))
                 (visual (x-default-visual display screen))
                 (window (x-create-simple-window display
                                                 (x-default-root-window display)
                                                 0 0 width height 0 0 0)))
            (x-store-name display window title)
            (x-map-window display window)
            (let ((surface (cairo-xlib-surface-create display window visual width height)))
              (unwind-protect
                   (let ((cr (cairo-create surface)))
                     (unwind-protect
                          (paint-cr cr root width height :scroll-y scroll-y)
                       (cairo-destroy cr)))
                (cairo-surface-destroy surface)))
            (x-flush display)
            display)))
    (error () nil)))

(defun browse-history-start (root base)
  "History is (past current future). CURRENT is (root base scroll)."
  (list nil (list root base 0d0) nil))

(defun browse-history-current (history)
  (second history))

(defun browse-history-go (history root base scroll)
  "Leave the current page at SCROLL and open ROOT. The forward list is cleared."
  (let ((current (browse-history-current history)))
    (when current
      (setf (third current) (float scroll 1d0)))
    (list (cons current (first history))
          (list root base 0d0)
          nil)))

(defun browse-history-back (history)
  "Move to the previous page, keeping the current one available for forward."
  (let ((past (first history))
        (current (second history))
        (future (third history)))
    (if past
        (list (cdr past) (car past) (cons current future))
        history)))

(defun browse-history-forward (history)
  "Move to the page that back just left. Unchanged when there is none."
  (let ((past (first history))
        (current (second history))
        (future (third history)))
    (if future
        (list (cons current past) (car future) (cdr future))
        history)))

(defvar *activate-link* nil
  "Function of (root x y scroll base width height) that loads a clicked link.
Returns the new root and base, or NIL.")

(defun run-window (root &key (width 800) (height 600) (title "Closure") base)
  "Map an X11 window and scroll ROOT from the wheel and the arrow keys.
q or Escape closes it. Repaints with paint-cr. Returns NIL when no display
can be opened."
  (handler-case
      (progn
        (cffi:use-foreign-library x11)
        (ensure-cairo)
        (let ((display (x-open-display (cffi:null-pointer))))
          (when (cffi:null-pointer-p display)
            (return-from run-window nil))
          (unwind-protect
               (let* ((screen (x-default-screen display))
                      (visual (x-default-visual display screen))
                      (window (x-create-simple-window display
                                                      (x-default-root-window display)
                                                      0 0 width height 0 0 0))
                      (extent (document-extent root))
                      (scroll 0d0)
                      (page root)
                      (page-base base)
                      (history (browse-history-start root base))
                      (view (float height 1d0)))
                 (x-store-name display window (window-title page page-base title))
                 (x-select-input display window (logior 1 4 32768))
                 (x-map-window display window)
                 (let ((surface (cairo-xlib-surface-create display window visual width height)))
                   (unwind-protect
                        (cffi:with-foreign-objects ((event :unsigned-char 192)
                                                    (keysym :unsigned-long)
                                                    (buf :char 8))
                          (loop
                            (let ((cr (cairo-create surface)))
                              (unwind-protect
                                   (paint-cr cr page width height :scroll-y scroll)
                                (cairo-destroy cr)))
                            (x-flush display)
                            (x-next-event display event)
                            (let ((type (cffi:mem-ref event :int)))
                              (cond
                                ((= type 4)
                                 (let* ((button (cffi:mem-ref event :unsigned-int 84))
                                        (cmd (event-scroll-command :button button)))
                                   (cond
                                     (cmd
                                      (setf scroll (scroll-step scroll cmd view extent)))
                                     ((and (= button 1) *activate-link*)
                                      (multiple-value-bind (new-root new-base departed)
                                          (funcall *activate-link* page
                                                   (cffi:mem-ref event :int 64)
                                                   (cffi:mem-ref event :int 68)
                                                   scroll page-base width height)
                                        (when new-root
                                          (dolist (entry departed)
                                            (setf history (browse-history-go history
                                                                             (first entry)
                                                                             (second entry)
                                                                             scroll)))
                                          (setf history (browse-history-go history new-root new-base scroll)
                                                page new-root
                                                page-base new-base
                                                scroll 0d0
                                                extent (document-extent new-root))
                                          (x-store-name display window (window-title page page-base))))))))
                                ((= type 2)
                                 (x-lookup-string event buf 8 keysym (cffi:null-pointer))
                                 (let ((cmd (event-scroll-command
                                             :key (cffi:mem-ref keysym :unsigned-long)
                                             (cffi:mem-ref event :unsigned-int 80))))
                                   (labels ((show (entry)
                                              (setf page (first entry)
                                                    page-base (second entry)
                                                    scroll (third entry)
                                                    extent (document-extent page))
                                              (x-store-name display window (window-title page page-base))))
                                     (cond
                                       ((eq cmd :quit) (return))
                                       ((eq cmd :back)
                                        (let ((older (browse-history-back history)))
                                          (when (not (eq older history))
                                            (setf history older)
                                            (show (browse-history-current history)))))
                                       ((eq cmd :forward)
                                        (let ((newer (browse-history-forward history)))
                                          (when (not (eq newer history))
                                            (setf history newer)
                                            (show (browse-history-current history)))))
                                       (cmd
                                        (setf scroll (scroll-step scroll cmd view extent)))))))))))
                     (cairo-surface-destroy surface))))
            (x-close-display display))))
    (error () nil)))

(defun close-window (display)
  (when (and display (not (cffi:null-pointer-p display)))
    (ignore-errors (x-close-display display)))
  nil)

(defun count-ink (pathname)
  "Count pixels in a PNG that are not opaque white. Used by the renderer tests."
  (ensure-cairo)
  (let* ((surface (cairo-image-surface-create-from-png (namestring pathname)))
         (w 0) (h 0) (ink 0))
    (unwind-protect
         (progn
           (cairo-surface-flush surface)
           (setf w (cffi:foreign-funcall "cairo_image_surface_get_width" :pointer surface :int)
                 h (cffi:foreign-funcall "cairo_image_surface_get_height" :pointer surface :int))
           (let* ((data (cairo-image-surface-get-data surface))
                  (stride (cairo-image-surface-get-stride surface)))
             (loop for y below h do
               (loop for x below w do
                 (let ((px (cffi:mem-ref (cffi:inc-pointer data (+ (* y stride) (* x 4))) :uint32)))
                   (unless (= px #xffffffff)
                     (incf ink)))))))
      (cairo-surface-destroy surface))
    ink))
