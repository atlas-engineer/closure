;;; Inline SVG. The path data is parsed in Lisp. Cairo only strokes and fills.

(in-package :closure.engine)

(defun svg-paint (string)
  "A paint color, or NIL for none or an unknown value."
  (cond
    ((or (null string) (zerop (length string)) (string-equal string "none")) nil)
    ((char= (char string 0) #\#)
     (parse-hex-color (subseq string 1)))
    (t (let ((rgb (gethash (string-downcase string) *named-colors*)))
         (when (and rgb (numberp (car rgb)))
           (color-bytes (car rgb) (cadr rgb) (caddr rgb)))))))

(defun svg-number (el name &optional (default 0d0))
  (let ((raw (and (dom-element-p el) (dom-attr el name))))
    (if (and raw (plusp (length raw)))
        (or (ignore-errors (float (read-from-string raw) 1d0)) default)
        default)))

(defun svg-viewbox (el w h)
  (let* ((raw (dom-attr el "viewBox"))
         (i 0)
         (n (if raw (length raw) 0))
         (nums nil))
    (labels ((skip ()
               (loop while (and (< i n)
                                (or (whitespace-char-p (char raw i))
                                    (char= (char raw i) #\,)))
                     do (incf i)))
             (read-one ()
               (skip)
               (when (and (< i n)
                          (or (digit-char-p (char raw i))
                              (find (char raw i) "+-.")))
                 (let ((start i))
                   (when (find (char raw i) "+-") (incf i))
                   (loop while (and (< i n)
                                    (or (digit-char-p (char raw i))
                                        (char= (char raw i) #\.)))
                         do (incf i))
                   (ignore-errors (float (read-from-string (subseq raw start i)) 1d0))))))
      (when raw
        (loop for v = (read-one) while v do (push v nums))))
    (setf nums (nreverse nums))
    (if (and (>= (length nums) 4) (> (third nums) 0d0) (> (fourth nums) 0d0))
        (values (first nums) (second nums) (third nums) (fourth nums))
        (values 0d0 0d0 (or (attr-px el "width") w) (or (attr-px el "height") h)))))

(defun parse-svg-path (d)
  "Absolute path commands: :move, :line, :curve, :close."
  (let ((i 0) (n (length d)) (cmd #\M)
        (cx 0d0) (cy 0d0) (sx 0d0) (sy 0d0)
        (out nil))
    (labels ((peek () (if (< i n) (char d i) nil))
             (skip ()
               (loop while (and (peek)
                                (or (whitespace-char-p (peek)) (char= (peek) #\,)))
                     do (incf i)))
             (read-num ()
               (skip)
               (when (and (peek) (or (digit-char-p (peek)) (find (peek) "+-.")))
                 (let ((start i))
                   (when (find (peek) "+-") (incf i))
                   (loop while (and (peek) (or (digit-char-p (peek)) (char= (peek) #\.)))
                         do (incf i))
                   (when (and (peek) (find (peek) "eE"))
                     (incf i)
                     (when (and (peek) (find (peek) "+-")) (incf i))
                     (loop while (and (peek) (digit-char-p (peek))) do (incf i)))
                   (ignore-errors (float (read-from-string (subseq d start i)) 1d0)))))
             (relp () (lower-case-p cmd))
             (xy ()
               (let ((x (read-num)) (y (read-num)))
                 (when (and x y)
                   (when (relp) (incf x cx) (incf y cy))
                   (values x y)))))
      (loop while (< i n) do
        (let ((before i))
          (skip)
          (when (>= i n) (return))
          (if (alpha-char-p (peek))
              (progn (setf cmd (peek)) (incf i))
              (when (find cmd "Mm")
                (setf cmd (if (upper-case-p cmd) #\L #\l))))
          (case (char-upcase cmd)
            (#\M (multiple-value-bind (x y) (xy)
                   (when x
                     (setf cx x cy y sx x sy y)
                     (push (list :move x y) out)
                     (setf cmd (if (lower-case-p cmd) #\l #\L)))))
            (#\L (multiple-value-bind (x y) (xy)
                   (when x
                     (setf cx x cy y)
                     (push (list :line x y) out))))
            (#\H (let ((x (read-num)))
                   (when x
                     (when (relp) (incf x cx))
                     (setf cx x)
                     (push (list :line cx cy) out))))
            (#\V (let ((y (read-num)))
                   (when y
                     (when (relp) (incf y cy))
                     (setf cy y)
                     (push (list :line cx cy) out))))
            (#\C (let ((x1 (read-num)) (y1 (read-num))
                       (x2 (read-num)) (y2 (read-num))
                       (x (read-num)) (y (read-num)))
                   (when (and x1 y1 x2 y2 x y)
                     (when (relp)
                       (incf x1 cx) (incf y1 cy)
                       (incf x2 cx) (incf y2 cy)
                       (incf x cx) (incf y cy))
                     (push (list :curve x1 y1 x2 y2 x y) out)
                     (setf cx x cy y))))
            (#\Q (let ((qx (read-num)) (qy (read-num)) (x (read-num)) (y (read-num)))
                   (when (and qx qy x y)
                     (when (relp)
                       (incf qx cx) (incf qy cy)
                       (incf x cx) (incf y cy))
                     (push (list :curve
                                 (+ cx (* 2/3 (- qx cx)))
                                 (+ cy (* 2/3 (- qy cy)))
                                 (+ x (* 2/3 (- qx x)))
                                 (+ y (* 2/3 (- qy y)))
                                 x y)
                           out)
                     (setf cx x cy y))))
            (#\Z (push (list :close) out)
                 (setf cx sx cy sy)))
          (when (= i before) (incf i)))))
    (nreverse out)))

(defun svg-finish (cr fill stroke width)
  (when fill
    (set-color cr fill)
    (if stroke (cairo-fill-preserve cr) (cairo-fill cr)))
  (when (and stroke width (> width 0d0))
    (set-color cr stroke)
    (cairo-set-line-width cr width)
    (cairo-stroke cr))
  (cairo-new-path cr))

(defun paint-svg-path-data (cr d fill stroke width)
  (let ((any nil))
    (dolist (cmd (parse-svg-path d))
      (case (car cmd)
        (:move (cairo-move-to cr (second cmd) (third cmd)) (setf any t))
        (:line (cairo-line-to cr (second cmd) (third cmd)) (setf any t))
        (:curve (apply #'cairo-curve-to cr (cdr cmd)) (setf any t))
        (:close (cairo-close-path cr))))
    (when any (svg-finish cr fill stroke width))))

(defun paint-svg-shape (cr el)
  (when (dom-element-p el)
    (let* ((tag (dom-element-tag el))
           (fill (let ((a (dom-attr el "fill")))
                   (if a (svg-paint a) (color-bytes 0 0 0))))
           (stroke (svg-paint (dom-attr el "stroke")))
           (sw (svg-number el "stroke-width" 1d0)))
      (cond
        ((or (string= tag "g") (string= tag "svg"))
         (dolist (c (element-children el))
           (paint-svg-shape cr c)))
        ((string= tag "rect")
         (cairo-rectangle cr (svg-number el "x") (svg-number el "y")
                          (svg-number el "width") (svg-number el "height"))
         (svg-finish cr fill stroke sw))
        ((string= tag "circle")
         (cairo-arc cr (svg-number el "cx") (svg-number el "cy") (svg-number el "r")
                    0d0 (* 2d0 pi))
         (cairo-close-path cr)
         (svg-finish cr fill stroke sw))
        ((string= tag "ellipse")
         (cairo-save cr)
         (cairo-translate cr (svg-number el "cx") (svg-number el "cy"))
         (cairo-scale cr (max 0.001d0 (svg-number el "rx" 1d0))
                      (max 0.001d0 (svg-number el "ry" 1d0)))
         (cairo-arc cr 0d0 0d0 1d0 0d0 (* 2d0 pi))
         (cairo-close-path cr)
         (svg-finish cr fill stroke sw)
         (cairo-restore cr))
        ((string= tag "line")
         (cairo-move-to cr (svg-number el "x1") (svg-number el "y1"))
         (cairo-line-to cr (svg-number el "x2") (svg-number el "y2"))
         (svg-finish cr nil (or stroke fill) sw))
        ((member tag '("polyline" "polygon") :test #'string=)
         (let* ((raw (or (dom-attr el "points") ""))
                (i 0) (n (length raw)) (pts nil))
             (labels ((skip ()
                        (loop while (and (< i n)
                                         (or (whitespace-char-p (char raw i))
                                             (char= (char raw i) #\,)))
                              do (incf i)))
                      (read-one ()
                        (skip)
                        (when (and (< i n)
                                   (or (digit-char-p (char raw i))
                                       (find (char raw i) "+-.")))
                          (let ((start i))
                            (when (find (char raw i) "+-") (incf i))
                            (loop while (and (< i n)
                                             (or (digit-char-p (char raw i))
                                                 (char= (char raw i) #\.)))
                                  do (incf i))
                            (ignore-errors (float (read-from-string (subseq raw start i)) 1d0))))))
               (loop for x = (read-one) while x
                     for y = (read-one)
                     when y do (push (cons x y) pts)))
             (setf pts (nreverse pts))
             (when pts
               (cairo-move-to cr (car (first pts)) (cdr (first pts)))
               (dolist (p (rest pts))
                 (cairo-line-to cr (car p) (cdr p)))
               (when (string= tag "polygon") (cairo-close-path cr))
               (svg-finish cr fill stroke sw))))
        ((string= tag "path")
         (let ((d (dom-attr el "d")))
           (when d (paint-svg-path-data cr d fill stroke sw))))
        ((string= tag "text")
         (let ((content (with-output-to-string (o)
                          (dolist (c (dom-node-children el))
                            (when (dom-text-p c)
                              (write-string (dom-text-text c) o))))))
           (setf content (string-trim '(#\space #\newline #\tab #\return) content))
           (when (plusp (length content))
             (select-cairo-font cr (cairo-family '("sans-serif"))
                                (cairo-slant :normal)
                                (cairo-weight :normal)
                                (max 1d0 (svg-number el "font-size" 16d0)))
             (set-color cr (or fill (color-bytes 0 0 0)))
             (cairo-move-to cr (svg-number el "x") (svg-number el "y"))
             (cairo-show-text cr content))))))))

(defun paint-svg (cr box)
  "Paint an inline svg element's shapes into its content box."
  (let ((el (box-element box))
        (st (box-style box)))
    (when (and el st)
      (multiple-value-bind (bt br bb bl) (border4 st)
        (multiple-value-bind (pt pr pb pl) (pad4 st (box-w box))
          (let ((x (+ (box-x box) bl pl))
                (y (+ (box-y box) bt pt))
                (w (max 0d0 (- (box-w box) bl br pl pr)))
                (h (max 0d0 (- (box-h box) bt bb pt pb))))
            (multiple-value-bind (vbx vby vbw vbh) (svg-viewbox el w h)
              (when (and (> w 0d0) (> h 0d0) (> vbw 0d0) (> vbh 0d0))
                (cairo-save cr)
                (cairo-rectangle cr x y w h)
                (cairo-clip cr)
                (cairo-translate cr x y)
                (cairo-scale cr (/ w vbw) (/ h vbh))
                (cairo-translate cr (- vbx) (- vby))
                (dolist (c (element-children el))
                  (paint-svg-shape cr c))
                (cairo-restore cr)))))))))
